# Comatoze - Fast Loading (dari referensi "YayangProjectFasterLoading")
# Matikan animasi boot, fast boot (kalau didukung), dan beberapa tweak ringan lainnya.
debug.sf.nobootanimation=1
ro.config.hw_quickpoweron=true
logcat.live=disable
dalvik.vm.dexopt-flags=v=a,o=y
ro.sys.fw.bg_apps_limit=4
# Frame pacing HAL perf vendor (bila HP mendukung; diabaikan jika tidak)
vendor.perf.framepacing.enable=1
