#!/system/bin/sh
# UltraPower core backend. Tambah fitur baru = tambah fungsi + case di bagian bawah.
exec </dev/null
SELF=/data/adb/modules/ultrapower/system/bin/ultrapower
MODD=/data/adb/modules/ultrapower
DIR=/data/adb/ultrapower
CFG=$DIR/config
CUS=$DIR/custom
CPU=/sys/devices/system/cpu/cpufreq
mkdir -p $DIR
[ -f $CFG ] || printf 'MODE=balance\nTHERMAL=on\n' > $CFG
[ -f $CUS ] || : > $CUS

w(){ [ -e "$2" ] && { chmod 644 "$2" 2>/dev/null; echo "$1" > "$2" 2>/dev/null; }; }
rd(){ cat "$1" 2>/dev/null; }
getcfg(){ v=$(grep "^$1=" $CFG 2>/dev/null); case "$v" in *'
'*) echo "$v" | cut -d= -f2;; *) v=${v#*=}; echo "${v%%=*}";; esac; }   # 1 fork (sebelumnya 2); hasil sama
cfgv(){ CV=; [ -f $CFG ] || return 0; while IFS= read -r _l; do case $_l in "$1="*) CV=${_l#*=}; CV=${CV%%=*};; esac; done < $CFG; }   # baca config TANPA fork (hasil di $CV); untuk loop pemantau latar
setcfg(){ grep -v "^$1=" $CFG > $CFG.t; echo "$1=$2" >> $CFG.t; mv $CFG.t $CFG; }
setcustom(){ grep -v "^$1|" $CUS > $CUS.t 2>/dev/null; echo "$1|$2" >> $CUS.t; mv $CUS.t $CUS; }
markcustom(){ [ -z "$NOSAVE" ] && { setcfg MODE custom; setcustom "$1" "$2"; batsaver custom; }; }

pick(){ av="$1"; shift; for g in "$@"; do case " $av " in *" $g "*) echo $g; return;; esac; done; }
maxof(){ echo $* | tr ' ' '\n' | grep -v '^$' | sort -n | tail -1; }
minof(){ echo $* | tr ' ' '\n' | grep -v '^$' | sort -n | head -1; }
cap(){ t=$1; shift; best=""; for f in $*; do
  if [ "$f" -le "$t" ]; then if [ -z "$best" ] || [ "$f" -gt "$best" ]; then best=$f; fi; fi; done; echo ${best:-$t}; }
range(){ w $4 $2; w $3 $1; w $4 $2; }   # minfile maxfile min max

# ---------- GPU detect ----------
GPU=""
for d in /sys/class/kgsl/kgsl-3d0/devfreq; do [ -d $d ] && GPU=$d; done
if [ -z "$GPU" ]; then
  for d in /sys/class/devfreq/*; do
    case "$(basename $d)" in *gpu*|*mali*|*kgsl*|*g3d*) GPU=$d; break;; esac
  done
fi

# ---------- MODE ----------
# Mode: perf (brutal) | plite (Performa Lite: lantai clock naik, atap ~82%, 90 Hz) | balance | eco
# Clock tertinggi yang benar-benar ada: HP overclock menambah OPP di tabel (mis. 2810 MHz) sementara cpuinfo_max_freq tetap angka stok (2000 MHz).
# Mengunci ke angka stok yang tidak ada di tabel membuat kernel jatuh ke OPP di bawahnya (1900 MHz), jadi mode Performa justru lebih lambat dari stok.
# Hasil di-cache per policy sampai cpuinfo_max berubah atau reboot (c.* dibuang saat boot).
cpu_top(){ # <dir policy>
  _f=$DIR/c.top.${1##*/}; _im=$(rd $1/cpuinfo_max_freq)
  if [ -f $_f ]; then read -r _ci _ct < $_f; [ "$_ci" = "$_im" ] && { echo $_ct; return; }; fi
  _ct=$(awk -v m="${_im:-0}" '{for(i=1;i<=NF;i++)if($i+0>m)m=$i+0}END{printf "%d",m}' $1/scaling_available_frequencies 2>/dev/null)
  [ "${_ct:-0}" -gt 0 ] || _ct=$_im
  echo "$_im $_ct" > $_f 2>/dev/null; echo $_ct
}
cpu_mode(){
  for p in $CPU/policy*; do
    [ -d $p ] || continue
    av=$(rd $p/scaling_available_governors); fr=$(rd $p/scaling_available_frequencies)
    imax=$(cpu_top $p); imin=$(rd $p/cpuinfo_min_freq); ist=$(rd $p/cpuinfo_max_freq)
    [ -z "$fr" ] && fr="$imin $imax"
    case $1 in
      perf) g=$(pick "$av" turbo performance schedutil walt); mx=$imax; mn=$imax;;
      eco)  g=$(pick "$av" schedutil walt interactive powersave); mx=$(cap $((ist*60/100)) $fr); mn=$imin;;   # Eco tetap dihitung dari batas stok
      plite) g=$(pick "$av" schedutil walt interactive ondemand); mx=$(cap $((imax*82/100)) $fr); mn=$(cap $((imax*30/100)) $fr);;   # Performa Lite: lantai clock naik (responsif), atap 82% (tidak brutal, lebih hemat)
      *)    g=$(pick "$av" schedutil walt interactive ondemand); mx=$imax; mn=$imin;;
    esac
    [ -n "$g" ] && w $g $p/scaling_governor
    range $p/scaling_min_freq $p/scaling_max_freq $mn $mx
  done
}
GP=/proc/gpufreq
# gpu_live: clock GPU NYATA (Hz). Urutan sumber: kgsl gpuclk > GED current_freqency (MediaTek) > gpufreqv2/gpufreq status > devfreq cur_freq.
# Hasil: "<Hz>|<sumber>". devfreq cur_freq sering basi (previous_freq), jadi hanya jadi pilihan terakhir.
gpu_live(){
  _n(){ case $1 in ''|*[!0-9]*) return 1;; esac; return 0; }
  _hz(){ _v=$1; if [ "$_v" -lt 10000000 ]; then _v=$((_v*1000)); fi; echo "$_v"; }   # kHz -> Hz
  if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then k=$(rd /sys/class/kgsl/kgsl-3d0/gpuclk); _n "$k" && [ "$k" -gt 0 ] && { echo "$k|kgsl"; return; }; fi
  for f in /sys/kernel/ged/hal/current_freqency /sys/kernel/gpu/gpu_clock; do
    [ -r $f ] || continue
    v=$(tr -c '0-9\n' ' ' < $f 2>/dev/null | tr ' ' '\n' | awk 'length($0)>=5{x=$0} END{print x}')
    _n "$v" && [ "$v" -gt 0 ] && { echo "$(_hz $v)|ged"; return; }
  done
  for f in /proc/gpufreqv2/gpufreq_status /proc/gpufreq/gpufreq_var_dump; do
    [ -r $f ] || continue
    v=$(grep -i -m1 'cur.*freq\|freq *:' $f 2>/dev/null | grep -o '[0-9]\{5,\}' | head -1)
    _n "$v" && [ "$v" -gt 0 ] && { echo "$(_hz $v)|gpufreq"; return; }
  done
  v=$(rd $GPU/cur_freq); _n "$v" && echo "$v|devfreq"
}
gp_freqs(){ [ -f $GP/gpufreq_opp_dump ] && grep -o 'freq = *[0-9]*' $GP/gpufreq_opp_dump | grep -o '[0-9]*$'; }
gpu_fix(){ [ -f $GP/gpufreq_opp_freq ] && echo $1 > $GP/gpufreq_opp_freq; markcustom gpu_fix "gpu_fix $1"; }
gpu_mode(){
  V2=/proc/gpufreqv2/fix_target_opp_index
  [ -f $V2 ] && { if [ "$1" = perf ]; then echo 0 > $V2; else echo -1 > $V2; fi; }
  if [ -z "$GPU" ]; then
    [ -f $GP/gpufreq_opp_freq ] || return
    if [ "$1" = "perf" ]; then echo $(maxof $(gp_freqs)) > $GP/gpufreq_opp_freq; else echo 0 > $GP/gpufreq_opp_freq; fi
    return
  fi
  av=$(rd $GPU/available_governors); fr=$(rd $GPU/available_frequencies)
  [ -z "$fr" ] && return
  top=$(maxof $fr); low=$(minof $fr)
  case $1 in
    perf) g=$(pick "$av" hino_turbo turbo performance msm-adreno-tz); mn=$top; mx=$top;;
    eco)  g=$(pick "$av" msm-adreno-tz simple_ondemand mali_ondemand); mn=$low; mx=$(cap $((top*60/100)) $fr);;
    plite) g=$(pick "$av" msm-adreno-tz simple_ondemand mali_ondemand); mn=$(cap $((top*30/100)) $fr); mx=$(cap $((top*80/100)) $fr);;
    *)    g=$(pick "$av" msm-adreno-tz simple_ondemand mali_ondemand); mn=$low; mx=$top;;
  esac
  [ -n "$g" ] && w $g $GPU/governor
  range $GPU/min_freq $GPU/max_freq $mn $mx
  ged_floor "$1"
}
# ged_floor: GPU Boost (Tinggi/Maks) juga menaikkan LANTAI clock GPU (Tinggi ~65%, Maks ~88% dari maksimum) agar tidak jatuh di tengah adegan.
# Dilewati di mode Eco dan bila GPU Boost = Auto. Dipanggil tiap gpu_mode (supaya tidak tertimpa ganti mode) dan saat GPU Boost diubah.
ged_floor(){
  [ -n "$GPU" ] || return 0; [ "$1" = eco ] && return 0; [ "$1" = perf ] && return 0
  case $(getcfg GED_LV) in tinggi) _pc=65;; maks) _pc=88;; *) return 0;; esac
  _fr=$(rd $GPU/available_frequencies); [ -n "$_fr" ] || return 0
  _tp=$(maxof $_fr); _fl=$(cap $((_tp*_pc/100)) $_fr); [ -n "$_fl" ] || return 0
  range $GPU/min_freq $GPU/max_freq $_fl $_tp
}
# ---------- HEMAT DAYA OTOMATIS SAAT MODE ECO ----------
# Mode eco -> nyalakan Battery Saver bawaan Android; mode lain -> matikan, tapi HANYA kalau Comatoze sendiri yang menyalakannya
# (penanda $BSF), supaya Battery Saver yang dinyalakan pengguna manual tidak ikut dimatikan. Matikan fitur ini dengan ECO_BATSAVER=off di config.
BSF=$DIR/batsaver_on
batsaver(){ # mode efektif: eco | perf | balance | custom
  if [ "$(getcfg ECO_BATSAVER)" = off ] || [ "$1" != eco ]; then
    [ -f $BSF ] && { sput global low_power 0; rm -f $BSF; }
    return 0
  fi
  [ "$(sget global low_power)" = 1 ] || { sput global low_power 1; [ "$(sget global low_power)" = 1 ] && : > $BSF; }
  return 0
}
# Toggle "Tweak Ekstra Performa" (perfx) & "Tweak Ekstra Eco" (ecox) mengikuti mode efektif, dan tidak pernah aktif bersamaan:
# perf -> perfx on / ecox off ; eco -> ecox on / perfx off ; balance -> keduanya off. Matikan otomatisasi ini dengan AUTO_TWEAK=off di config.
tweak_auto(){ # mode
  [ "$(getcfg AUTO_TWEAK)" = off ] && return 0
  case "$1" in
    perf) setcfg F_perfx on;  setcfg F_ecox off;;
    eco)  setcfg F_ecox on;   setcfg F_perfx off;;
    *)    setcfg F_perfx off; setcfg F_ecox off;;
  esac
}
# Mode EFEKTIF: saat profil game aktif (prof_on) mode yang terpasang = $DIR/emode (MODE di config tetap mode asli pengguna, dipulihkan saat keluar game).
curmode(){ if [ -f $DIR/prof_on ]; then cat $DIR/emode 2>/dev/null; else getcfg MODE; fi; }
set_mode(){
  echo $1 > $DIR/emode
  cpu_mode $1; gpu_mode $1
  batsaver $1
  tweak_auto $1
  # urutan: lepas tweak mode lama dulu, baru pasang yang baru (supaya nilai ASLI yang dicatat selalu benar saat pindah mode)
  [ "$1" = eco ] || eco_x_off
  [ "$1" = perf ] || perf_extra_off
  [ "$1" = perf ] && perf_extra
  [ "$1" = eco ] && [ "$(getcfg F_ecox)" != off ] && eco_x
  [ "$1" = eco ] || eco_ppm_off
  [ "$1" = eco ] && { rm -f $DIR/eco_ppm; cpu_wd_sync; }   # watchdog atap clock Eco
  hz=$(mode_hz $1); [ -n "$hz" ] && refresh $hz q >/dev/null
  [ "$2" = temp ] || { setcfg MODE $1; : > $CUS; }
}

# ---------- TWEAK TAMBAHAN MODE PERFORMA ----------
# Selain clock/governor: I/O scheduler paling ringan, CPU ramp-up lebih cepat (schedutil up_rate_limit),
# swappiness rendah (kurangi jeda karena swap/zram), GPU polling lebih rapat (freq nyusul beban lebih cepat),
# dan pastikan semua core tetap online (tidak di-offline kernel saat beban naik-turun).
# Nilai asli dicatat di $PXV sekali per node, dipulihkan oleh perf_extra_off() saat keluar mode Performa.
PXV=$DIR/pxvals
pxw(){ # node value
  [ -e "$1" ] || return 0
  if ! grep -q "^$1|" $PXV 2>/dev/null; then
    o=$(cat "$1" 2>/dev/null)
    case "$o" in *\[*\]*) o=${o#*\[}; o=${o%%\]*};; esac   # node scheduler berbentuk "[aktif] lain lain": simpan nama aktifnya saja agar bisa dipulihkan
    echo "$1|$o" >> $PXV
  fi
  w "$2" "$1"
}
perf_extra(){
  mkdir -p $DIR   # PXV tidak dikosongkan: perf_extra bisa terpanggil lagi (mis. profil game) dan nilai ASLI tidak boleh tertimpa nilai yang sudah ditweak
  for q in /sys/block/*/queue/scheduler; do
    case "$q" in /sys/block/loop*|/sys/block/ram*|/sys/block/zram*|/sys/block/nbd*) continue;; esac   # perangkat virtual: scheduler tidak relevan (puluhan fork sia-sia)
    av=$(rd $q); sc=$(pick "$av" none noop kyber mq-deadline deadline cfq)
    [ -n "$sc" ] && pxw $q "$sc"
  done
  for u in $CPU/policy*/schedutil/up_rate_limit_us; do pxw $u 500; done
  [ -f /proc/sys/vm/swappiness ] && pxw /proc/sys/vm/swappiness 10
  pxw /proc/sys/kernel/sched_energy_aware 0   # tanpa penempatan hemat-energi: task berat langsung ke core besar
  pxw /sys/module/workqueue/parameters/power_efficient N   # workqueue unbound tidak dikumpulkan demi hemat daya
  [ -n "$GPU" ] && [ -f $GPU/polling_interval ] && pxw $GPU/polling_interval 10
  for c in /sys/devices/system/cpu/cpu[1-9]*/online; do
    [ "$(rd $c)" = "0" ] && pxw $c 1
  done
  [ "$(getcfg F_perfx)" != off ] && perf_x
  cpu_wd_sync
}
# Beberapa ROM MTK (thermal/PPM/battery management) menimpa balik scaling_min/max_freq ke nilai lebih rendah
# beberapa saat setelah kita set, persis seperti kasus refresh rate. Watchdog ini menegaskan ulang
# min=max=cpuinfo_max_freq (clock mentok) + governor turbo tiap 2 detik SELAMA mode masih Performa,
# tidak peduli apa yang menimpanya -- korbanin baterai demi clock beneran mentok sesuai permintaan.
CPUW=$DIR/cpuw
cpu_wd(){
  # Tanpa fork di siklus normal (read bawaan shell): fork berkala dari pemantau ikut menyela core game dan terasa sebagai hentakan frame.
  echo $$ > $CPUW.pid; _tops=
  while :; do
    if [ -f $DIR/prof_on ]; then CV=; read -r CV 2>/dev/null < $DIR/emode; else cfgv MODE; fi   # mode efektif (profil game bisa memasang mode sementara)
    if [ "$CV" = perf ]; then
      if [ -z "$_tops" ]; then   # daftar policy + clock puncak + governor tujuan dihitung sekali per sesi mode Performa
        for p in $CPU/policy*; do
          [ -d "$p" ] || continue
          imax=$(cpu_top $p); [ -z "$imax" ] && continue
          want=$(pick "$(rd $p/scaling_available_governors)" turbo performance schedutil walt)
          _tops="$_tops $p=$imax=$want"
        done
        [ -z "$_tops" ] && _tops=" "
      fi
      for e in $_tops; do
        p=${e%%=*}; r=${e#*=}; imax=${r%%=*}; want=${r#*=}
        [ "$p" = "$e" ] && continue
        a=; b=; g=
        read -r a 2>/dev/null < $p/scaling_max_freq; read -r b 2>/dev/null < $p/scaling_min_freq
        if [ "$a" != "$imax" ] || [ "$b" != "$imax" ]; then range $p/scaling_min_freq $p/scaling_max_freq $imax $imax; fi
        if [ -n "$want" ]; then read -r g 2>/dev/null < $p/scaling_governor; [ "$g" != "$want" ] && w $want $p/scaling_governor; fi
      done
      sleep 3; _ecos=
    elif [ "$CV" = eco ]; then
      # Eco: HP sering melompat ke clock puncak (input boost / PPM / ROM menimpa scaling_max_freq). Atap clock dijaga ulang tiap 2 dtk
      # + batas keras MediaTek PPM (hard_userlimit_max_cpu_freq) yang tidak bisa ditimpa boost.
      _tops=
      if [ -z "$_ecos" ]; then
        _ex=$(getcfg F_ecox); _first=1; _ci=0
        for p in $CPU/policy*; do
          [ -d "$p" ] || continue
          ist=$(rd $p/cpuinfo_max_freq); imin=$(rd $p/cpuinfo_min_freq); [ -n "$ist" ] || continue
          fr=$(rd $p/scaling_available_frequencies); [ -z "$fr" ] && fr="$imin $ist"
          mx=$(cap $((ist*60/100)) $fr)
          if [ $_first = 0 ] && [ "$_ex" != off ]; then
            t=$((ist*45/100)); best=""
            for f in $fr; do [ "$f" -ge "$t" ] && { [ -z "$best" ] || [ "$f" -lt "$best" ]; } && best=$f; done
            [ -n "$best" ] && [ "$best" -lt "$mx" ] && mx=$best
          fi
          _first=0; _ecos="$_ecos $p=$mx=$imin"; _ci=$((_ci+1))
        done
        [ -z "$_ecos" ] && _ecos=" "
        eco_ppm "$_ecos"
      fi
      for e in $_ecos; do
        p=${e%%=*}; r=${e#*=}; mx=${r%%=*}; imin=${r#*=}
        [ "$p" = "$e" ] && continue
        a=; read -r a 2>/dev/null < $p/scaling_max_freq
        [ "${a:-0}" -gt "$mx" ] 2>/dev/null && range $p/scaling_min_freq $p/scaling_max_freq $imin $mx
      done
      sleep 2
    else _tops=; _ecos=; sleep 10
    fi
  done
}
# Batas keras MediaTek PPM per cluster (urutan policy = nomor cluster). Nilai -1 = tanpa batas (dipulihkan di eco_ppm_off).
eco_ppm(){ _f=/proc/ppm/policy/hard_userlimit_max_cpu_freq; [ -e $_f ] || return 0; _i=0
  for e in $1; do p=${e%%=*}; r=${e#*=}; mx=${r%%=*}; [ "$p" = "$e" ] && continue; echo "$_i $mx" > $_f 2>/dev/null; _i=$((_i+1)); done
  echo $_i > $DIR/eco_ppm; }
eco_ppm_off(){ [ -f $DIR/eco_ppm ] || return 0; _f=/proc/ppm/policy/hard_userlimit_max_cpu_freq; read -r _n < $DIR/eco_ppm; _i=0
  while [ "$_i" -lt "${_n:-0}" ]; do echo "$_i -1" > $_f 2>/dev/null; _i=$((_i+1)); done; rm -f $DIR/eco_ppm; }
cpu_wd_sync(){
  [ -f $CPUW.pid ] && kill -0 $(cat $CPUW.pid) 2>/dev/null && return
  bg cpu_wd
}
# ---------- TWEAK EKSTRA PERFORMA (fitur "perfx", aktif otomatis di mode Performa) ----------
# Selain clock yang dikunci: kurangi penundaan scheduler, bangun CPU lebih cepat, I/O lebih ringan. Semua node dicek dulu
# (tidak ada = dilewati), nilai asli dicatat sekali di $PXV2 dan dipulihkan persis oleh perf_x_off saat keluar mode Performa / fitur dimatikan.
#  - sched_energy_aware=0      : scheduler tidak lagi menimbang hemat energi saat memilih core (task langsung ke core besar)
#  - top-app uclamp.min=max    : thread app di depan dianggap beban penuh -> ditaruh di core besar, tanpa jeda "ramp-up"
#  - top-app latency_sensitive : prioritas CPU idle saat task bangun (kurangi jeda bangun)
#  - read_ahead 512 / iostats 0 / add_random 0 / rq_affinity 2 : loading aset lebih lancar, overhead I/O lebih kecil
#  - page-cluster 0            : swap-in zram per halaman (jeda lebih pendek saat memori ketat)
#  - cpuidle: state selain WFI dimatikan (HANYA bila PERF_IDLE=on di config; bawaan mati karena membuat HP panas -> throttling -> frame jatuh)
PXV2=$DIR/pxvals2
px2(){ # node value
  [ -e "$1" ] || return 0
  grep -q "^$1|" $PXV2 2>/dev/null || echo "$1|$(cat "$1" 2>/dev/null)" >> $PXV2
  w "$2" "$1"
}
px3(){ [ -n "$(cat "$1" 2>/dev/null)" ] && px2 "$1" "$2"; }   # seperti px2, tapi dilewati bila nilai asli tidak bisa dibaca (supaya pemulihan tidak menulis string kosong)
perf_x(){
  mkdir -p $DIR
  px2 /proc/sys/kernel/sched_energy_aware 0
  px2 /dev/cpuctl/top-app/cpu.uclamp.min max
  px2 /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
  for q in /sys/block/sd[a-z]/queue /sys/block/mmcblk[0-9]/queue; do
    [ -d "$q" ] || continue
    px2 $q/read_ahead_kb 1024; px2 $q/iostats 0; px2 $q/add_random 0; px2 $q/rq_affinity 2
  done
  px2 /proc/sys/vm/page-cluster 0
  # --- tambahan "brutal" (panas & boros, tapi respons maksimal). Semua node dicek dulu, tidak ada = dilewati, dipulihkan oleh perf_x_off ---
  #  - sched_boost=1 + schedtune top-app boost 100/prefer_idle 1 : task app depan langsung ke core besar / core idle (kernel dengan schedtune/WALT)
  #  - sched_autogroup 0 : tidak ada pengelompokan task yang menunda thread UI
  #  - kgsl (Adreno): clock, bus & GPU tidak pernah "tidur" (force_clk_on/bus_on/no_nap), bus_split 0 = bandwidth penuh. Matikan dengan PERF_GPUFORCE=off di config
  px3 /proc/sys/kernel/sched_boost 1
  px3 /proc/sys/kernel/sched_autogroup_enabled 0
  px3 /dev/stune/top-app/schedtune.boost 100
  px3 /dev/stune/top-app/schedtune.prefer_idle 1
  px3 /dev/stune/foreground/schedtune.boost 30
  if [ "$(getcfg PERF_GPUFORCE)" != off ]; then
    for k in force_clk_on force_bus_on force_no_nap; do px3 /sys/class/kgsl/kgsl-3d0/$k 1; done
    px3 /sys/class/kgsl/kgsl-3d0/bus_split 0
  fi
  #  - IRQ layar sentuh dipindah ke cluster terbesar (interrupt sentuhan diproses di core tercepat, bukan core kecil yang sibuk). Matikan dengan PERF_IRQ=off
  #  - cpuset top-app & foreground boleh memakai SEMUA core (termasuk prime yang sering disisihkan ROM)
  if [ "$(getcfg PERF_IRQ)" != off ]; then
    lp=$(ls -d $CPU/policy* 2>/dev/null | tail -1); m=0
    for c in $(rd $lp/related_cpus); do m=$((m | (1 << c))); done
    if [ "$m" -gt 0 ]; then
      grep -i -E 'touch|goodix|fts|synaptics|novatek|nvt|himax|ilitek|cyttsp' /proc/interrupts 2>/dev/null | while read -r i _; do
        px3 /proc/irq/${i%:}/smp_affinity $(printf '%x' $m)
      done
    fi
  fi
  allc=$(rd /sys/devices/system/cpu/possible)
  if [ -n "$allc" ]; then for g in top-app foreground; do px3 /dev/cpuset/$g/cpus $allc; done; fi
  if [ "$(getcfg PERF_IDLE)" = on ]; then
    for st in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state[1-9]*; do px2 $st/disable 1; done
  fi
  perf_x_mtk
  perf_x_boost
}
px4(){ case "$(cat "$1" 2>/dev/null)" in ''|*[!0-9-]*) return 0;; esac; px2 "$1" "$2"; }   # hanya node berisi bilangan bulat polos (bentuk lain tidak bisa dipulihkan dengan aman -> dilewati)
brk_cur(){ _o=$(cat "$1" 2>/dev/null); case "$_o" in *\[*\]*) _o=${_o#*\[}; _o=${_o%%\]*};; esac; echo $_o; }   # node "[aktif] lain": ambil nama aktif
px5(){ # node nilai: seperti px2 untuk node bergaya "[aktif] lain"; dilewati bila nilai itu tidak ada di daftar
  [ -e "$1" ] || return 0
  case " $(cat "$1" 2>/dev/null) " in *" $2 "*|*"[$2]"*) ;; *) return 0;; esac
  grep -q "^$1|" $PXV2 2>/dev/null || echo "$1|$(brk_cur "$1")" >> $PXV2
  w "$2" "$1"
}
# MediaTek tambahan Performa (semua jalur node dicek & dipulihkan, tidak ada = dilewati):
#  - devfreq DVFSRC governor=performance : DRAM/vcore tidak turun saat beban fluktuatif (frame time lebih stabil)
#  - dvfsrc_force_vcore_dvfs_opp=0       : vcore dikunci OPP tertinggi (matikan dengan PERF_VCORE=off di config)
#  - cpufreq_cci_mode=1 / syslimiter_force_disable=1 : interkoneksi cache cepat & pembatas sistem MediaTek mati
#  - Mali power_policy=always_on         : GPU tidak pernah power-gate (tanpa jeda bangun saat frame berat)
#  - compaction_proactiveness=0, vfs_cache_pressure=50, sched_migration_cost kecil : kurangi stutter dari kompaksi memori & migrasi task
perf_x_mtk(){
  _dv=$(ls -d /sys/class/devfreq/*dvfsrc* 2>/dev/null | head -1)
  if [ -n "$_dv" ]; then case " $(rd $_dv/available_governors) " in *" performance "*) px3 $_dv/governor performance;; esac; fi
  [ "$(getcfg PERF_VCORE)" != off ] && px4 /sys/kernel/helio-dvfsrc/dvfsrc_force_vcore_dvfs_opp 0
  px4 /proc/cpufreq/cpufreq_cci_mode 1
  px4 /proc/perfmgr/syslimiter/syslimiter_force_disable 1
  px5 /sys/class/misc/mali0/device/power_policy always_on
  px4 /proc/sys/vm/compaction_proactiveness 0
  px4 /proc/sys/vm/vfs_cache_pressure 50
  px4 /proc/sys/kernel/sched_migration_cost_ns 50000
  perf_x_agg
}
# v2.37 "gacor": EAS dimatikan (tugas berat langsung ke core cepat), app depan dikunci uclamp.min 30% + latency_sensitive,
# workqueue tidak hemat daya, I/O blok tanpa statistik/entropi + read-ahead besar + rq_affinity 2. Semua node dicek dulu & nilai asli dipulihkan.
perf_x_agg(){
  px4 /proc/sys/kernel/sched_energy_aware 0
  px3 /sys/module/workqueue/parameters/power_efficient N
  px3 /dev/cpuctl/top-app/cpu.uclamp.min 30
  px4 /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
  for _q in /sys/block/sd?/queue /sys/block/mmcblk?/queue; do
    [ -d "$_q" ] || continue
    px4 $_q/iostats 0; px4 $_q/add_random 0; px4 $_q/rq_affinity 2; px4 $_q/read_ahead_kb 1024
  done
}
# v2.51 "super brutal" tertanam di mode Performa (tidak ada tombol terpisah): masuk Performa = bersihkan RAM sekali, nyalakan
# Touch Boost / Wi-Fi latensi rendah / kurangi debug / anti-kill latar / matikan FPSGO (yang belum aktif; dicatat di $PXF dan
# dimatikan lagi saat keluar Performa), mode performa tetap sistem, dan prioritas game (nice -20, I/O realtime, anti-OOM).
PXF=$DIR/pxfeat; PXG=$DIR/pxgame
px_feat(){ [ "$(fstate $1)" = on ] && return 0; feat $1 on >/dev/null 2>&1; [ "$(fstate $1)" = on ] && echo $1 >> $PXF; return 0; }
perf_x_boost(){
  if [ ! -f $DIR/pxclean ]; then : > $DIR/pxclean
    ( sleep 25; gclean "$(game_fg)" ) </dev/null >/dev/null 2>&1 &   # ditunda 25 dtk (game selesai memuat), ringan: tanpa kill-all/drop_caches/compact saat game dimuat
  fi
  for _f in touchboost wifilatency lessdbg smooth; do px_feat $_f; done   # fpsgooff TIDAK ikut: bentrok dengan Frame Pacing yang justru menyetel FPSGO
  [ -f $DIR/pxfpm ] || { cmd power set-fixed-performance-mode-enabled true >/dev/null 2>&1 && : > $DIR/pxfpm; }
  perf_x_game
  return 0
}
perf_x_game(){ # prioritas game yang sedang di depan (dipanggil juga saat game dibuka ketika Performa sudah aktif)
  set -- $(game_fgp); [ -n "$1" ] || return 0
  _pg=$1; _pd=$2
  echo "$_pg" > $PXG   # (cmd game mode performance DIHAPUS: mengubah mode GameManager saat game dimuat bisa memuat ulang/mematikan game)
  if [ -n "$_pd" ]; then renice -n -20 -p $_pd >/dev/null 2>&1; ionice -c 1 -n 0 -p $_pd >/dev/null 2>&1; { echo -1000 > /proc/$_pd/oom_score_adj; } 2>/dev/null; fi
  return 0
}
perf_x_boost_off(){
  [ -f $PXF ] && { while read -r _f; do [ -n "$_f" ] && feat $_f off >/dev/null 2>&1; done < $PXF; rm -f $PXF; }
  [ -f $DIR/pxfpm ] && { cmd power set-fixed-performance-mode-enabled false >/dev/null 2>&1; rm -f $DIR/pxfpm; }
  rm -f $PXG
  rm -f $DIR/pxclean
}
perf_x_off(){
  perf_x_boost_off
  [ -f $PXV2 ] || return 0
  while IFS='|' read -r node val; do
    [ -n "$node" ] && [ -e "$node" ] && w "$val" "$node"
  done < $PXV2
  rm -f $PXV2
}

# ---------- TWEAK EKSTRA ECO (fitur "ecox", aktif otomatis di mode Eco) ----------
# Eco bawaan hanya membatasi clock CPU/GPU 60% dan refresh rate terendah. Ini menambah penghematan panas yang tidak bikin UI patah-patah:
#  - cluster CPU selain yang paling kecil (cluster besar = sumber panas utama) dibatasi 45% clock
#  - cgroup background & system-background dibatasi uclamp.max 25% (app latar tidak boleh menarik clock naik)
#  - schedutil: naik clock lebih lambat (up_rate_limit 2 ms), turun lebih cepat (down_rate_limit 4 ms)
#  - scan Wi-Fi & BLE "selalu aktif" dimatikan (bangun radio berulang-ulang)
# Node dicek dulu (tidak ada = dilewati); nilai asli dicatat sekali di $EXV dan dipulihkan persis oleh eco_x_off.
EXV=$DIR/exvals
ex1(){ # node nilai
  [ -e "$1" ] || return 0
  grep -q "^$1|" $EXV 2>/dev/null || echo "$1|$(cat "$1" 2>/dev/null)" >> $EXV
  w "$2" "$1"
}
exs(){ # namespace key nilai (setelan sistem)
  grep -q "^set:$2|" $EXV 2>/dev/null || { o=$(sget $1 $2); [ "$o" = null ] && o=__null__; echo "set:$2|$1|$o" >> $EXV; }   # __null__ = setelan belum ada (dihapus saat dipulihkan)
  sput $1 $2 $3
}
eco_x(){
  mkdir -p $DIR
  first=1
  for p in $CPU/policy*; do
    [ -d $p ] || continue
    if [ $first = 1 ]; then first=0; continue; fi   # policy pertama = cluster terkecil, dibiarkan di batas Eco bawaan
    fr=$(rd $p/scaling_available_frequencies); imax=$(rd $p/cpuinfo_max_freq); imin=$(rd $p/cpuinfo_min_freq)
    [ -n "$imax" ] || continue
    [ -z "$fr" ] && fr="$imin $imax"
    # 45% dibulatkan KE ATAS ke OPP terdekat (jangan jatuh ke clock minimum bila tabel OPP renggang), tapi tidak melebihi batas Eco bawaan (60%)
    t=$((imax*45/100)); best=""
    for f in $fr; do [ "$f" -ge "$t" ] && { [ -z "$best" ] || [ "$f" -lt "$best" ]; } && best=$f; done
    [ -z "$best" ] && best=$imax
    ec=$(cap $((imax*60/100)) $fr); [ "$best" -gt "$ec" ] && best=$ec
    range $p/scaling_min_freq $p/scaling_max_freq $imin $best
  done
  for g in background system-background; do ex1 /dev/cpuctl/$g/cpu.uclamp.max 25.00; done
  for u in $CPU/policy*/schedutil; do ex1 $u/up_rate_limit_us 2000; ex1 $u/down_rate_limit_us 4000; done
  exs global wifi_scan_always_enabled 0
  exs global ble_scan_always_enabled 0
  # --- tambahan hemat/adem (semua node dicek dulu, tidak ada = dilewati; dipulihkan oleh eco_x_off) ---
  #  - cpuset background & system-background dikunci ke cluster terkecil: task latar tidak lagi bangunin/panasin core besar. Matikan dengan ECO_BGCPU=off di config
  #  - sched_energy_aware=1 : scheduler kembali menimbang energi saat memilih core (kebalikan perf_x)
  #  - workqueue power_efficient : kerja kernel latar dijatuhkan ke core yang sedang aktif, bukan membangunkan core idle
  #  - dirty_writeback 15 dtk : flush tulis disk lebih jarang -> radio storage tidak sering bangun
  #  - Wi-Fi scan throttle, mobile data selalu-aktif mati, freezer app cache: kurangi bangun radio & CPU oleh app yang tidak dipakai
  if [ "$(getcfg ECO_BGCPU)" != off ]; then
    lp=$(ls -d $CPU/policy* 2>/dev/null | head -1)
    lit=$(rd $lp/related_cpus | tr ' ' ','); lit=${lit%,}
    if [ -n "$lit" ]; then for g in background system-background; do ex1 /dev/cpuset/$g/cpus $lit; done; fi
  fi
  ex1 /proc/sys/kernel/sched_energy_aware 1
  ex1 /sys/module/workqueue/parameters/power_efficient Y
  ex1 /proc/sys/vm/dirty_writeback_centisecs 1500
  exs global wifi_scan_throttle_enabled 1
  exs global mobile_data_always_on 0
  exs global cached_apps_freezer enabled
  eco_x_mtk
}
ex4(){ case "$(cat "$1" 2>/dev/null)" in ''|*[!0-9-]*) return 0;; esac; ex1 "$1" "$2"; }
ex5(){ [ -e "$1" ] || return 0
  case " $(cat "$1" 2>/dev/null) " in *" $2 "*|*"[$2]"*) ;; *) return 0;; esac
  grep -q "^$1|" $EXV 2>/dev/null || echo "$1|$(brk_cur "$1")" >> $EXV
  w "$2" "$1"
}
# MediaTek tambahan Eco: DRAM/vcore boleh turun (DVFSRC powersave), CCI mode normal, GPU Mali boleh power-gate (coarse_demand).
eco_x_mtk(){
  _dv=$(ls -d /sys/class/devfreq/*dvfsrc* 2>/dev/null | head -1)
  if [ -n "$_dv" ]; then case " $(rd $_dv/available_governors) " in *" powersave "*) ex1 $_dv/governor powersave;; esac; fi
  ex4 /proc/cpufreq/cpufreq_cci_mode 0
  ex5 /sys/class/misc/mali0/device/power_policy coarse_demand
}
eco_x_off(){ # batas clock cluster besar dikembalikan oleh cpu_mode (dipanggil set_mode); di sini hanya nilai node & setelan
  [ -f $EXV ] || return 0
  while IFS='|' read -r node val; do
    case "$node" in
      set:*) k=${node#set:}; ns=${val%%|*}; o=${val#*|}; if [ "$o" != __null__ ] && [ -n "$o" ]; then sput $ns $k "$o"; else sdel $ns $k; fi;;
      *) [ -n "$node" ] && [ -e "$node" ] && w "$val" "$node";;
    esac
  done < $EXV
  rm -f $EXV
}

perf_extra_off(){
  [ -f $CPUW.pid ] && kill $(cat $CPUW.pid) 2>/dev/null; rm -f $CPUW.pid
  perf_x_off
  [ -f $PXV ] || return 0
  while IFS='|' read -r node val; do
    [ -n "$node" ] && [ -e "$node" ] && w "$val" "$node"
  done < $PXV
  rm -f $PXV
}


# ---------- THERMAL ----------
# Metode "brutal" (dari modul Disable Thermal Helio G85/G99/G100 & Dimensity 6080): hentikan SEMUA service thermal,
# bekukan prosesnya, matikan thermal zone, lepas limit GPU/PPM/CPU, naikkan trip suhu, sembunyikan node sysfs thermal.
# Perubahan runtime disimpan dulu di $TS.* sehingga "thermal on" bisa mengembalikannya.
# Bagian boot-time (props ro.* + file overlay kosong) diatur oleh post-fs-data.sh dan baru berubah setelah REBOOT.
TS=$DIR/ths
EP=$DIR/early_props   # nilai asli properti boot-time (dicatat post-fs-data.sh sebelum ditimpa)
THSVC="thermal_core thermal_manager vendor.thermal-hal-2-0.mtk mi_thermald vendor.thermal-engine vendor.thermal-manager
 vendor.thermal-hal-2-0 vendor.thermal-symlinks vendor.thermal.symlinks thermal_mnt_hal_service vendor.thermal-hal thermal
 thermald thermalloadalgod thermalservice sec-thermal-1-0 debug_pid.sec-thermal-1-0 thermal-engine vendor.thermal-hal-1-0
 android.thermal-hal vendor-thermal-1-0 thermal-hal"
THBIN="android.hardware.thermal-service.mediatek android.hardware.thermal@2.0-service.mtk"
thermal_svcs(){ # daftar tetap selama HP hidup -> cari sekali saja (find+grep lambat, dulu diulang tiap pemanggilan); cache dibuang saat boot
  f=$DIR/c.thsvc
  if [ -s $f ]; then cat $f; return; fi
  thermal_svcs_r > $f.t 2>/dev/null
  if [ -s $f.t ]; then mv -f $f.t $f; cat $f; else rm -f $f.t; fi
}
thr_list(){ # node bernama *throttling* (find /sys penuh itu lambat, jadi hasilnya disimpan sampai reboot; dipindai di latar saat boot)
  f=$DIR/c.thr
  if [ -f $f ]; then cat $f; return; fi
  mkdir -p $DIR; find /sys -type f -name '*throttling*' 2>/dev/null > $f.t; mv -f $f.t $f; cat $f
}
thr_scan(){ thr_list >/dev/null; }
thermal_svcs_r(){ find /*/etc/init -type f 2>/dev/null | xargs grep -Eh '^service.*thermal|^service +miui' 2>/dev/null | awk '{print $2}'; }
# sw <nilai> <node>: tulis ke node, simpan nilai asli (sekali) untuk dipulihkan
sw(){ [ -e "$2" ] || return 0; if ! grep -q "^$2|" $TS.vals 2>/dev/null; then _o=; IFS= read -r _o < "$2" 2>/dev/null; echo "$2|$_o" >> $TS.vals; fi; w "$1" "$2"; }
# rp <prop> <nilai>: set properti (resetprop), simpan nilai asli (sekali)
rp(){ grep -q "^$1|" $TS.props 2>/dev/null || echo "$1|$(getprop $1)" >> $TS.props; resetprop -n $1 "$2" 2>/dev/null || setprop $1 "$2" 2>/dev/null; }
# PENTING: JANGAN bekukan (kill -STOP) proses HAL thermal (android.hardware.thermal@2.0-service.mtk dkk).
# Proses yang "dibekukan" tetap terdaftar hidup di binder, jadi system_server (ThermalService/GameManager, dipanggil
# banyak app & khususnya game saat start) ikut menggantung menunggu balasan yang tidak pernah datang -> WebUI & app
# macet total, cuma lepas setelah reboot. `stop` (ctl.stop) sudah cukup: init TIDAK start ulang service setelah
# stop eksplisit (beda dari service yang crash sendiri), dan binder death-notification berjalan normal.
th_pids(){ pgrep thermal 2>/dev/null; pidof $THBIN 2>/dev/null | tr ' ' '\n'; }
th_stop_all(){
  for a in $(thermal_svcs) $THSVC; do stop $a 2>/dev/null; done
}
th_off(){
  mkdir -p $DIR
  cmd thermalservice override-status 0 >/dev/null 2>&1 & _cp=$!   # Java/binder lambat: jalan paralel dengan langkah lain, ditunggu di akhir
  # catat service yang sedang berjalan (sekali) agar bisa distart lagi
  [ -f $TS.svc ] || { : > $TS.svc; for a in $(thermal_svcs); do [ "$(getprop init.svc.$a)" = running ] && echo $a >> $TS.svc; done; }
  # ulangi sampai tidak ada service thermal yang masih berjalan (maks 5x) — pengganti loop yang rusak di modul asli
  i=0; while [ $i -lt 15 ]; do
    th_stop_all
    left=0; for a in $(thermal_svcs); do [ "$(getprop init.svc.$a)" = running ] && left=1; done
    [ $left = 0 ] && break; i=$((i+1)); sleep 0.3 2>/dev/null || sleep 1
  done
  # properti boot-time (thermal_props.list) juga diterapkan di runtime supaya on/off tanpa reboot konsisten dengan kondisi setelah boot.
  # Nilai asli diambil dari $EP bila post-fs-data.sh sudah menimpanya, kalau tidak dari nilai saat ini.
  if [ -f $MODD/thermal_props.list ]; then
    while IFS= read -r kv; do
      case "$kv" in ''|\#*) continue;; esac
      pn=${kv%%=*}
      if ! grep -q "^$pn|" $TS.props 2>/dev/null; then
        e=$(grep "^$pn|" $EP 2>/dev/null | head -1)
        if [ -n "$e" ]; then echo "$e" >> $TS.props; else echo "$pn|$(getprop $pn)" >> $TS.props; fi
      fi
      resetprop -n "$pn" "${kv#*=}" 2>/dev/null
    done < $MODD/thermal_props.list
  fi
  # status service dipalsukan jadi "stopped", properti init.svc_* dikosongkan
  PL=$(getprop)   # satu kali dump (dulu 3x). Loop ke-3 mengecualikan kunci init.svc* karena di versi lama sudah berubah jadi stopped/kosong oleh loop 1-2
  for a in $(echo "$PL" | grep thermal | cut -f1 -d] | cut -f2 -d[ | grep -F init.svc.); do rp $a stopped; done
  for a in $(echo "$PL" | grep 'init\.svc_' | cut -f1 -d] | cut -f2 -d[); do rp $a ""; done
  for a in $(echo "$PL" | grep 'thermal.*running' | cut -f1 -d] | cut -f2 -d[ | grep -v -F -e init.svc. -e init.svc_); do rp $a freezed; done
  for kv in dalvik.vm.dexopt.thermal-cutoff=0 sys.thermal.enable=false ro.thermal_warmreset=false debug.thermal.throttle.support=no; do rp ${kv%%=*} ${kv#*=}; done
  # thermal zone
  for z in /sys/class/thermal/thermal_zone*; do sw disabled $z/mode; sw step_wise $z/policy; done
  # limit GPU (MTK)
  if [ -f /proc/gpufreq/gpufreq_power_limited ]; then
    for s in ignore_batt_oc ignore_batt_percent ignore_low_batt ignore_thermal_protect ignore_pbm_limited; do echo "$s 1" > /proc/gpufreq/gpufreq_power_limited 2>/dev/null; done
    : > $TS.gpu
  fi
  # limit CPU dari thermal_message (Xiaomi/Transsion): set ke frekuensi maksimum
  if [ -f /sys/devices/virtual/thermal/thermal_message/cpu_limits ]; then
    for c in 0 2 4 6 7; do mf=$(rd /sys/devices/system/cpu/cpu$c/cpufreq/cpuinfo_max_freq)
      [ -n "$mf" ] && [ "$mf" -gt 0 ] && echo "cpu$c $mf" > /sys/devices/virtual/thermal/thermal_message/cpu_limits 2>/dev/null; done
  fi
  # PPM (Power Policy Manager): matikan policy yang membatasi
  if [ -f /proc/ppm/policy_status ]; then
    [ -f $TS.ppm ] || grep -E 'FORCE_LIMIT|PWR_THRO|THERMAL' /proc/ppm/policy_status | awk -F'[][]' '{print $2}' > $TS.ppm
    for i in $(cat $TS.ppm); do echo "$i 0" > /proc/ppm/policy_status 2>/dev/null; done
  fi
  sw 0 /sys/kernel/eara_thermal/enable   # EARA thermal MediaTek (ide dari MTKVEST); nilai asli dicatat sw dan dipulihkan th_on
  # trip suhu legacy MTK -> 125C tanpa cooler (berlaku sampai reboot; satu-satunya bagian yang tidak bisa dipulihkan runtime)
  if [ -f /proc/driver/thermal/tzcpu ]; then
    for tz in tzcpu tzpmic tzbattery tzpa tzcharger tzwmt tzbts tzbtsnrpa tzbtspa; do
      [ -f /proc/driver/thermal/$tz ] && echo "1 125000 0 mtktscpu-sysrst 0 0 no-cooler 200" > /proc/driver/thermal/$tz 2>/dev/null
    done
  fi
  # Qualcomm msm_thermal / kgsl
  sw 0 /sys/kernel/msm_thermal/enabled; sw 0 /sys/class/kgsl/kgsl-3d0/throttling
  sw N /sys/module/msm_thermal/parameters/enabled; sw 0 /sys/module/msm_thermal/core_control/enabled; sw 0 /sys/module/msm_thermal/vdd_restriction/enabled
  # proteksi arus baterai MTK + parameter workqueue (sesuai modul asli)
  [ -f /proc/mtk_batoc_throttling/battery_oc_protect_stop ] && { echo "stop 1" > /proc/mtk_batoc_throttling/battery_oc_protect_stop 2>/dev/null; : > $TS.batoc; }
  sw N /sys/module/workqueue/parameters/power_efficient; sw N /sys/module/workqueue/parameters/disable_numa
  # semua node bernama *throttling* -> 0 (yang nilainya 1 baris dipulihkan oleh `thermal on`; sisanya baru normal setelah reboot)
  thr_list | while IFS= read -r f; do
    [ -w "$f" ] || continue
    _l2=; { IFS= read -r _l1; IFS= read -r _l2; } < "$f" 2>/dev/null
    if [ -z "$_l2" ]; then sw 0 "$f"; else echo 0 > "$f" 2>/dev/null; fi   # nilai 1 baris dicatat -> bisa dipulihkan tanpa reboot
  done
  wait $_cp 2>/dev/null
  # terakhir: sembunyikan node thermal (izin asli disimpan)
  [ -f $TS.perm ] || find /sys/devices/virtual/thermal -type f -exec stat -c '%a %n' {} + 2>/dev/null > $TS.perm
  find /sys/devices/virtual/thermal -type f -exec chmod 000 {} + 2>/dev/null
}
th_on(){
  cmd thermalservice reset >/dev/null 2>&1 & _cp=$!   # paralel, ditunggu di akhir
  # kill -CONT: jaga-jaga lepaskan proses yang mungkin masih beku dari versi lama (sebelum perbaikan ini)
  for pid in $(cat $TS.pids 2>/dev/null) $(pgrep thermal 2>/dev/null); do kill -CONT $pid 2>/dev/null; done
  if [ -f $TS.perm ]; then   # dikelompokkan per izin: beberapa chmod saja, bukan satu chmod per file (ratusan node thermal)
    for m in $(awk '{print $1}' $TS.perm | sort -u); do awk -v m=$m '$1==m{print $2}' $TS.perm | xargs chmod $m 2>/dev/null; done
  fi
  if [ -f $TS.props ]; then while IFS='|' read -r p v; do
    if [ -n "$v" ]; then resetprop -n $p "$v" 2>/dev/null; else resetprop --delete $p 2>/dev/null; fi
  done < $TS.props; fi
  if [ -f $TS.vals ]; then while IFS='|' read -r f v; do [ -n "$v" ] && w "$v" "$f"; done < $TS.vals; fi
  [ -f $TS.gpu ] && for s in ignore_batt_oc ignore_batt_percent ignore_low_batt ignore_thermal_protect ignore_pbm_limited; do echo "$s 0" > /proc/gpufreq/gpufreq_power_limited 2>/dev/null; done
  if [ -f $TS.ppm ]; then for i in $(cat $TS.ppm); do echo "$i 1" > /proc/ppm/policy_status 2>/dev/null; done; fi
  [ -f $TS.batoc ] && echo "stop 0" > /proc/mtk_batoc_throttling/battery_oc_protect_stop 2>/dev/null
  if [ -s $TS.svc ]; then for a in $(cat $TS.svc); do start $a 2>/dev/null; done
  else for a in $(thermal_svcs); do start $a 2>/dev/null; done; fi
  wait $_cp 2>/dev/null
  rm -f $TS.*
}
thermal(){ # off|on [temp]  (temp = tanpa mengubah konfigurasi tersimpan)
  if [ "$1" = off ]; then
    th_off
    [ "$2" = temp ] || setcfg THERMAL off
  else
    th_on
    [ "$2" = temp ] || setcfg THERMAL on
    # Semua yang diubah th_off dipulihkan di sini tanpa reboot, KECUALI trip suhu legacy MTK (/proc/driver/thermal/tz*),
    # yang format aslinya tidak bisa dibaca balik -> hanya node itu yang baru normal setelah reboot.
    [ -f /proc/driver/thermal/tzcpu ] && echo "NOTE|trip suhu legacy MTK baru normal setelah reboot"
  fi
}

# ---------- BOOST TOUCH ----------
# Dibuat toggle on/off runtime: nilai asli tiap properti/node/setelan dicatat sekali lalu dikembalikan saat dimatikan.
# v2.23.2: default dibuat AMAN dan tidak menahan CPU/GPU terus-menerus (penyebab HP lain jadi berat/delay/panas):
#  - DEFAULT: input boost kernel (hanya bila node-nya ada di kernel), ramp-up CPU lebih cepat (up_rate_limit 500us, hispeed_load 75,
#    iowait boost), properti HWUI aman. Tidak ada lantai clock permanen. Dilewati di mode Eco (Eco memang menahan panas).
#  - TOUCH_CPU=max   : level brutal (boost 800 ms, uclamp.min top-app 40%, hispeed_load 50, input_boost_freq = clock maks). Lebih panas.
#  - TOUCH_CPU=off   : matikan sisi CPU, hanya properti HWUI + node vendor.
#  - TOUCH_SF=on     : EKSPERIMEN, durasi phase offset SurfaceFlinger + lepas pin thread Mali (angka acuan modul MTK 60Hz; bisa menambah
#                      latensi / patah-patah di HP lain & 120Hz, jadi tidak aktif bawaan).
#  - TOUCH_NORESAMPLE=on : matikan resampling event sentuh (ro.input.noresample). Bisa bikin scroll kurang halus, jadi tidak bawaan.
#  - TOUCH_EDGE=on   : matikan pembatas tepi layar Oppo/Realme (palm rejection) agar sentuhan di tepi tidak diabaikan
#  - TOUCH_LP=on     : long-press 300 ms (bawaan Android 400). Hanya kenyamanan, bukan performa; bisa salah-deteksi saat scroll.
TB=$DIR/touch
# tb_wr: tulis node sysfs hanya bila ada & bisa ditulis. Dicatat: nilai ASLI + nilai hasil baca-balik setelah ditulis (format bisa beda, mis. 1 -> Y).
# Saat dimatikan, node hanya dipulihkan bila nilainya MASIH sama dengan yang kita tulis (kalau mode Eco/Performa sudah mengubahnya lagi, tidak ditimpa).
tb_wr(){ [ -w "$1" ] || return 0; if grep -q "^$1|" $TB.nodes 2>/dev/null; then echo "$2" > "$1" 2>/dev/null; return 0; fi; o=$(cat "$1" 2>/dev/null); echo "$2" > "$1" 2>/dev/null; echo "$1|$o|$(cat "$1" 2>/dev/null)" >> $TB.nodes; }
tb_set(){ # namespace key nilai (setelan sistem; nilai asli dicatat sekali, __null__ = belum ada)
  grep -q "^$1|$2|" $TB.sets 2>/dev/null || { o=$(sget $1 $2); [ "$o" = null ] && o=__null__; echo "$1|$2|$o" >> $TB.sets; }
  sput $1 $2 $3
}
tb_rp(){ grep -q "^$1|" $TB.props 2>/dev/null || echo "$1|$(getprop $1)" >> $TB.props; resetprop -n $1 "$2" 2>/dev/null || setprop $1 "$2" 2>/dev/null; }
tb_wrp(){ case "$(cat "$1" 2>/dev/null)" in 0|1) tb_wr "$1" "$2";; esac; }   # node /proc: hanya bila nilai sekarang polos 0/1 (format lain dilewati supaya bisa dipulihkan persis)
touch_on(){
  mkdir -p $DIR
  touch_off   # mulai dari kondisi bersih: nilai asli (termasuk sisa versi lama) dipulihkan dulu, lalu diterapkan ulang
  tb_rp debug.hwui.skip_empty_damage true
  tb_rp debug.hwui.use_hint_manager true
  tb_rp windowsmgr.max_events_per_sec 240
  tb_rp ro.min_pointer_dur 1
  tb_rp debug.performance.tuning 1
  tb_rp persist.sys.use_fifo_ui 1
  tb_wr /sys/module/msm_performance/parameters/touchboost 1
  tb_wr /sys/power/pnpmgr/touch_boost 1
  tb_wr /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1   # thread UI/touch app depan dijadwalkan berprioritas latensi (bangun di core cepat/idle)
  tb_wr /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 1
  # node touch vendor tambahan (ide dari modul RedXTouch; ditulis sendiri, hanya node yang benar-benar ada di HP):
  #  - MediaTek perfmgr: tb_enable (touch boost kernel)
  #  - Oppo/Realme/OnePlus (ColorOS): game_switch_enable (mode sentuh game di firmware touch panel)
  #  - TOUCH_EDGE=on: matikan pembatas tepi layar (palm rejection) supaya sentuhan di tepi tidak diabaikan saat main game; bisa salah-sentuh
  tb_wrp /proc/perfmgr/tchbst/kernel/tb_enable 1
  tb_wrp /proc/touchpanel/game_switch_enable 1
  if [ "$(getcfg TOUCH_EDGE)" = on ]; then
    tb_wrp /proc/touchpanel/oppo_tp_limit_enable 0
    tb_wrp /proc/touchpanel/oplus_tp_limit_enable 0
  fi
  if [ "$(getcfg TOUCH_SF)" = on ]; then
    tb_rp debug.sf.use_phase_offsets_as_durations 1
    tb_rp debug.sf.late.app.duration 16600000
    tb_rp debug.sf.late.sf.duration 10500000
    tb_rp debug.mali.disable_backend_affinity true
  fi
  [ "$(getcfg TOUCH_NORESAMPLE)" = on ] && tb_rp ro.input.noresample 1
  [ "$(getcfg TOUCH_LP)" = on ] && tb_set secure long_press_timeout 300
  # sisi CPU: dilewati bila TOUCH_CPU=off atau mode Eco
  [ "$(getcfg TOUCH_CPU)" = off ] && return 0
  [ "$(curmode)" = eco ] && return 0
  ib=600; hl=60; fq=; um=
  if [ "$(getcfg TOUCH_CPU)" != normal ]; then   # bawaan brutal; TOUCH_CPU=normal untuk level ringan
    ib=1500; um=60.00; hl=30
    for pl in $CPU/policy*; do
      c=$(rd $pl/related_cpus); c=${c%% *}; f=$(rd $pl/cpuinfo_max_freq)
      [ -n "$c" ] && [ -n "$f" ] && fq="$fq $c:$f"
    done
    fq=${fq# }
  fi
  tb_wr /sys/module/cpu_boost/parameters/input_boost_ms $ib
  tb_wr /sys/module/cpu_boost/parameters/sched_boost_on_input Y
  tb_wr /sys/devices/system/cpu/cpu_boost/input_boost_ms $ib
  tb_wr /sys/devices/system/cpu/cpu_boost/sched_boost_on_input 1
  if [ -n "$fq" ]; then
    tb_wr /sys/module/cpu_boost/parameters/input_boost_freq "$fq"
    tb_wr /sys/devices/system/cpu/cpu_boost/input_boost_freq "$fq"
  fi
  # ramp-up lebih cepat saat UI butuh (tidak ada lantai clock di level default); perf = clock sudah terkunci, jadi dilewati
  [ "$(curmode)" = perf ] && return 0
  [ -n "$um" ] && tb_wr /dev/cpuctl/top-app/cpu.uclamp.min $um
  for u in $CPU/policy*/schedutil $CPU/policy*/walt; do
    tb_wr $u/up_rate_limit_us 500
    tb_wr $u/rate_limit_us 500
    tb_wr $u/hispeed_load $hl
    tb_wr $u/iowait_boost_enable 1
  done
}
touch_off(){
  if [ -f $TB.props ]; then
    while IFS='|' read -r p v; do
      if [ -n "$v" ]; then resetprop -n "$p" "$v" 2>/dev/null; else resetprop --delete "$p" 2>/dev/null; fi
    done < $TB.props
  fi
  rm -f $TB.props
  if [ -f $TB.nodes ]; then
    while IFS='|' read -r p v s; do
      [ -n "$v" ] && [ -w "$p" ] || continue
      case "$p" in /proc/*) case "$v" in 0|1) ;; *) continue;; esac;; esac   # node /proc: pulihkan hanya bila nilai asli polos 0/1 (format lain bisa salah tulis)
      if [ -z "$s" ] || [ "$(cat "$p" 2>/dev/null)" = "$s" ]; then echo "$v" > "$p" 2>/dev/null; fi
    done < $TB.nodes
    rm -f $TB.nodes
  fi
  if [ -f $TB.sets ]; then
    while IFS='|' read -r ns k o; do
      if [ -n "$o" ] && [ "$o" != __null__ ]; then sput $ns $k "$o"; else sdel $ns $k; fi
    done < $TB.sets
    rm -f $TB.sets
  fi
}

# ---------- SETTINGS HELPER (fallback ke content provider bila `settings` gagal) ----------
# ctl <ttl detik> <kunci> <perintah...> : khusus status (SC=1) hasil perintah lambat disimpan sebentar; di luar status selalu jalan langsung.
# Kunci "t.*" dibuang tiap ada perintah selain status (supaya perubahan dari modul langsung terlihat); "l.*" dibuang saat boot.
ctl(){ ttl=$1; cf=$DIR/c.$2; shift 2
  if [ -n "$SC" ]; then
    if [ -f "$cf" ] && [ $(( $(date +%s) - $(stat -c %Y "$cf" 2>/dev/null || echo 0) )) -lt "$ttl" ]; then cat "$cf"; return; fi
    "$@" > "$cf" 2>/dev/null; cat "$cf"
  else "$@"; fi
}
sdel(){ settings delete $1 $2 >/dev/null 2>&1; content delete --uri content://settings/$1 --where "name='$2'" >/dev/null 2>&1; }
sput(){ # ns key value
  o=$(settings put $1 $2 $3 2>&1)
  case "$o" in *Failure*|*cmd:*|*xception*) content insert --uri content://settings/$1 --bind name:s:$2 --bind value:s:$3 >/dev/null 2>&1;; esac
}
sget(){ ctl 15 t.s.$1.$2 sget_r $1 $2; }
sget_r(){ # ns key
  v=$(settings get $1 $2 2>&1)
  case "$v" in *Failure*|*cmd:*|*xception*|null) v=$(content query --uri content://settings/$1 --where "name='$2'" 2>/dev/null | sed -n 's/.*value=\([^,]*\).*/\1/p');; esac
  echo "$v"
}

# ---------- PRIVATE DNS ----------
# Preset hostname DoT (DNS-over-TLS) umum. "default" = ikut sistem (mode off/automatic bawaan ROM),
# "auto" = mode opportunistic Android (otomatis pakai DoT kalau jaringan mendukung, fallback diam-diam kalau tidak),
# "custom" = hostname bebas dari user.
dns_host(){ case $1 in
  cloudflare) echo 1dot1dot1dot1.cloudflare-dns.com;;
  google) echo dns.google;;
  adguard) echo dns.adguard.com;;
  adguard_fam) echo family.adguard-dns.com;;
  quad9) echo dns.quad9.net;;
  opendns) echo doh.opendns.com;;
esac; }
dns_set(){ # key [hostname_custom]
  case $1 in
    default) sput global private_dns_mode off; sdel global private_dns_specifier;;
    auto) sput global private_dns_mode opportunistic; sdel global private_dns_specifier;;
    custom) [ -n "$2" ] || { echo "ERR|hostname kosong"; return 1; }; sput global private_dns_mode hostname; sput global private_dns_specifier "$2";;
    cloudflare|google|adguard|adguard_fam|quad9|opendns) sput global private_dns_mode hostname; sput global private_dns_specifier "$(dns_host $1)";;
    *) echo "ERR|pilihan tidak dikenal"; return 1;;
  esac
  setcfg DNS "$1"; [ "$1" = custom ] && setcfg DNS_H "$2"
  echo OK
}

# ---------- REFRESH RATE ----------
rates(){ # daftar Hz layar: tetap selama perangkat hidup -> cukup sekali (dumpsys display lambat); dibuang saat boot
  if [ -s $DIR/c.rates ]; then cat $DIR/c.rates; return; fi
  d=$(dumpsys display 2>/dev/null)
  r=$(echo "$d" | grep -o 'fps=[0-9.]*' | cut -d= -f2 | awk '{print int($1+0.5)}' | sort -un | tr '\n' ' ' | sed 's/ $//')
  [ -n "$r" ] && echo "$r" > $DIR/c.rates
  # daftar mode layar (lebar/tinggi/Hz) disimpan sekali dari dump yang sama: refresh_apply tidak perlu dumpsys lagi tiap pindah mode
  [ -s $DIR/c.modes ] || { echo "$d" | grep -o 'width=[0-9]*, height=[0-9]*, fps=[0-9.]*' | awk '!s[$0]++' > $DIR/c.modes.t; if [ -s $DIR/c.modes.t ]; then mv -f $DIR/c.modes.t $DIR/c.modes; else rm -f $DIR/c.modes.t; fi; }
  echo "$r"
}
rlist(){ r=$(rates | tr ' ' '\n' | awk '$1>=60'); [ -n "$r" ] || r="60 90 120"; echo $r | tr ' ' '\n' | sort -n; }
mode_hz(){ # Hz untuk tiap mode: perf=tertinggi, balance=90 (bila ada, jika tidak terendah), eco=terendah (>=60)
  case $1 in
    perf) rlist | tail -1;;
    eco) rlist | head -1;;
    balance) if rlist | grep -qx 90; then echo 90; else rlist | head -1; fi;;
    plite) hz_snap 90;;
  esac
}
refresh_apply(){ # terapkan Hz ke sistem (dipakai refresh() & watchdog refresh_wd, tanpa validasi -- harus sudah dicek)
  # tiga perintah Java/binder yang saling bebas dijalankan paralel (dulu berurutan ~2-3 detik); PID ditunggu satu per satu supaya tidak ikut menunggu daemon latar
  _hf=$(hz_lock_on)
  [ "$_hf" = on ] && sf_force $1   # kunci mode SurfaceFlinger dulu (urutan sama dengan Refresh Rate Tool); bawaan aktif
  sput system min_refresh_rate $1.0 & _p1=$!
  sput system peak_refresh_rate $1.0 & _p2=$!
  _p4=; _p5=
  if [ "$_hf" = on ]; then
    hz_keys   # user_refresh_rate / miui_refresh_rate hanya ditulis bila ROM memang punya (AOSP murni tidak punya: jangan mengotori Settings)
    [ -n "$HZK_U" ] && { sput system user_refresh_rate $1 & _p4=$!; }
    [ -n "$HZK_M" ] && { sput secure miui_refresh_rate $1 & _p5=$!; }
  fi
  [ -s $DIR/c.modes ] || rates >/dev/null
  m=$(grep "fps=$1\.[0-9]*" $DIR/c.modes 2>/dev/null | head -1)
  _p3=
  if [ -n "$m" ]; then dw=${m#width=}; dw=${dw%%,*}; dh=${m#*height=}; dh=${dh%%,*}; cmd display set-user-preferred-display-mode $dw $dh $1 >/dev/null 2>&1 & _p3=$!; fi
  wait $_p1 $_p2 $_p3 $_p4 $_p5 2>/dev/null
  rom_apply $1   # kunci Settings milik ROM (hasil `rlearn`); diam bila belum dipelajari
}
refresh(){ # Hz [q = tanpa membaca balik nilai (lebih cepat)]
  case $1 in ''|*[!0-9]*) echo "ERR|nilai tidak valid"; return 1;; esac
  rt=$(rates)
  if [ -n "$rt" ]; then case " $rt " in *" $1 "*) ;; *) echo "ERR|$1 Hz tidak didukung layar (tersedia: $rt)"; return 1;; esac; fi
  setcfg RHZ $1
  refresh_apply $1
  refresh_sync
  if [ "$2" = q ]; then echo OK; else echo "OK|$(sget system peak_refresh_rate)"; fi
}
# Sejumlah ROM (XOS/Transsion dkk, lihat "Beralih Otomatis" di Pengaturan > Layar > Rasio penyegaran) punya logika
# adaptif sendiri yang menimpa balik peak_refresh_rate beberapa detik setelah kita set: naik ke Hz yang diminta,
# lalu turun lagi sendiri ke 90/60. Watchdog ini menegaskan ulang Hz pilihan tiap 3 detik selama meleset -- pola
# yang sama dipakai mesin charging untuk melawan charger HAL yang menimpa nilainya tiap siklus.
RHZW=$DIR/rhz
refresh_wd(){
  echo $$ > $RHZW.pid
  n=0
  while :; do
    cfgv RHZ; t=$CV
    if [ -n "$t" ]; then
      # `settings get` memulai proses Java (app_process) ~100+ ms CPU di core besar: dulu tiap 3 dtk = hentakan frame periodik. Kini tiap 9 dtk.
      if [ $((n % 3)) = 0 ]; then
        cur=$(sget system peak_refresh_rate 2>/dev/null); cur=${cur%%.*}
        if [ "$cur" != "$t" ]; then refresh_apply "$t"
        elif ! rom_ok "$t"; then rom_apply "$t"   # ROM menimpa kunci miliknya sendiri (hasil rlearn): tulis ulang
        fi
      fi
      [ $((n % 5)) = 0 ] && [ "$(hz_lock_on)" = on ] && sf_force "$t"   # kunci SurfaceFlinger hilang bila SF/ROM me-reset mode (mis. layar mati-hidup): pasang lagi
    fi
    n=$((n+1)); sleep 3
  done
}
refresh_sync(){
  [ -f $RHZW.pid ] && kill -0 $(cat $RHZW.pid) 2>/dev/null && return
  bg refresh_wd
}

# ---------- KUNCI Hz VIA SURFACEFLINGER (fitur hzforce) ----------
# ROM seperti XOS bisa menahan Hz di 90 walau Settings sudah 120. Aplikasi "Refresh Rate Tool" mengatasinya dengan: (1) mengunci mode
# layar langsung di SurfaceFlinger (`service call SurfaceFlinger 1035 i32 <id>`), lalu (2) menulis user_refresh_rate, peak_refresh_rate,
# min_refresh_rate, dan miui_refresh_rate. <id> = posisi mode pertama ber-Hz itu di daftar mode layar (urutan Display.getSupportedModes(), Hz kembar dihitung), mulai dari 0.
# Kunci SurfaceFlinger bertahan sampai dilepas (`1035 i32 -1`, id tidak valid) atau reboot. Sejak v2.35.7 kunci ini BAWAAN AKTIF di semua ROM
# (BBK/Transsion/AOSP): Performa = Hz tertinggi, Balance = 90, Eco = 60, dan Hz profil game ikut terkunci. Mematikan: `feat hzforce off` (tanpa tombol di WebUI).
hz_lock_on(){ [ "$(getcfg F_hzforce)" = off ] && echo off || echo on; }
hz_keys(){ # ada/tidaknya kunci Settings user_refresh_rate (system) & miui_refresh_rate (secure): dicek sekali per boot (c.* dibuang saat boot)
  if [ ! -f $DIR/c.hzk ]; then
    _u=; _m=
    case "$(sget system user_refresh_rate 2>/dev/null)" in ''|null) ;; *) _u=1;; esac
    case "$(sget secure miui_refresh_rate 2>/dev/null)" in ''|null) ;; *) _m=1;; esac
    echo "${_u:-0} ${_m:-0}" > $DIR/c.hzk
  fi
  read -r _a _b < $DIR/c.hzk
  HZK_U=; HZK_M=; [ "$_a" = 1 ] && HZK_U=1; [ "$_b" = 1 ] && HZK_M=1
}
sf_order(){ # Hz tiap mode layar utama (dibulatkan), satu per baris, urutan = id mode SurfaceFlinger (mulai 0); Hz kembar TIDAK dibuang
  [ -s $DIR/c.sfmodes ] && { cat $DIR/c.sfmodes; return; }
  _d=$(dumpsys display 2>/dev/null)
  _l=$(echo "$_d" | grep -m1 'supportedModes \[')   # baris DisplayDeviceInfo: daftar mode layar utama, urut id
  if [ -n "$_l" ]; then _t=$(echo "$_l" | grep -o 'width=[0-9]*, height=[0-9]*, fps=[0-9.]*')
  else _t=$(echo "$_d" | grep -o 'width=[0-9]*, height=[0-9]*, fps=[0-9.]*' | awk '!s[$0]++'); fi   # cadangan: seluruh dump, mode yang persis sama dibuang
  echo "$_t" | sed -n 's/^width=\([0-9]*\), height=[0-9]*, fps=\(.*\)$/\2 \1/p' | awk '{print int($1+0.5), $2}' > $DIR/c.sfmodes.t
  echo "$_d" | grep -m1 -o 'real [0-9]* x [0-9]*' | awk '{print $2}' > $DIR/c.sfw   # lebar layar saat ini (HP multi-resolusi: jangan loncat ke resolusi lain)
  if [ -s $DIR/c.sfmodes.t ]; then mv -f $DIR/c.sfmodes.t $DIR/c.sfmodes; else rm -f $DIR/c.sfmodes.t; fi
  [ -s $DIR/c.sfmodes ] && cat $DIR/c.sfmodes
}
sf_idx(){ _o=$(sf_order); _w=$(cat $DIR/c.sfw 2>/dev/null)   # mode pertama ber-Hz itu pada lebar layar saat ini; bila tak ketemu, mode pertama ber-Hz itu
  echo "$_o" | awk -v t="$1" -v w="$_w" '$1+0==t+0{ if(f=="") f=NR-1; if(w==""||$2==w){ print NR-1; d=1; exit } } END{ if(!d && f!="") print f }'; }
sf_force(){ _i=$(sf_idx $1); [ -n "$_i" ] || return 1; service call SurfaceFlinger 1035 i32 $_i >/dev/null 2>&1; }
sf_release(){ service call SurfaceFlinger 1035 i32 -1 >/dev/null 2>&1; }

# ---------- BELAJAR KUNCI REFRESH RATE ROM (XOS / HiOS / ColorOS / OxygenOS / realme UI dll) ----------
# ROM BBK (ColorOS, OxygenOS, realme UI) dan Transsion (XOS, HiOS) menyimpan pilihan "Rasio penyegaran" di kunci Settings miliknya
# sendiri dan menimpa balik min/peak_refresh_rate bawaan Android. Nama kuncinya beda tiap ROM dan tidak terdokumentasi, jadi modul
# mempelajarinya dari HP itu sendiri: ambil snapshot seluruh Settings tiap kali pilihan Hz di Pengaturan > Layar diganti, lalu bandingkan.
#   1) Pengaturan > Layar > Rasio penyegaran: pilih opsi terendah (mis. 60Hz / Standar)   ->  ultrapower rlearn snap 60
#   2) (opsional) pilih opsi tengah (mis. 90Hz)                                           ->  ultrapower rlearn snap 90
#   3) pilih opsi tertinggi (mis. 120Hz / Tinggi)                                         ->  ultrapower rlearn snap 120
#   4) ultrapower rlearn build  -> kunci yang berubah disimpan; sesudahnya `refresh 120` dan mode Performa ikut menulisnya.
# Jangan mengubah pengaturan lain di antara snapshot supaya hasil diff bersih.
RLD=$DIR/rl          # snapshot per Hz: <Hz>.snap (baris: namespace|kunci=nilai)
RK=$DIR/romkeys      # hasil: Hz|namespace|kunci|nilai   (nilai __null__ = kunci tidak ada pada snapshot itu)
RLKEY='refresh|fps|hz|frame|smooth|screen|display|panel|dfps|vrr|oplus|oppo|tran|xos|hios|adapt|dynamic|fluen|rate'
RLMAX=12             # batas jumlah kunci hasil penyaringan; lebih dari ini dianggap noise (ulangi tanpa mengubah hal lain)

rl_snap(){ # Hz
  case $1 in ''|*[!0-9]*) echo "ERR|pakai: rlearn snap <Hz> (angka, mis. 60 / 90 / 120)"; return 1;; esac
  mkdir -p $RLD
  : > $RLD/$1.snap.t
  for ns in system secure global; do settings list $ns 2>/dev/null | sed "s/^/$ns|/" >> $RLD/$1.snap.t; done
  if [ ! -s $RLD/$1.snap.t ]; then rm -f $RLD/$1.snap.t; echo "ERR|gagal membaca Settings (settings list kosong)"; return 1; fi
  mv -f $RLD/$1.snap.t $RLD/$1.snap
  echo "OK|snapshot $1 Hz tersimpan ($(wc -l < $RLD/$1.snap) kunci)"
}

rl_build(){
  n=$(ls $RLD/*.snap 2>/dev/null | wc -l)
  [ "$n" -ge 2 ] || { echo "ERR|butuh minimal 2 snapshot (mis. 60 dan 120), sekarang $n"; return 1; }
  for f in $RLD/*.snap; do hz=${f##*/}; hz=${hz%.snap}; sed "s/^/$hz|/" "$f"; done | awk '
    { i=index($0,"|"); hz=substr($0,1,i-1); r=substr($0,i+1);
      j=index(r,"|"); ns=substr(r,1,j-1); kv=substr(r,j+1); e=index(kv,"="); if(e==0) next;
      k=ns "|" substr(kv,1,e-1); v=substr(kv,e+1);
      if(index(v,"|")>0){ bad[k]=1; next }
      if(!(hz in seen)){ seen[hz]=1; nh++; hzl[nh]=hz }
      val[hz ":" k]=v; keys[k]=1 }
    END{ for(k in keys){ if(k in bad) continue;
           d=0; first="";
           for(h=1;h<=nh;h++){ x="__null__"; if((hzl[h] ":" k) in val) x=val[hzl[h] ":" k]; if(h==1) first=x; else if(x!=first) d=1 }
           if(d) for(h=1;h<=nh;h++){ x="__null__"; if((hzl[h] ":" k) in val) x=val[hzl[h] ":" k]; print hzl[h] "|" k "|" x } } }' | sort > $RLD/all.t
  mv -f $RLD/all.t $RLD/all
  # min/peak_refresh_rate diatur modul sendiri per mode (refresh_apply): jangan ikut dipelajari, kalau tidak nilai snapshot menimpa batas Hz mode
  grep -iE "^[0-9]+[|][a-z]+[|][^|]*($RLKEY)[^|]*[|]" $RLD/all | grep -viE '^[0-9]+[|]system[|](min|peak)_refresh_rate[|]' > $RK.t
  nk=$(cut -d'|' -f2,3 $RK.t | sort -u | wc -l)
  na=$(cut -d'|' -f2,3 $RLD/all | sort -u | wc -l)
  if [ "$nk" -eq 0 ]; then
    rm -f $RK.t $RK
    echo "ERR|tidak ada kunci terkait layar yang berubah ($na kunci lain berubah: lihat 'rlearn show all', pilih dengan 'rlearn add <ns> <kunci>')"; return 1
  fi
  if [ "$nk" -gt "$RLMAX" ]; then
    rm -f $RK.t $RK
    echo "ERR|terlalu banyak kunci berubah ($nk > $RLMAX), kemungkinan ada pengaturan lain ikut berubah. Ulangi snapshot tanpa menyentuh pengaturan lain. (lihat: rlearn show all)"; return 1
  fi
  sort -u $RK.t > $RK; rm -f $RK.t
  echo "OK|$nk kunci dipelajari dari $n snapshot ($(ls $RLD/*.snap | sed 's#.*/##; s#\.snap$##' | sort -n | tr '\n' ' ')Hz); total berubah $na"
  cut -d'|' -f2,3 $RK | sort -u | sed 's/^/KUNCI|/'
}

rl_show(){
  if [ "$1" = all ]; then [ -s $RLD/all ] && cat $RLD/all || echo "ERR|belum ada hasil, jalankan: rlearn build"
  else [ -s $RK ] && cat $RK || echo "ERR|belum ada kunci yang dipelajari"; fi
}

rl_add(){ # <ns> <kunci>: ambil kunci dari daftar 'show all' (kunci yang namanya tidak lolos penyaringan)
  [ -n "$2" ] || { echo "ERR|pakai: rlearn add <system|secure|global> <kunci>"; return 1; }
  [ -s $RLD/all ] || { echo "ERR|belum ada hasil, jalankan: rlearn build"; return 1; }
  awk -F'|' -v n="$1" -v k="$2" '$2==n && $3==k' $RLD/all > $RLD/add.t
  [ -s $RLD/add.t ] || { rm -f $RLD/add.t; echo "ERR|$1 $2 tidak ada di daftar perubahan"; return 1; }
  cat $RLD/add.t >> $RK; rm -f $RLD/add.t
  sort -u $RK > $RK.t && mv -f $RK.t $RK
  echo "OK|$1 $2 ditambahkan"
}

rom_pick(){ # Hz tujuan -> Hz snapshot yang dipakai: terkecil yang >= tujuan (batas atas tetap dari min/peak AOSP), jika tidak ada: yang terbesar
  cut -d'|' -f1 $RK | sort -un | awk -v t="$1" '{ a[NR]=$1 } END{ p=""; for(i=1;i<=NR;i++) if(a[i]+0>=t+0){ p=a[i]; break } if(p=="") p=a[NR]; print p }'
}
rom_apply(){ # Hz: tulis kunci ROM hasil `rlearn` untuk Hz ini (diam bila belum ada yang dipelajari)
  [ -s $RK ] || return 0
  p=$(rom_pick $1); [ -n "$p" ] || return 0
  while IFS='|' read -r h ns k v; do
    [ "$h" = "$p" ] || continue
    if [ "$v" = __null__ ]; then sdel $ns $k; else sput $ns $k "$v"; fi
  done < $RK
}
rom_ok(){ # Hz: 0 bila semua kunci ROM sudah bernilai seperti hasil belajar (dipakai watchdog)
  [ -s $RK ] || return 0
  p=$(rom_pick $1); [ -n "$p" ] || return 0
  for ns in system secure global; do
    grep -q "^$p[|]$ns[|]" $RK || continue
    cur=$(settings list $ns 2>/dev/null)
    while IFS='|' read -r h n2 k v; do
      [ "$h" = "$p" ] && [ "$n2" = "$ns" ] || continue
      if [ "$v" = __null__ ]; then echo "$cur" | grep -q "^$k=" && return 1
      else echo "$cur" | grep -qxF "$k=$v" || return 1; fi
    done < $RK
  done
  return 0
}
rlearn(){
  case $1 in
    snap) rl_snap $2;;
    build) rl_build;;
    show) rl_show $2;;
    add) rl_add $2 $3;;
    clear) rm -rf $RLD $RK; echo OK;;
    *) echo "ERR|pakai: rlearn {snap <Hz> | build | show [all] | add <ns> <kunci> | clear}"; return 1;;
  esac
}

# ---------- MATIKAN FPSGO (fitur "fpsgooff": ON = FPSGO dimatikan, supaya FPS tidak diturunkan scheduler frame kernel) ----------
# Saklar utama: /sys/kernel/fpsgo/common/fpsgo_enable (1 = FPSGO jalan/bawaan, 0 = mati). Bila jalur standar tidak ada, dicari node
# bernama fpsgo_enable di lokasi FPSGO yang dikenal. "Didukung" = node ada dan terbaca; boleh-tidaknya ditulis dicoba saat dipakai
# (chmod dulu), karena -w sering salah menolak node sysfs yang sebenarnya bisa ditulis oleh root.
FPSGO_N=/sys/kernel/fpsgo/common/fpsgo_enable
if [ ! -e "$FPSGO_N" ]; then
  FPSGO_N=
  for _d in /sys/kernel/fpsgo /sys/module/mtk_fpsgo /sys/module/fpsgo /sys/kernel/debug/fpsgo /proc/fpsgo; do
    [ -d $_d ] || continue
    FPSGO_N=$(find $_d -maxdepth 3 -name fpsgo_enable 2>/dev/null | head -1)
    [ -n "$FPSGO_N" ] && break
  done
fi
fpsgo_supported(){ [ -n "$FPSGO_N" ] && [ -e "$FPSGO_N" ] && echo yes || echo no; }
# Kernel custom sering membuang FPSGO (tanpa fpsgo_enable). Saat itu "Matikan FPSGO" tidak diam: ia memakai MODE PENGGANTI yang
# bekerja lewat knob lain (GED/PerfMgr MediaTek, boost foreground, SurfaceFlinger) di fp_alt, dipasang saat game aktif & dipulihkan fp_off.
fpsgo_alt(){ [ -f $DIR/fpsgo_ro ] && return 0; [ "$(fpsgo_supported)" = yes ] && return 1; return 0; }   # fpsgo_ro: node ada tapi kernel menolak/menimpa tulisan
fpsgo_set(){ # <on|off>: on = matikan FPSGO (tulis 0), off = nyalakan lagi (tulis 1). Tulis, baca balik, ulangi bila dikembalikan.
  v=1; [ "$1" = on ] && v=0; i=0; FPSGO_ERR=
  while [ $i -lt 3 ]; do
    chmod 644 "$FPSGO_N" 2>/dev/null
    FPSGO_ERR=$( { echo "$v" > "$FPSGO_N"; } 2>&1 )
    sleep 0.3 2>/dev/null || sleep 1
    [ "$(rd "$FPSGO_N")" = "$v" ] && { FPSGO_ERR=; return 0; }
    i=$((i+1))
  done
  return 1
}
fpsgo_keep(){ # dipanggil pemantau game: bila fitur ON tetapi kernel/ROM menyalakan FPSGO lagi, matikan lagi (tanpa fork bila sudah benar)
  [ -n "$FPSGO_N" ] || return 0
  read -r _fv 2>/dev/null < "$FPSGO_N" || return 0
  [ "$_fv" = 0 ] || { echo 0 > "$FPSGO_N" 2>/dev/null; }
}

# ---------- FREKUENSI DRAM (MediaTek: devfreq DVFSRC, mis. mtk-dvfsrc-devfreq) ----------
# "Kunci" = lantai: min_freq dinaikkan ke frekuensi pilihan, max_freq tetap bawaan. DVFSRC memilih OPP DDR tertinggi dari semua permintaan
# (display, modem, game boost, dll), jadi membatasi max tidak menjamin DRAM turun; lantai (min) yang pasti bekerja.
# Nilai asli (min|max) dicatat sekali di $DIR/dram dan dipulihkan persis lewat "auto". Config DRAM_LOCK diterapkan lagi saat boot.
DRAM_D=""; for _d in /sys/class/devfreq/*dvfsrc*; do [ -r "$_d/available_frequencies" ] && [ -e "$_d/min_freq" ] && { DRAM_D=$_d; break; }; done
DRAMF=$DIR/dram
dram_list(){ tr ' ' '\n' < $DRAM_D/available_frequencies 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tr '\n' ' ' | sed 's/ $//'; }
dram_status(){ # DRAM|ada|daftar Hz|cur|min|max|kunci|RAM MB
  if [ -z "$DRAM_D" ]; then echo "DRAM|no"; return; fi
  echo "DRAM|yes|$(dram_list)|$(rd $DRAM_D/cur_freq)|$(rd $DRAM_D/min_freq)|$(rd $DRAM_D/max_freq)|$(getcfg DRAM_LOCK)|$(awk '/^MemTotal/{printf "%d",$2/1024}' /proc/meminfo)"
}
dram_unlock(){
  [ -n "$DRAM_D" ] || { echo "ERR|node DRAM (DVFSRC devfreq) tidak ditemukan di kernel ini"; return; }
  if [ -f $DRAMF ]; then IFS='|' read -r _mn _mx < $DRAMF; else _l=$(dram_list); _mn=${_l%% *}; _mx=${_l##* }; fi
  [ -n "$_mx" ] && echo "$_mx" > $DRAM_D/max_freq 2>/dev/null   # max dulu: min_freq di atas max_freq ditolak kernel
  [ -n "$_mn" ] && echo "$_mn" > $DRAM_D/min_freq 2>/dev/null
  rm -f $DRAMF; setcfg DRAM_LOCK ""; echo OK
}
dram_lock(){ # <Hz> : lantai DRAM
  [ -n "$DRAM_D" ] || { echo "ERR|node DRAM (DVFSRC devfreq) tidak ditemukan di kernel ini"; return; }
  case " $(dram_list) " in *" $1 "*) ;; *) echo "ERR|frekuensi $1 tidak ada di daftar HP ini"; return;; esac
  [ -f $DRAMF ] || echo "$(rd $DRAM_D/min_freq)|$(rd $DRAM_D/max_freq)" > $DRAMF
  IFS='|' read -r _mn _mx < $DRAMF
  [ -n "$_mx" ] && echo "$_mx" > $DRAM_D/max_freq 2>/dev/null
  _e=$( { echo "$1" > $DRAM_D/min_freq; } 2>&1 )
  sleep 0.2 2>/dev/null || sleep 1
  if [ "$(rd $DRAM_D/min_freq)" != "$1" ]; then echo "ERR|DRAM menolak kunci: $(echo "${_e:-nilai dikembalikan sistem}" | tr -d '|' | tr '\n' ' ' | cut -c1-80)"; return; fi
  setcfg DRAM_LOCK "$1"; echo "OK|$(rd $DRAM_D/cur_freq)"
}
dram_set(){ case $1 in auto) dram_unlock;; ''|*[!0-9]*) echo "ERR|nilai tidak valid";; *) dram_lock $1;; esac; }

# ---------- DARI MTKVEST & GTURBO (hanya ide; kode ditulis sendiri, semua bisa dipulihkan) ----------
# 1) gamefps  : Android 15 membatasi game ke 60 FPS secara bawaan; properti debug.graphics.game_default_frame_rate.disabled mematikan batas itu.
# 2) GED GPU  : tuning DVFS GPU MediaTek lewat /sys/kernel/ged/hal (nilai level dari profil perf/game MTKVEST); nilai asli dicatat sekali.
# 3) katalog game: daftar nama paket game populer (fakta publik) untuk mendeteksi game yang terpasang.
# Tidak dibawa dari MTKVEST: mematikan cpuidle/LPM/DCM/PBM/suspend (boros baterai & panas, tanpa jalur pulih), wifi.cfg firmware, APK; dari GTurbo: fas-rs
# (binary native), serta polling dumpsys window (penyebab touch lag).
GFP=$DIR/gfps; GFPP=debug.graphics.game_default_frame_rate.disabled
gfps_on(){
  sdk=$(getprop ro.build.version.sdk); [ "${sdk:-0}" -ge 35 ] 2>/dev/null || { echo "ERR|Butuh Android 15 atau lebih baru"; return; }
  [ -f $GFP ] || getprop $GFPP > $GFP
  resetprop -n $GFPP true 2>/dev/null || setprop $GFPP true 2>/dev/null; echo OK
}
gfps_off(){
  if [ -f $GFP ]; then o=$(cat $GFP); rm -f $GFP
    if [ -n "$o" ]; then resetprop -n $GFPP "$o" 2>/dev/null; else resetprop --delete $GFPP 2>/dev/null || resetprop -n $GFPP false 2>/dev/null; fi
  fi; echo OK
}
GEDD=/sys/kernel/ged/hal; GEDF=$DIR/ged; GEDN="loading_base_dvfs_step loading_stride_size loading_window_size gpu_boost_level"
ged_status(){ if [ -e $GEDD/gpu_boost_level ]; then echo "GED|yes|$(getcfg GED_LV)|$(rd $GEDD/gpu_boost_level)"; else echo "GED|no"; fi; }
ged_set(){ # auto | tinggi | maks
  _lv=$1   # simpan dulu: "set --" di bawah menimpa $1
  [ -e $GEDD/gpu_boost_level ] || { echo "ERR|node GED tidak ditemukan (bukan GPU MediaTek)"; return; }
  case $1 in
    auto) if [ -f $GEDF ]; then while IFS='|' read -r n v; do [ -n "$v" ] && w "$v" $GEDD/$n; done < $GEDF; rm -f $GEDF; fi; setcfg GED_LV ""; [ -n "$GPU" ] && gpu_mode "$(curmode)"; echo OK; return;;
    tinggi) vals="4 2 8 50";;
    maks) vals="2 1 16 100";;
    *) echo "ERR|level tidak dikenal"; return;;
  esac
  if [ ! -f $GEDF ]; then for n in $GEDN; do echo "$n|$(rd $GEDD/$n)" >> $GEDF; done; fi
  set -- $vals; i=0; for n in $GEDN; do i=$((i+1)); eval "v=\${$i}"; w "$v" $GEDD/$n; done
  sleep 0.2 2>/dev/null || sleep 1
  v4=$(echo $vals | awk '{print $4}')
  if [ "$(rd $GEDD/gpu_boost_level)" != "$v4" ]; then echo "ERR|GED menolak nilai (sekarang: $(rd $GEDD/gpu_boost_level))"; return; fi
  setcfg GED_LV "$_lv"; ged_floor "$(curmode)"; echo OK
}
games_catalog(){ cat <<'EOF'
com.tencent.ig
