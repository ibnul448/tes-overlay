  # + daftar game bawaan ($MODD/gamelist.txt); baris tak valid dibuang
  [ -f $MODD/gamelist.txt ] && grep -E '^[A-Za-z0-9_.]+$' $MODD/gamelist.txt
  return 0
}

# ---------- I/O SCHEDULER, RENDERER GRAFIS, GMS LIMITER, AGGRESSIVE DOZE (menu Tweaks UI baru) ----------
ios_nodes(){ for q in /sys/block/sd[a-z]/queue/scheduler /sys/block/sd[a-z][a-z]/queue/scheduler /sys/block/mmcblk[0-9]/queue/scheduler; do [ -e "$q" ] && echo $q; done; }
ios_list(){ q=$(ios_nodes | head -1); [ -n "$q" ] && cat $q 2>/dev/null | tr -d '[]'; }
ios_cur(){ q=$(ios_nodes | head -1); [ -n "$q" ] && brk_cur $q; }
ios_set(){ # <nama>: terapkan ke semua disk fisik (sd*/mmcblk*), simpan di config untuk dipasang lagi saat boot
  case " $(ios_list) " in *" $1 "*) ;; *) echo "ERR|scheduler $1 tidak tersedia"; return 1;; esac
  for q in $(ios_nodes); do w $1 $q; done
  # perf_extra mencatat scheduler asli untuk dipulihkan saat keluar mode Performa; pilihan pengguna tidak boleh ditimpa catatan itu
  [ -f $PXV ] && { grep -v '/queue/scheduler|' $PXV > $PXV.t; mv -f $PXV.t $PXV; }
  setcfg IOSCHED $1; echo "OK|$(ios_cur)"
}
ios_boot(){ v=$(getcfg IOSCHED); [ -n "$v" ] && ios_set $v >/dev/null 2>&1; }
# Renderer HWUI: berlaku untuk proses aplikasi yang dibuka SETELAH diubah. Kunci: default | skiavk | skiavkt | skiagl | skiaglt (t = threaded)
rd_del(){ resetprop --delete $1 >/dev/null 2>&1 || setprop $1 "" >/dev/null 2>&1; }
rd_set(){ resetprop -n $1 "$2" >/dev/null 2>&1 || setprop $1 "$2" >/dev/null 2>&1; }
rend_apply(){
  case $1 in
    default) rd_del debug.hwui.renderer; rd_del debug.skia.threaded_mode; rd_del debug.hwui.render_thread;;
    skiavk|skiagl) rd_set debug.hwui.renderer $1; rd_del debug.skia.threaded_mode; rd_del debug.hwui.render_thread;;
    skiavkt) rd_set debug.hwui.renderer skiavk; rd_set debug.skia.threaded_mode true; rd_set debug.hwui.render_thread true;;
    skiaglt) rd_set debug.hwui.renderer skiagl; rd_set debug.skia.threaded_mode true; rd_set debug.hwui.render_thread true;;
    *) echo "ERR|renderer tidak dikenal"; return 1;;
  esac
  setcfg RENDERER $1; echo "OK|$1"
}
rend_boot(){ v=$(getcfg RENDERER); [ -n "$v" ] && [ "$v" != default ] && rend_apply $v >/dev/null 2>&1; }
# GMS limiter: RUN_IN_BACKGROUND & WAKE_LOCK Google Play Services -> ignore. Mati = kembali ke "default" (bukan "allow", supaya setelan bawaan ROM utuh).
gms_limit(){
  GMSA=com.google.android.gms/com.google.android.gms.auth.managed.admin.DeviceAdminReceiver; GMSM=com.google.android.gms/com.google.android.gms.mdm.receivers.MdmDeviceAdminReceiver
  for op in RUN_IN_BACKGROUND RUN_ANY_IN_BACKGROUND WAKE_LOCK; do
    if [ "$1" = on ]; then cmd appops set com.google.android.gms $op ignore >/dev/null 2>&1; else cmd appops set com.google.android.gms $op default >/dev/null 2>&1; fi
  done
  # Doze GMS: keluarkan GMS dari daftar putih hemat daya sistem (sys-whitelist) + daftar putih pengguna; tanpa ini GMS kebal Doze
  if [ "$1" = on ]; then cmd deviceidle sys-whitelist -com.google.android.gms >/dev/null 2>&1; cmd deviceidle whitelist -com.google.android.gms >/dev/null 2>&1
  else cmd deviceidle sys-whitelist reset >/dev/null 2>&1; fi
  if [ "$1" = on ]; then am set-standby-bucket com.google.android.gms restricted >/dev/null 2>&1; am set-standby-bucket com.google.android.gsf restricted >/dev/null 2>&1
  else am set-standby-bucket com.google.android.gms active >/dev/null 2>&1; am set-standby-bucket com.google.android.gsf active >/dev/null 2>&1; fi
  for u in $(ls /data/user 2>/dev/null); do
    for pk in com.google.android.gms com.google.android.ims; do
      for op in BOOT_COMPLETED AUTO_START WRITE_SETTINGS; do
        if [ "$1" = on ]; then cmd appops set --user $u $pk $op ignore >/dev/null 2>&1; else cmd appops set --user $u $pk $op default >/dev/null 2>&1; fi
      done
    done
    # device admin GMS (Find My Device ikut mati saat ON; hidup lagi saat OFF)
    if [ "$1" = on ]; then pm disable --user $u $GMSA >/dev/null 2>&1; pm disable --user $u $GMSM >/dev/null 2>&1
    else pm enable --user $u $GMSA >/dev/null 2>&1; pm enable --user $u $GMSM >/dev/null 2>&1; fi
  done
}
# F2FS GC: paksa garbage collection partisi F2FS (gc_urgent) + fstrim saat layar mati, tidak sedang main game. Ditulis sendiri.
F2S=$DIR/f2fs.sleep; F2W=$DIR/f2fs.pid; F2L=$DIR/f2fs.last
f2fs_dirs(){ for d in /sys/fs/f2fs/*; do [ -w "$d/gc_urgent" ] && echo "$d"; done; }
f2fs_free(){ _t=0; for d in $(f2fs_dirs); do _f=; read -r _f 2>/dev/null < $d/free_segments; _t=$((_t + ${_f:-0})); done; echo $_t; }
f2fs_gc_run(){ # jalan maksimal ~120 dtk; berhenti dini bila free_segments sudah tidak naik
  [ -f $DIR/ingame ] && { echo "ERR|sedang main game"; return 1; }
  [ -n "$(f2fs_dirs)" ] || { echo "ERR|node F2FS tidak ada"; return 1; }
  [ -f $DIR/f2fs.run ] && kill -0 "$(cat $DIR/f2fs.run 2>/dev/null)" 2>/dev/null && { echo "ERR|GC sedang berjalan"; return 1; }
  echo $$ > $DIR/f2fs.run; b=$(f2fs_free); l=$b; n=0
  for d in $(f2fs_dirs); do _so=; read -r _so 2>/dev/null < $d/gc_urgent_sleep_time; echo "$d|$_so" >> $F2S; echo 50 > $d/gc_urgent_sleep_time 2>/dev/null; echo 1 > $d/gc_urgent 2>/dev/null; done   # tidur antar-GC 50 ms: GC lebih cepat
  i=0; while [ $i -lt 24 ]; do
    sleep 5; i=$((i+1)); c=$(f2fs_free)
    if [ "$c" -le "$l" ]; then n=$((n+1)); else n=0; fi
    l=$c; [ $n -ge 3 ] && break
    [ -f $DIR/ingame ] && break
  done
  for d in $(f2fs_dirs); do echo 0 > $d/gc_urgent 2>/dev/null; done
  [ -f $F2S ] && { while IFS='|' read -r _d _v; do [ -n "$_v" ] && echo "$_v" > $_d/gc_urgent_sleep_time 2>/dev/null; done < $F2S; rm -f $F2S; }
  sm fstrim >/dev/null 2>&1; sm idle-maint run >/dev/null 2>&1
  echo "$(date +%s)|$b|$(f2fs_free)" > $F2L; rm -f $DIR/f2fs.run; echo "OK|$b -> $(f2fs_free) segmen bebas"
}
f2fs_wd(){
  echo $$ > $F2W; off=0
  BL=; for f in /sys/class/leds/lcd-backlight/brightness /sys/class/backlight/*/brightness; do [ -r "$f" ] && { BL=$f; break; }; done
  [ -n "$BL" ] || { rm -f $F2W; return 1; }
  while :; do
    sleep 60; b=; read -r b 2>/dev/null < $BL
    if [ "${b:-1}" = 0 ]; then off=$((off+1)); else off=0; fi
    if [ $off -ge 2 ]; then
      now=$(date +%s); t=0; [ -f $F2L ] && t=$(cut -d'|' -f1 $F2L)
      h=$(getcfg F2FS_H); [ -n "$h" ] || h=6
      [ $((now - ${t:-0})) -ge $((h*3600)) ] && f2fs_gc_run >/dev/null 2>&1
    fi
  done
}
f2fs_sync(){ # on|off
  alive=0; [ -f $F2W ] && kill -0 $(cat $F2W) 2>/dev/null && alive=1
  if [ "$1" = on ] && [ $alive = 0 ]; then bg f2fs_wd
  elif [ "$1" != on ] && [ $alive = 1 ]; then kill $(cat $F2W) 2>/dev/null; rm -f $F2W; fi
}
f2fs_status(){ _l=0; _b=0; _a=0; [ -f $F2L ] && { IFS='|' read -r _l _b _a < $F2L; }; echo "F2FS|$(f2fs_dirs | wc -l)|${_l:-0}|${_b:-0}|${_a:-0}"; }
# Data Saver: batasi data latar, tapi game di Daftar Game + Comatoze + Play Services dikecualikan (daftar putih) supaya online/notifikasi tetap jalan.
DSW=$DIR/dswl
ds_uid(){ cmd package list packages -U "$1" 2>/dev/null | grep -m1 "^package:$1 " | sed 's/.*uid:\([0-9]*\).*/\1/'; }
ds_apply(){
  if [ "$1" = on ]; then
    cmd netpolicy set restrict-background true >/dev/null 2>&1
    for _p in com.comatoze com.google.android.gms $(cat $DIR/games.txt 2>/dev/null); do
      _u=$(ds_uid $_p); [ -n "$_u" ] || continue
      cmd netpolicy add restrict-background-whitelist $_u >/dev/null 2>&1; echo "$_u" >> $DSW
    done
  else
    [ -f $DSW ] && for _u in $(sort -u $DSW); do cmd netpolicy remove restrict-background-whitelist $_u >/dev/null 2>&1; done; rm -f $DSW
    cmd netpolicy set restrict-background false >/dev/null 2>&1
  fi
}
# Doze Mode: aktifkan Doze ringan+dalam dan percepat masuknya (konstanta DeviceIdleController); nilai asli disimpan & dipulihkan saat OFF.
DZC=$DIR/doze_const
doze_tune(){
  if [ "$1" = on ]; then
    [ -f $DZC ] || { _o=$(settings get global device_idle_constants 2>/dev/null); echo "${_o:-null}" > $DZC; }
    dumpsys deviceidle enable all >/dev/null 2>&1
    settings put global device_idle_constants "light_after_inactive_to=10000,light_pre_idle_to=10000,light_idle_to=60000,light_idle_factor=2.0,light_max_idle_to=900000,inactive_to=30000,sensing_to=0,locating_to=0,motion_inactive_to=0,idle_after_inactive_to=0,idle_pending_to=30000,max_idle_pending_to=60000,idle_pending_factor=2.0,idle_to=1800000,max_idle_to=21600000,idle_factor=2.0,min_time_to_alert=30000" >/dev/null 2>&1
  else
    if [ -f $DZC ]; then _o=$(cat $DZC); if [ "$_o" = null ] || [ -z "$_o" ]; then settings delete global device_idle_constants >/dev/null 2>&1; else settings put global device_idle_constants "$_o" >/dev/null 2>&1; fi; rm -f $DZC; fi
    dumpsys deviceidle disable all >/dev/null 2>&1
  fi
}
# Aggressive Doze: layar mati (backlight 0) 2x berturut-turut (10 dtk) -> deviceidle force-idle; layar hidup -> unforce. Pemantau memakai read bawaan shell (tanpa fork) di antara transisi.
ADZ=$DIR/adoze.pid
adoze_wd(){
  echo $$ > $ADZ; off=0; forced=0; BL=
  for f in /sys/class/leds/lcd-backlight/brightness /sys/class/backlight/*/brightness; do [ -r "$f" ] && { BL=$f; break; }; done
  [ -n "$BL" ] || { rm -f $ADZ; return 1; }
  while :; do
    b=; read -r b 2>/dev/null < $BL
    if [ "${b:-1}" = 0 ]; then off=$((off+1)); else off=0; fi
    if [ $off -ge 2 ] && [ $forced = 0 ]; then ram_purge light >/dev/null 2>&1; dumpsys deviceidle force-idle >/dev/null 2>&1; forced=1
    elif [ $off = 0 ] && [ $forced = 1 ]; then dumpsys deviceidle unforce >/dev/null 2>&1; forced=0; fi
    sleep 2
  done
}
adoze_sync(){ # on|off
  alive=0; [ -f $ADZ ] && kill -0 $(cat $ADZ) 2>/dev/null && alive=1
  if [ "$1" = on ] && [ $alive = 0 ]; then bg adoze_wd
  elif [ "$1" != on ] && [ $alive = 1 ]; then kill $(cat $ADZ) 2>/dev/null; rm -f $ADZ; dumpsys deviceidle unforce >/dev/null 2>&1; fi
}

# ---------- FEATURE TOGGLES ----------
# Tambah fitur baru: 1) nama di FEATS  2) case di feat()  3) default di fstate()  4) entri di FEATURES (index.html)
# ---------- BKT: porting selektif dari "Better Kernel Tweaks" v8.1.0 (@RiProG), dibuat bisa di-ON/OFF & dipulihkan ----------
# Yang SENGAJA tidak diambil karena bentrok dengan mode Performa/Eco/Thermal milik modul ini: set governor CPU, stune boost/prefer_idle,
# blok GPU (throttling/force_*/power_policy/aging_mode), pemilihan IO scheduler, panic=0, tcp_ecn & syncookies.
BK=$DIR/bkt
# bk_wr: sama seperti tb_wr, tapi dilewati bila nilai asli tidak terbaca. Pulih hanya bila nilai masih sama dengan yang kita tulis.
bk_wr(){ [ -w "$1" ] || return 0; if grep -q "^$1|" $BK.nodes 2>/dev/null; then echo "$2" > "$1" 2>/dev/null; return 0; fi; o=$(cat "$1" 2>/dev/null); [ -n "$o" ] || return 0; echo "$2" > "$1" 2>/dev/null; echo "$1|$o|$(cat "$1" 2>/dev/null)" >> $BK.nodes; }
# bk_sf: set 1 flag scheduler di debugfs (on/off); keadaan awal dicatat sekali. Dilewati bila debugfs/flag tidak ada.
SFF=/sys/kernel/debug/sched_features
bk_sf(){ [ -w "$SFF" ] || return 0; cur=" $(cat $SFF 2>/dev/null | tr '\n' ' ') "
  case "$cur" in *" $1 "*) st=on;; *" NO_$1 "*) st=off;; *) return 0;; esac
  grep -q "^$1|" $BK.sf 2>/dev/null || echo "$1|$st" >> $BK.sf
  if [ "$2" = on ]; then echo "$1" > $SFF 2>/dev/null; else echo "NO_$1" > $SFF 2>/dev/null; fi
}
bkt_on(){
  mkdir -p $DIR
  mt=0; while read -r k v _; do [ "$k" = MemTotal: ] && { mt=$v; break; }; done < /proc/meminfo
  big=0; [ "$mt" -gt 4000000 ] && big=1
  K=/proc/sys/kernel; V=/proc/sys/vm
  # scheduler CFS (hanya ada di kernel yang masih punya tunable ini; yang tidak ada dilewati)
  bk_wr $K/perf_cpu_time_max_percent 3
  bk_wr $K/sched_autogroup_enabled 1
  bk_wr $K/sched_child_runs_first 1
  bk_wr $K/sched_tunable_scaling 0
  bk_wr $K/sched_latency_ns 2000000
  bk_wr $K/sched_min_granularity_ns 75000
  bk_wr $K/sched_wakeup_granularity_ns 1000000
  bk_wr $K/sched_migration_cost_ns 5000000
  bk_wr $K/sched_nr_migrate 128
  bk_wr $K/sched_schedstats 0
  bk_wr $K/sched_rr_timeslice_ms 5
  bk_wr $K/hung_task_timeout_secs 0
  bk_wr $K/watchdog 0
  bk_wr $K/printk_devkmsg off
  bk_sf NEXT_BUDDY on; bk_sf TTWU_QUEUE on; bk_sf HRTICK off; bk_sf WAKEUP_PREEMPTION on
  # VM / memori (angka mengikuti RAM: >4 GB vs lainnya)
  bk_wr $V/dirty_expire_centisecs 2000
  bk_wr $V/dirty_writeback_centisecs 1500
  bk_wr $V/page-cluster 0
  bk_wr $V/stat_interval 10
  bk_wr $V/overcommit_ratio 80
  bk_wr $V/extra_free_kbytes 20480
  bk_wr $V/watermark_scale_factor 30   # kswapd bangun lebih awal: kurangi direct reclaim (hentakan) saat RAM ketat
  bk_wr $V/compaction_proactiveness 0
  bk_wr $V/oom_dump_tasks 0
  if [ "$big" = 1 ]; then bk_wr $V/dirty_background_ratio 5; bk_wr $V/dirty_ratio 15; bk_wr $V/vfs_cache_pressure 40
  else bk_wr $V/dirty_background_ratio 10; bk_wr $V/dirty_ratio 25; bk_wr $V/vfs_cache_pressure 60; fi
  # jaringan: BBR bila kernel menyediakan, TCP fast open
  case " $(rd /proc/sys/net/ipv4/tcp_available_congestion_control) " in *" bbr "*) bk_wr /proc/sys/net/ipv4/tcp_congestion_control bbr;; esac
  bk_wr /proc/sys/net/ipv4/tcp_fastopen 3
  bk_wr /proc/sys/net/ipv4/tcp_slow_start_after_idle 0
  bk_wr /proc/sys/net/ipv4/tcp_low_latency 1
  bk_wr /proc/sys/net/ipv4/tcp_no_metrics_save 1
  bk_wr /proc/sys/net/ipv4/tcp_timestamps 0
  bk_wr /proc/sys/net/ipv4/tcp_mtu_probing 1
}
bkt_off(){
  if [ -f $BK.nodes ]; then
    while IFS='|' read -r p v s; do
      [ -n "$v" ] && [ -w "$p" ] || continue
      case "$p" in /proc/*) case "$v" in 0|1) ;; *) continue;; esac;; esac   # node /proc: pulihkan hanya bila nilai asli polos 0/1 (format lain bisa salah tulis)
      if [ -z "$s" ] || [ "$(cat "$p" 2>/dev/null)" = "$s" ]; then echo "$v" > "$p" 2>/dev/null; fi
    done < $BK.nodes
    rm -f $BK.nodes
  fi
  if [ -f $BK.sf ] && [ -w "$SFF" ]; then
    while IFS='|' read -r n st; do
      if [ "$st" = on ]; then echo "$n" > $SFF 2>/dev/null; else echo "NO_$n" > $SFF 2>/dev/null; fi
    done < $BK.sf
  fi
  rm -f $BK.sf
}
# ---------- DEXOPT: kompilasi ulang app (speed-profile / speed) di latar, dengan progres & tombol stop ----------
# apps  = semua app pihak ketiga, filter speed-profile (terarah profil pemakaian: buka app & scroll lebih mulus, ruang kecil)
# games = game di daftar Game, filter speed (AOT penuh: loading & jank awal lebih sedikit, ruang lebih besar)
# reset = kembalikan app pihak ketiga ke kompilasi bawaan (cmd package compile --reset)
DXS=$DIR/dexopt
bgx(){ if command -v setsid >/dev/null 2>&1; then setsid sh $SELF "$@" </dev/null >/dev/null 2>&1 & else nohup sh $SELF "$@" </dev/null >/dev/null 2>&1 & fi; }
dexopt_start(){
  mkdir -p $DIR
  [ -f $DXS.pid ] && kill -0 $(cat $DXS.pid) 2>/dev/null && { echo "ERR|Optimasi sedang berjalan"; return; }
  case $1 in apps|games|reset) ;; *) echo "ERR|mode tidak dikenal"; return;; esac
  st=$(rd $BAT/capacity); bs=$(rd $BAT/status)
  case $bs in Charging|Full) ;; *) case $st in ''|*[!0-9]*) ;; *) [ "$st" -lt 30 ] && { echo "ERR|Baterai di bawah 30% - colok charger dulu"; return; };; esac;; esac
  [ "$1" = games ] && [ ! -s $DIR/games.txt ] && { echo "ERR|Daftar game masih kosong"; return; }
  rm -f $DXS.stop; echo "running|$1|0|0|" > $DXS.state
  bgx dexopt_run $1; echo OK
}
dexopt_run(){
  echo $$ > $DXS.pid; renice -n 10 -p $$ >/dev/null 2>&1
  case $1 in
    games) list=$(cat $DIR/games.txt 2>/dev/null); flt=speed;;
    reset) list=$(cmd package list packages -3 2>/dev/null | sed 's/^package://'); flt=reset;;
    *) list=$(cmd package list packages -3 2>/dev/null | sed 's/^package://'); flt=speed;;
  esac
  total=$(echo "$list" | grep -c .); n=0
  echo "running|$1|0|$total|" > $DXS.state
  for p in $list; do
    [ -f $DXS.stop ] && break
    echo "running|$1|$n|$total|$p" > $DXS.state
    if [ "$flt" = reset ]; then cmd package compile --reset $p >/dev/null 2>&1; else cmd package compile -m $flt $p >/dev/null 2>&1; fi
    n=$((n+1))
  done
  if [ -f $DXS.stop ]; then s=stopped; else s=done; fi
  echo "$s|$1|$n|$total|" > $DXS.state; rm -f $DXS.pid $DXS.stop
}
dexopt_stop(){ [ -f $DXS.pid ] && kill -0 $(cat $DXS.pid) 2>/dev/null && touch $DXS.stop; echo OK; }
dexopt_status(){ # DEXOPT|status|mode|selesai|total|paket
  st=$(cat $DXS.state 2>/dev/null); [ -n "$st" ] || st="idle||0|0|"
  case $st in running*) [ -f $DXS.pid ] && kill -0 $(cat $DXS.pid) 2>/dev/null || st="stopped|${st#running|}";; esac
  echo "DEXOPT|$st"
}

# ---------- ZRAM: preset ukuran/algoritma/swappiness, bisa dikembalikan ke bawaan ROM ----------
# Penerapan butuh swapoff -> reset -> disksize -> mkswap -> swapon, jadi dijalankan di latar. Dijaga: RAM kosong harus cukup untuk
# menampung isi zram saat swapoff, bila gagal ukuran lama dipasang kembali, dan bila proses terputus (reboot) ZRAM otomatis dilepas dari config.
ZD=/sys/block/zram0; ZR=$DIR/zram; SWAPS=/proc/swaps; MEMI=/proc/meminfo
zram_ok(){ [ -d $ZD ] && [ -e /dev/block/zram0 ] && [ -w $ZD/disksize ] && command -v mkswap >/dev/null 2>&1 && command -v swapon >/dev/null 2>&1 && command -v swapoff >/dev/null 2>&1; }
zram_on(){ grep -q zram0 $SWAPS 2>/dev/null; }
zram_algo(){ rd $ZD/comp_algorithm | sed -n 's/.*\[\(.*\)\].*/\1/p'; }
zram_algos(){ rd $ZD/comp_algorithm | tr -d '[]'; }
meminfo_kb(){ while read -r k v _; do [ "$k" = "$1:" ] && { echo $v; return; }; done < $MEMI; echo 0; }
zram_cycle(){ # <bytes|0> <algo|-> [mem_limit bytes]
  _b=$1; _a=$2; _l=$3
  if zram_on; then
    used=$(awk '{print $1}' $ZD/mm_stat 2>/dev/null); [ -n "$used" ] || used=$(rd $ZD/orig_data_size); used=${used:-0}
    av=$(meminfo_kb MemAvailable)
    awk -v a=$av -v u=$used 'BEGIN{exit !(a*1024 > u + 419430400)}' || { echo "ERR|RAM kosong kurang untuk mengganti ZRAM - tutup beberapa app lalu coba lagi"; return 1; }
    swapoff /dev/block/zram0 >/dev/null 2>&1
    zram_on && { echo "ERR|swapoff gagal (swap masih terpakai)"; return 1; }
  fi
  echo 1 > $ZD/reset 2>/dev/null
  [ -w $ZD/mem_limit ] && echo 0 > $ZD/mem_limit 2>/dev/null   # bersihkan batas lama (reset bawaan/matikan tidak boleh mewarisi batas preset ukuran)
  [ -n "$_a" ] && [ "$_a" != - ] && echo "$_a" > $ZD/comp_algorithm 2>/dev/null
  if [ "$_b" != 0 ]; then
    echo "$_b" > $ZD/disksize 2>/dev/null
    _d=$(rd $ZD/disksize); awk -v d="${_d:-0}" 'BEGIN{exit !(d>0)}' || { echo "ERR|kernel menolak ukuran ZRAM ini"; return 1; }
    # batas RAM nyata yang boleh dipakai data terkompresi: bila penuh, swap-out ditolak (app ditutup) -- bukan HP macet kehabisan RAM
    [ -n "$_l" ] && [ -w $ZD/mem_limit ] && echo "$_l" > $ZD/mem_limit 2>/dev/null
    mkswap /dev/block/zram0 >/dev/null 2>&1 && swapon /dev/block/zram0 >/dev/null 2>&1
    zram_on || { echo "ERR|swapon gagal"; return 1; }
  fi
  echo OK
}
zram_apply(){ # preset: fast | multi | off | reset | gb1..gb6 (ukuran tetap 1-6 GB, lz4, swappiness 100)
  zram_ok || { echo "ERR|ZRAM tidak didukung kernel/ROM ini"; return 1; }
  mt=$(meminfo_kb MemTotal)
  [ -f $ZR.orig ] || echo "$(rd $ZD/disksize)|$(zram_algo)|$(rd /proc/sys/vm/swappiness)|$(zram_on && echo 1 || echo 0)" > $ZR.orig
  IFS='|' read -r obytes oalgo oswp on0 < $ZR.orig
  case $1 in
    fast)  pct=100; prefer="lz4 lzo-rle lzo"; swp=60;;
    multi) pct=150; prefer="zstd lz4 lzo-rle lzo"; swp=100;;
    off)   [ "$mt" -ge 7500000 ] || { echo "ERR|ZRAM hanya boleh dimatikan di RAM 8 GB ke atas"; return 1; }; pct=0; prefer=""; swp=;;
    gb[1-6]) pct=; prefer="lz4 lzo-rle lzo"; swp=100;;
    reset) pct=; swp=$oswp;;
    *) echo "ERR|preset tidak dikenal"; return 1;;
  esac
  lim=""
  if [ "$1" = reset ]; then
    if [ "$on0" = 1 ]; then bytes=$obytes; else bytes=0; fi; algo=$oalgo
  else
    case $1 in
      gb[1-6]) bytes=$(awk -v n=${1#gb} 'BEGIN{printf "%.0f", n*1073741824}')
        awk -v b=$bytes -v k=$mt 'BEGIN{exit !(b > k*1024*2)}' && { echo "ERR|Ukuran ${1#gb} GB melebihi 2x RAM perangkat ini, pilih yang lebih kecil"; return 1; };;
      *) bytes=$(awk -v k=$mt -v p=$pct 'BEGIN{printf "%.0f", k*1024*p/100}');;
    esac
    algo=$(pick "$(zram_algos)" $prefer); [ -n "$algo" ] || algo=-
    [ "$bytes" != 0 ] && lim=$(awk -v k=$mt 'BEGIN{printf "%.0f", k*1024*50/100}')   # data terkompresi maksimal 50% RAM
  fi
  cur=$(rd $ZD/disksize)
  if zram_on && [ "$bytes" != 0 ] && [ "$cur" = "$bytes" ] && { [ "$algo" = - ] || [ "$(zram_algo)" = "$algo" ]; }; then r=OK   # sudah persis begini
  elif ! zram_on && [ "$bytes" = 0 ]; then r=OK
  else
    r=$(zram_cycle $bytes $algo $lim)
    if [ "$r" != OK ] && [ "$on0" = 1 ] && ! zram_on; then zram_cycle $obytes $oalgo >/dev/null; fi   # gagal setelah swap terlepas: pasang kembali yang lama
  fi
  [ "$r" = OK ] || { echo "$r"; return 1; }
  [ -n "$swp" ] && echo "$swp" > /proc/sys/vm/swappiness 2>/dev/null
  [ "$1" = reset ] && rm -f $ZR.orig
  echo OK
}
zram_start(){
  zram_ok || { echo "ERR|ZRAM tidak didukung kernel/ROM ini"; return; }
  case $1 in fast|multi|off|reset|gb[1-6]) ;; *) echo "ERR|preset tidak dikenal"; return;; esac
  [ -f $ZR.pid ] && kill -0 $(cat $ZR.pid) 2>/dev/null && { echo "ERR|Sedang menerapkan, tunggu selesai"; return; }
  mkdir -p $DIR; echo "applying|$1" > $ZR.state
  bgx zram_run $1; echo OK
}
zram_run(){
  echo $$ > $ZR.pid; touch $ZR.applying
  r=$(zram_apply $1)
  rm -f $ZR.applying
  if [ "$r" = OK ]; then echo "done|$1" > $ZR.state; if [ "$1" = reset ]; then setcfg ZRAM ""; else setcfg ZRAM $1; fi
  else echo "error|$1|${r#ERR|}" > $ZR.state; fi
  rm -f $ZR.pid
}
zram_status(){ # ZRAM|ok|RAM MB|zram MB|algo|algo tersedia|swappiness|preset|terpakai MB|state|pesan
  zram_ok || { echo "ZRAM|no"; return; }
  mt=$(meminfo_kb MemTotal); dk=$(rd $ZD/disksize); dk=${dk:-0}
  if zram_on; then disk=$(awk -v b=$dk 'BEGIN{printf "%d", b/1048576}'); else disk=0; fi
  used=$(awk '{printf "%d", $3/1048576}' $ZD/mm_stat 2>/dev/null); used=${used:-0}
  st=$(cat $ZR.state 2>/dev/null); sw=${st%%|*}; msg=""
  case $sw in
    applying) [ -f $ZR.pid ] && kill -0 $(cat $ZR.pid) 2>/dev/null || { sw=error; msg="proses terhenti"; };;
    error) msg=${st##*|};;
  esac
  echo "ZRAM|yes|$((mt/1024))|$disk|$(zram_algo)|$(zram_algos)|$(rd /proc/sys/vm/swappiness)|$(getcfg ZRAM)|$used|$sw|$msg"
}
# ---------- SMOOTH: cegah Android 12+ membunuh proses anak "phantom" (sumber app/game tiba-tiba tertutup & tersendat) ----------
# Memakai device_config max_phantom_processes + matikan monitor-nya; nilai asli dicatat dan dipulihkan saat dimatikan. Android <12: tidak melakukan apa-apa.
SMD=$DIR/smooth
smooth_on(){
  mkdir -p $DIR
  [ "$(getprop ro.build.version.sdk)" -ge 31 ] 2>/dev/null || return 0
  grep -q '^dc|' $SMD 2>/dev/null || echo "dc|$(device_config get activity_manager max_phantom_processes 2>/dev/null)" >> $SMD
  grep -q '^st|' $SMD 2>/dev/null || echo "st|$(sget global settings_enable_monitor_phantom_procs)" >> $SMD
  grep -q '^fz|' $SMD 2>/dev/null || echo "fz|$(sget_r global cached_apps_freezer)" >> $SMD
  grep -q '^nf|' $SMD 2>/dev/null || echo "nf|$(device_config get activity_manager_native_boot use_freezer 2>/dev/null)" >> $SMD
  grep -q '^mc|' $SMD 2>/dev/null || echo "mc|$(device_config get activity_manager max_cached_processes 2>/dev/null)" >> $SMD
  device_config put activity_manager max_phantom_processes 2147483647 >/dev/null 2>&1
  sput global settings_enable_monitor_phantom_procs false
  # brutal: matikan pembekuan app cache (freezer) + longgarkan batas proses cache supaya game/app latar tidak dibekukan atau dimatikan
  sput global cached_apps_freezer disabled
  device_config put activity_manager_native_boot use_freezer false >/dev/null 2>&1
  device_config put activity_manager max_cached_processes 64 >/dev/null 2>&1
}
smooth_off(){
  [ -f $SMD ] || return 0
  while IFS='|' read -r k v; do
    case $k in
      dc) if [ -z "$v" ] || [ "$v" = null ]; then device_config delete activity_manager max_phantom_processes >/dev/null 2>&1; else device_config put activity_manager max_phantom_processes "$v" >/dev/null 2>&1; fi;;
      st) if [ -z "$v" ] || [ "$v" = null ]; then sdel global settings_enable_monitor_phantom_procs; else sput global settings_enable_monitor_phantom_procs "$v"; fi;;
      fz) if [ -z "$v" ] || [ "$v" = null ]; then sdel global cached_apps_freezer; else sput global cached_apps_freezer "$v"; fi;;
      nf) if [ -z "$v" ] || [ "$v" = null ]; then device_config delete activity_manager_native_boot use_freezer >/dev/null 2>&1; else device_config put activity_manager_native_boot use_freezer "$v" >/dev/null 2>&1; fi;;
      mc) if [ -z "$v" ] || [ "$v" = null ]; then device_config delete activity_manager max_cached_processes >/dev/null 2>&1; else device_config put activity_manager max_cached_processes "$v" >/dev/null 2>&1; fi;;
    esac
  done < $SMD
  rm -f $SMD
}
wl_apply(){ # on|off: WiFi tanpa scan latar & tanpa tidur (nilai asli disimpan lalu dipulihkan)
  if [ "$1" = on ]; then
    [ "$(getcfg WLO_set)" = 1 ] || { setcfg WLO_ss "$(sget_r global wifi_scan_always_enabled)"; setcfg WLO_sp "$(sget_r global wifi_sleep_policy)"; setcfg WLO_set 1; }
    sput global wifi_scan_always_enabled 0
    sput global wifi_sleep_policy 2
    cmd wifi set-scan-always-available disabled >/dev/null 2>&1
  else
    [ "$(getcfg WLO_set)" = 1 ] || return 0
    v=$(getcfg WLO_ss); if [ -z "$v" ] || [ "$v" = null ]; then sdel global wifi_scan_always_enabled; else sput global wifi_scan_always_enabled "$v"; fi
    v=$(getcfg WLO_sp); if [ -z "$v" ] || [ "$v" = null ]; then sdel global wifi_sleep_policy; else sput global wifi_sleep_policy "$v"; fi
    setcfg WLO_set 0
  fi
}
FEATS="framepace f2fsgc gamefps gamethermal nothermal doze datasaver wifilatency bootapply dnd fastcharge autocut bypass gamebypass preload gamednd gameprofile gameclean touchboost perfx ecox lessdbg fpsgooff gmslimit aggrdoze hzlock120 hzforce bkt smooth"
feat(){ # name on|off
  case $1 in
    nothermal) if [ "$2" = on ]; then thermal off; else thermal on; fi; return;;
    touchboost) if [ "$2" = on ]; then touch_on; else touch_off; fi;;
    bkt) if [ "$2" = on ]; then bkt_on; else bkt_off; fi;;
    smooth) if [ "$2" = on ]; then smooth_on; else smooth_off; fi;;
    f2fsgc) setcfg "F_$1" $2; f2fs_sync $2; return;;
    gmslimit) setcfg "F_$1" $2; gms_limit $2; return;;
    aggrdoze) setcfg "F_$1" $2; adoze_sync $2; return;;
    lessdbg) setcfg "F_$1" $2; if [ "$2" = on ]; then dbg_off; else dbg_on; fi; return;;
    perfx) setcfg "F_$1" $2
      if [ "$2" = on ]; then   # memilih tweak Performa -> tweak Eco otomatis dimatikan (hanya boleh salah satu)
        if [ "$(getcfg F_ecox)" != off ]; then setcfg F_ecox off; [ "$(curmode)" = eco ] && { eco_x_off; cpu_mode eco; }; fi
        [ "$(curmode)" = perf ] && perf_x
      else [ "$(curmode)" = perf ] && perf_x_off; fi
      return;;
    ecox) setcfg "F_$1" $2
      if [ "$2" = on ]; then   # memilih tweak Eco -> tweak Performa otomatis dimatikan (hanya boleh salah satu)
        if [ "$(getcfg F_perfx)" != off ]; then setcfg F_perfx off; [ "$(curmode)" = perf ] && perf_x_off; fi
        [ "$(curmode)" = eco ] && eco_x
      else [ "$(curmode)" = eco ] && { eco_x_off; cpu_mode eco; }; fi
      [ "$(curmode)" = eco ] && { [ -f $CPUW.pid ] && kill $(cat $CPUW.pid) 2>/dev/null; rm -f $CPUW.pid; cpu_wd_sync; }   # atap watchdog dihitung ulang
      return;;
    gamefps) if [ "$2" = on ]; then r=$(gfps_on); case $r in ERR*) echo "$r"; return;; esac; else gfps_off >/dev/null; fi;;
    fpsgooff) if fpsgo_alt; then   # tanpa node FPSGO: pakai mode pengganti (aktif saat game di depan)
        setcfg "F_$1" $2; if [ "$2" = on ]; then [ -f $DIR/ingame ] && fp_on; else [ "$(getcfg F_framepace)" = on ] || fp_off; fi; game_sync
        [ "$2" = on ] && echo "OK|FPSGO tidak ada di kernel ini, mode pengganti aktif saat game"; return
      fi
      setcfg "F_$1" $2
      if fpsgo_set $2; then rm -f $DIR/fpsgo_ro
      elif [ "$2" = on ]; then touch $DIR/fpsgo_ro; [ -f $DIR/ingame ] && fp_on; echo "OK|FPSGO ditolak kernel, mode pengganti aktif saat game"; game_sync
      else echo "ERR|FPSGO tidak bisa diubah: $(echo "${FPSGO_ERR:-nilai ditimpa lagi oleh sistem}" | tr -d '|' | tr '\n' ' ' | cut -c1-90) [nilai sekarang: $(rd "$FPSGO_N")]"; fi
      return;;
    dnd) if [ "$2" = on ]; then cmd notification set_dnd priority; else cmd notification set_dnd off; fi; return;;
    gamebypass) setcfg "F_$1" $2; chg_sync; game_sync; return;;
    gamethermal) setcfg "F_$1" $2; if [ "$2" = on ]; then [ -f $DIR/ingame ] && gth_on; else gth_off; fi; game_sync; return;;
    gameprofile) setcfg "F_$1" $2; [ "$2" = on ] || gp_leave; game_sync; return;;
    framepace) setcfg "F_$1" $2; if [ "$2" = on ]; then [ -f $DIR/ingame ] && fp_on; else fp_off; fp_want && [ -f $DIR/ingame ] && fp_on; fi; game_sync; return;;
    gameclean) setcfg "F_$1" $2; game_sync; return;;
    wifilatency) if [ "$2" = on ]; then wm=enabled; else wm=disabled; fi; cmd wifi force-hi-perf-mode $wm >/dev/null 2>&1; cmd wifi force-low-latency-mode $wm >/dev/null 2>&1; wl_apply $2;;
    fastcharge|autocut|bypass) setcfg "F_$1" $2; chg_sync; return;;
    preload|gamednd) setcfg "F_$1" $2; game_sync; return;;
    doze) setcfg "F_$1" $2; doze_tune $2; return;;
    datasaver) setcfg "F_$1" $2; ds_apply $2; return;;
    bootapply) [ "$2" = on ] && rm -f $DIR/skip || touch $DIR/skip; return;;
    # Khusus ROM yang refresh rate-nya nggak mau nempel ke Hz tertinggi (mis. XOS) walau peak_refresh_rate sudah
    # benar: transaksi binder SurfaceFlinger 1035 memaksa (i32 0) / melepas (i32 1) logika auto-switch bawaan ROM.
    # CATATAN: efeknya SANGAT lengket di sejumlah unit -- begitu di-ON, mode lain (Balance/Eco) bisa ikut
    # kekunci ke Hz tertinggi sampai di-OFF lagi (atau reboot). Makanya ini fitur terpisah yang harus dinyalakan
    # manual, BUKAN otomatis nyala tiap pilih mode Performa, supaya nggak diam-diam ngerusak mode lain.
    # Kunci Hz lewat SurfaceFlinger + user_refresh_rate/miui_refresh_rate, meniru aplikasi Refresh Rate Tool (lihat blok "KUNCI Hz VIA SURFACEFLINGER").
    # Hz yang dikunci = Hz mode sekarang (RHZ); tanpa RHZ dipakai Hz tertinggi. Mati = kunci SurfaceFlinger dilepas.
    hzforce) t=$(getcfg RHZ); [ -n "$t" ] || t=$(rlist | tail -1)
      if [ "$2" = on ]; then
        [ -n "$(sf_idx $t)" ] || { echo "ERR|daftar mode layar tidak terbaca atau $t Hz tidak ada di sana (lihat: probe)"; return; }
        setcfg "F_$1" on; refresh_apply "$t"
        echo "OK|mode SurfaceFlinger $(sf_idx $t) = $t Hz terkunci"
      else
        setcfg "F_$1" off; sf_release; refresh_apply "$t"   # opt-out: Hz kembali diatur ROM (hanya min/peak_refresh_rate)
      fi
      return;;
    hzlock120) if [ "$2" = on ]; then
        mx=$(rlist | tail -1)
        sput system min_refresh_rate $mx.0; sput system peak_refresh_rate $mx.0
        sf_force $mx   # id mode dihitung dari daftar mode layar (dulu i32 0 mentah: salah id di HP yang mode pertamanya bukan Hz tertinggi)
      else
        t=$(getcfg RHZ); [ -n "$t" ] && refresh_apply "$t"   # kunci SF mengikuti Hz mode sekarang (dulu i32 1 mentah)
      fi
      setcfg "F_$1" $2; return;;
    *) return;;
  esac
  setcfg "F_$1" $2
}
fstate(){
  case $1 in
    nothermal) [ "$(getcfg THERMAL)" = off ] && echo on || echo off;;
    fpsgooff) fpsgo_alt && { v=$(getcfg F_fpsgooff); echo ${v:-off}; return; }; v=$(rd "$FPSGO_N"); [ "$v" = 0 ] && echo on || echo off;;
    gamefps) [ "$(getprop debug.graphics.game_default_frame_rate.disabled)" = true ] && echo on || echo off;;
    dnd) case "$(sget global zen_mode)" in 0|null|"") echo off;; *) echo on;; esac;;
    bootapply) [ -f $DIR/skip ] && echo off || echo on;;
    doze) v=$(getcfg F_doze); echo ${v:-on};;
    hzforce) hz_lock_on;;
    perfx) v=$(getcfg F_perfx); [ -z "$v" ] && { [ "$(curmode)" = perf ] && v=on || v=off; }; echo $v;;
    ecox) v=$(getcfg F_ecox); [ -z "$v" ] && { [ "$(curmode)" = eco ] && v=on || v=off; }; echo $v;;
    *) v=$(getcfg F_$1); echo ${v:-off};;
  esac
}

# ---------- DEVICE INFO / PROBE ----------
soc(){ s=$(getprop ro.soc.model); [ -z "$s" ] && s=$(getprop ro.board.platform); [ -z "$s" ] && s=$(getprop ro.hardware); echo $s; }
gpu_type(){
  if [ -d /sys/class/kgsl/kgsl-3d0 ]; then echo adreno
  elif [ -n "$GPU" ]; then echo devfreq
  elif [ -f $GP/gpufreq_opp_freq ]; then echo mtk-gpufreq
  else echo none; fi
}
caps(){
  [ -d $CPU ] && c=yes || c=no; echo "CAP|cpufreq|$c"
  [ "$(gpu_type)" != none ] && c=yes || c=no; echo "CAP|gpu|$c"
  ls /sys/class/thermal/thermal_zone*/mode >/dev/null 2>&1 && c=yes || c=no; echo "CAP|thermal|$c"
}
probe(){
  OUT=$DIR/probe.txt
  {
  echo "== DEVICE =="
  for k in ro.product.brand ro.product.model ro.product.device ro.hardware ro.board.platform ro.soc.manufacturer ro.soc.model ro.build.version.release ro.build.version.sdk ro.build.fingerprint; do echo "$k=$(getprop $k)"; done
  echo "kernel=$(uname -r)"
  echo "== CPU =="
  for p in $CPU/policy*; do [ -d $p ] || continue
    echo "$(basename $p) cpus=$(rd $p/related_cpus) gov=$(rd $p/scaling_governor)"
    echo "  governors: $(rd $p/scaling_available_governors)"
    echo "  freqs: $(rd $p/scaling_available_frequencies)"
  done
  echo "== GPU =="
  echo "type=$(gpu_type) path=$GPU"
  [ -n "$GPU" ] && { echo "governors: $(rd $GPU/available_governors)"; echo "freqs: $(rd $GPU/available_frequencies)"; }
  echo "devfreq: $(ls /sys/class/devfreq 2>/dev/null | tr '\n' ' ')"
  echo "kgsl: $(ls /sys/class/kgsl 2>/dev/null | tr '\n' ' ')"
  echo "proc gpufreq: $(ls /proc/gpufreq 2>/dev/null | tr '\n' ' ')"
  echo "fpsgo_enable node: ${FPSGO_N:-tidak ada} = $(rd "$FPSGO_N" 2>/dev/null) (dukung: $(fpsgo_supported)) | isi /sys/kernel/fpsgo: $(ls /sys/kernel/fpsgo 2>&1 | tr '\n' ' ' | cut -c1-120)"
  echo "proc gpufreqv2: $(ls /proc/gpufreqv2 2>/dev/null | tr '\n' ' ')"
  echo "== THERMAL =="
  echo "zones: $(ls -d /sys/class/thermal/thermal_zone* 2>/dev/null | wc -l)"
  getprop | grep 'init.svc.*thermal'
  echo "== DISPLAY =="
  echo "peak_refresh_rate=$(sget system peak_refresh_rate) min=$(sget system min_refresh_rate)"
  echo "display modes: $(dumpsys display 2>/dev/null | grep -o 'width=[0-9]*, height=[0-9]*, fps=[0-9.]*' | sort -u | tr '\n' ';')"
  echo "user preferred: $(cmd display get-user-preferred-display-mode 2>&1 | head -2 | tr '\n' ' ')"
  echo "romkeys (rlearn): $(tr '\n' ';' < $RK 2>/dev/null)"
  echo "hzforce: kunci_hz=$(hz_lock_on) F_hzforce=$(getcfg F_hzforce) lebar_layar=$(cat $DIR/c.sfw 2>/dev/null) keys=$(cat $DIR/c.hzk 2>/dev/null) | id mode SurfaceFlinger -> Hz: $(sf_order | awk '{printf "%d=%s ", NR-1, $1}')"
  echo "refresh keys: $(content query --uri content://settings/system 2>/dev/null | grep -io 'name=[a-z_]*refresh[a-z_]*, value=[^,]*' | tr '\n' ';')"
  echo "== POWER SUPPLY =="
  ls /sys/class/power_supply 2>/dev/null | tr '\n' ' '; echo
  echo "== CHARGING =="
  echo "metode terpilih: $(cat $DIR/chgm 2>/dev/null | tr '\n' ' ') [$(cat $DIR/chgq 2>/dev/null)] | held=$(cat $DIR/chgheld 2>/dev/null) | gagal-sejak=$(cat $DIR/chgfail 2>/dev/null)"
  echo "log deteksi:"; cat $DIR/chglog 2>/dev/null
  for d in $PS/*; do echo "[$(basename $d)] type=$(rd $d/type) status=$(rd $d/status) online=$(rd $d/online) current_now=$(rd $d/current_now)"; echo "   atribut: $(ls $d 2>/dev/null | tr '\n' ' ')"; done
  echo "mtk_battery_cmd: $(ls /proc/mtk_battery_cmd 2>/dev/null | tr '\n' ' ')"
  echo "ls /sys/devices/platform/charger: $(ls /sys/devices/platform/charger 2>/dev/null | tr '\n' ' ')"
  echo "tran-auto-test:"; for f in stop_chg chg_status chg_type fix_chg_type chg_speed game_mode ibat ibus ilmt mivr iterm vbus cv cc1_status cc2_status; do [ -e $PS/tran-auto-test/$f ] && echo "  $f=$(rd $PS/tran-auto-test/$f)"; done
  echo "mtk_battery_cmd values:"; for f in en_power_path en_safety_timer set_cv current_cmd; do [ -r /proc/mtk_battery_cmd/$f ] && echo "  $f=$(rd /proc/mtk_battery_cmd/$f)"; done
  for d in mtk-mst-div-chg mtk-slv-div-chg mtk-master-charger mtk-slave-charger charger; do echo "  [$d] input_current_limit=$(rd $PS/$d/input_current_limit) constant_charge_current_max=$(rd $PS/$d/constant_charge_current_max) online=$(rd $PS/$d/online)"; done
  echo "kandidat yang ada di perangkat:"
  chg_cands | awk '!s[$0]++' | while IFS='|' read -r a b c; do [ -e "$a" ] && echo "  $a = $(rd $a) (stop=$b)"; done
  echo "== IO / MEM =="
  for b in /sys/block/sda /sys/block/mmcblk0; do [ -f $b/queue/scheduler ] && echo "$(basename $b): $(cat $b/queue/scheduler)"; done
  echo "zram: $(rd /sys/block/zram0/disksize) swappiness=$(rd /proc/sys/vm/swappiness)"
  } > $OUT 2>&1
  cp $OUT /sdcard/UltraPower-probe.txt 2>/dev/null
  cat $OUT
}

# ---------- CHARGING (deteksi node otomatis, diverifikasi lewat status baterai) ----------
PS=/sys/class/power_supply
BAT=$PS/battery
bg(){ if command -v setsid >/dev/null 2>&1; then setsid sh $SELF $1 </dev/null >/dev/null 2>&1 & else nohup sh $SELF $1 </dev/null >/dev/null 2>&1 & fi; }
plugged(){ for n in usb ac wireless; do [ "$(rd $PS/$n/online)" = 1 ] && return 0; done; return 1; }
# Metode bypass (prompt pengguna): nol-kan node limit arus/tegangan pada perangkat power_supply ber-atribut "health".
# Nilai asli disimpan dulu lalu dipulihkan; node tanpa nilai asli dikembalikan ke 1000000000.
chg_dirs(){ [ -f $DIR/chgd ] || find /sys/devices -name health -exec dirname {} + 2>/dev/null > $DIR/chgd; }   # cache direktori power_supply ber-atribut "health"
chg_scan(){
  chg_dirs; b=$(cat $DIR/chgd 2>/dev/null); : > $DIR/chgn
  [ -n "$b" ] && find $b -name input_voltage_limit -o -name input_current_limit -o -name voltage_max -o -name current_max -o -name constant_charge_voltage -o -name constant_charge_current 2>/dev/null > $DIR/chgn
}
chg_ready(){
  [ -s $DIR/chgn ] && return 0; [ -f $DIR/nonodes ] && return 1
  chg_scan; [ -s $DIR/chgn ] && return 0; touch $DIR/nonodes; return 1
}
chg_set(){ # stop|res
  chg_ready || return 1
  if [ "$1" = stop ]; then
    if [ ! -f $DIR/chgsave ]; then
      : > $DIR/chgsave
      while read n; do v=$(rd $n); [ -n "$v" ] && [ "$v" != 0 ] && echo "$n $v" >> $DIR/chgsave; done < $DIR/chgn
    fi
    while read n; do w 0 $n; done < $DIR/chgn
  else
    [ -f $DIR/chgsave ] && while read n v; do w $v $n; done < $DIR/chgsave
    while read n; do grep -q "^$n " $DIR/chgsave 2>/dev/null || w 1000000000 $n; done < $DIR/chgn
    rm -f $DIR/chgsave
  fi
}
# Mesin charging v3: coba beberapa metode, ukur hasilnya lewat status & arus baterai, dan TUMPUK metode yang sebagian berhasil
# (perangkat dual-charger: charger utama + divider/charge-pump perlu dimatikan bersamaan).
# $DIR/chgm berisi satu baris per metode: node|nilai_stop|nilai_asli.  $DIR/chgq = full | partial|awal_mA|akhir_mA.
chg_isch(){ [ "$(rd $BAT/status)" = Charging ]; }
chg_cur(){ v=$(rd $BAT/current_now); case "$v" in ''|*[!0-9-]*) v=0;; esac; echo $v; }
chg_apply(){ [ -e "$1" ] && { chmod 644 "$1" 2>/dev/null; echo "$2" > "$1" 2>/dev/null; }; }
chg_cands(){ # node|nilai_stop|nilai_resume   (urutan = prioritas)
  for d in $PS/battery $PS/usb $PS/main $PS/mtk-master-charger $PS/charger $PS/bms $PS/ac; do
    echo "$d/input_suspend|1|0"; echo "$d/charging_enabled|0|1"; echo "$d/battery_charging_enabled|0|1"
    echo "$d/charge_enabled|0|1"; echo "$d/charge_disable|1|0"; echo "$d/op_disable_charge|1|0"
    echo "$d/mmi_charging_enable|0|1"; echo "$d/batt_slate_mode|1|0"
  done
  echo "/sys/devices/platform/charger/tran_aichg_disable_charger|1|0"
  echo "$PS/tran-auto-test/stop_chg|1|0"
  echo "/sys/class/qcom-battery/input_suspend|1|0"
  echo "/proc/mtk_battery_cmd/current_cmd|0 1|0 0"
  # penemuan otomatis node vendor (nama mengandung disable_charg / charging_enable / input_suspend / bypass, di jalur charger/baterai)
  find /sys/devices/platform -maxdepth 4 -type f \( -name '*disable_charg*' -o -name '*charging_enable*' -o -name '*chg_enable*' -o -name '*charge_enable*' -o -name '*input_suspend*' -o -name '*bypass*' \) 2>/dev/null \
  | grep -i 'charg\|batt\|chg\|power\|usb' | while IFS= read -r f; do
    case "${f##*/}" in *disable*|*suspend*|*bypass*) echo "$f|1|0";; *) echo "$f|0|1";; esac
  done
  # limit arus tiap charger (utama + divider/charge-pump): nol-kan
  for d in $PS/mtk-mst-div-chg $PS/mtk-slv-div-chg $PS/mtk-master-charger $PS/mtk-slave-charger $PS/charger; do
    echo "$d/input_current_limit|0|0"; echo "$d/constant_charge_current_max|0|0"; echo "$d/constant_charge_current|0|0"
  done
  echo "/proc/mtk_battery_cmd/en_power_path|0|1"   # terakhir: HIZ (input diputus, baterai yang menyuplai)
}
chg_unwind(){ [ -s $DIR/chgp ] && { IFS='|' read -r cn cs co < $DIR/chgp; chg_apply "$cn" "$co"; }; rm -f $DIR/chgp; }
chg_pick(){ # 0=metode ditemukan (full/partial), 1=belum bisa diverifikasi (belum mengisi), 2=semua metode gagal
  chg_isch || return 1
  : > $DIR/chglog; : > $DIR/chgm; rm -f $DIR/chgq
  chg_cands | awk '!s[$0]++' > $DIR/chgc.lst
  base=$(chg_cur); b0=$base; kept=0
  echo "arus awal: $((base/1000)) mA" >> $DIR/chglog
  while IFS='|' read -r cn cs cr; do
    # Catatan: sebelumnya di sini ada cek `[ -w "$cn" ] || continue` sebelum mencoba menulis. Di sejumlah node
    # vendor MTK (tran_aichg_disable_charger, stop_chg, mtk_battery_cmd/current_cmd, dan node arus di
    # mtk-master-charger -- IC pengisian yang sebenarnya aktif) cek `-w` itu salah: izin file kelihatan oke tapi
    # access() gagal lewat SELinux, jadi node-node paling ampuh itu terlewat diam-diam tanpa pernah dicoba maupun
    # tercatat di log. Sekarang kita cukup pastikan file-nya ADA (`-e`), lalu LANGSUNG coba tulis -- kalau memang
    # benar-benar tidak bisa ditulis, itu akan gagal wajar dan tetap tercatat sebagai GAGAL di log (bukan hilang).
    [ -e "$cn" ] || { echo "LEWAT   $cn (node tidak ada)" >> $DIR/chglog; continue; }
    co=$(rd "$cn")
    [ "$co" = "$cs" ] && { echo "LEWAT   $cn (nilai sudah $cs)" >> $DIR/chglog; continue; }
    [ -z "$co" ] && co=$cr
    [ "$(echo "$co" | wc -l)" -gt 1 ] && co=$cr
    echo "$cn|$cs|$co" > $DIR/chgp
    chg_apply "$cn" "$cs"; i=0; ok=0
    while [ $i -lt 4 ]; do sleep 2; chg_isch || { ok=1; break; }; i=$((i+1)); done
    now=$(chg_cur)
    if [ $ok = 1 ]; then
      echo "$cn|$cs|$co" >> $DIR/chgm; rm -f $DIR/chgp; echo full > $DIR/chgq
      echo "OK      $cn <- $cs (asli: $co) | arus $((base/1000))->$((now/1000)) mA, pengisian BERHENTI" >> $DIR/chglog; return 0
    fi
    if [ $((base-now)) -ge 250000 ]; then   # arus turun >=250 mA tapi masih mengisi: simpan, lanjut tumpuk metode berikutnya
      echo "$cn|$cs|$co" >> $DIR/chgm; rm -f $DIR/chgp; kept=1
      echo "SEBAGIAN $cn <- $cs | arus $((base/1000))->$((now/1000)) mA (dipertahankan)" >> $DIR/chglog; base=$now
    else
      chg_apply "$cn" "$co"; rm -f $DIR/chgp
      echo "GAGAL   $cn <- $cs | arus $((base/1000))->$((now/1000)) mA" >> $DIR/chglog
    fi
  done < $DIR/chgc.lst
  if [ $kept = 1 ]; then echo "partial|$((b0/1000))|$((base/1000))" > $DIR/chgq; return 0; fi
  : > $DIR/chgm; return 2
}
chg_hold(){ while IFS='|' read -r cn cs cr; do [ -n "$cn" ] && { if [ "$cn" = LIMIT ]; then chg_set stop; else chg_apply "$cn" "$cs"; fi; }; done < $DIR/chgm; }
chg_resume(){ chg_unwind; while IFS='|' read -r cn cs co; do [ -n "$cn" ] && { if [ "$cn" = LIMIT ]; then chg_set res; else chg_apply "$cn" "$co"; fi; }; done < $DIR/chgm; }
chg_stop(){ if [ -s $DIR/chgm ]; then chg_hold; return 0; fi; chg_pick; }
chg_reset(){ [ -s $DIR/chgm ] && chg_resume; chg_unwind; rm -f $DIR/chgm $DIR/chgq $DIR/chgfail $DIR/chglog $DIR/chgc.lst $DIR/chgn $DIR/chgd $DIR/nonodes; echo OK; }
# Fast Charging (metode modul fast_charging): paksa status baterai "Good" dan charge_control_limit 0,
# supaya kondisi "warm"/limit suhu tidak menurunkan arus pengisian.
chg_fast(){
  chg_dirs
  while read d; do w 0 $d/charge_control_limit; w Good $d/health; done < $DIR/chgd
}
chg_wd(){
  echo $$ > $DIR/chg.pid; held=0; bo=0; echo 0 > $DIR/chgheld; chg_unwind   # pulihkan sisa percobaan bila proses sebelumnya mati di tengah deteksi
  while :; do
    lvl=; read -r lvl 2>/dev/null < $BAT/capacity; lvl=${lvl:-0}; want=res   # siklus tanpa fork (builtin read/cfgv)
    cfgv F_bypass; [ "$CV" = on ] && want=stop
    cfgv F_gamebypass; [ "$CV" = on ] && [ -f $DIR/ingame ] && want=stop
    cfgv F_autocut; if [ "$CV" = on ]; then
      cfgv CUT; cut=${CV:-80}
      if [ "$lvl" -ge "$cut" ]; then want=stop; elif [ "$held" = 1 ] && [ "$lvl" -gt $((cut-5)) ]; then want=stop; fi
    fi
    if [ "$want" = stop ]; then
      if [ "$held" = 1 ]; then chg_hold          # tegaskan ulang tiap siklus: kernel/charger HAL sering menimpa nilainya
      elif [ $bo -gt 0 ]; then bo=$((bo-1))
      else
        chg_stop; rc=$?
        if [ $rc = 0 ]; then held=1; rm -f $DIR/chgfail
        elif [ $rc = 2 ]; then date +%s > $DIR/chgfail; bo=120; fi   # semua metode gagal: coba lagi 10 menit kemudian
      fi
    elif [ "$held" = 1 ]; then chg_resume; held=0; fi
    echo $held > $DIR/chgheld
    cfgv F_fastcharge; [ "$want" = res ] && [ "$held" = 0 ] && [ "$CV" = on ] && plugged && chg_fast
    # Saat metode sedang "held" (bypass/auto-cut aktif & terkunci), charger HAL MTK sering menimpa balik nilai kita
    # tiap siklusnya -> arus sempat "bocor naik" dulu sebelum kita tegaskan ulang. Perpendek jeda jadi 1 detik di
    # kondisi ini (vs 5 detik saat idle) supaya arus yang bocor di antara dua penegasan jauh lebih kecil & singkat.
    if [ "$held" = 1 ]; then sleep 1; else sleep 5; fi
  done
}
chg_sync(){
  on=0; for f in fastcharge autocut bypass gamebypass; do [ "$(getcfg F_$f)" = on ] && on=1; done
  alive=0; [ -f $DIR/chg.pid ] && kill -0 $(cat $DIR/chg.pid) 2>/dev/null && alive=1
  if [ $on = 1 ] && [ $alive = 0 ]; then bg chg_wd
  elif [ $on = 0 ] && [ $alive = 1 ]; then kill $(cat $DIR/chg.pid); rm -f $DIR/chg.pid; [ -s $DIR/chgm ] && chg_resume; echo 0 > $DIR/chgheld; fi
}

# ---------- GAME: preload, DND otomatis, FPS ----------
fg_pkg(){ dumpsys window 2>/dev/null | grep -m1 mCurrentFocus | sed 's/.* \([A-Za-z0-9_.]*\)\/.*/\1/'; }
# game_fg: game di daftar yang sedang di depan, TANPA dumpsys. `dumpsys window` men-dump seluruh state WindowManager dan
# memegang lock global WMS; dipanggil berulang (tiap 4 dtk oleh game_wd) itu bisa menunda dispatch sentuhan -> touch "ngelag"
# periodik. Proses app yang sedang di depan punya oom_score_adj 0 (FOREGROUND_APP_ADJ), cukup baca /proc (murah, tanpa lock).
# Daftar game kosong / tidak ada proses game yang hidup -> tidak ada pekerjaan sama sekali.
pid_top(){ # <pid>: proses di depan? (oom_score_adj 0 ATAU ada di cgroup top-app) - hanya builtin shell, tanpa fork
  _a=; read -r _a 2>/dev/null < /proc/$1/oom_score_adj || return 1
  [ "$_a" = 0 ] && return 0
  while IFS= read -r _l; do case $_l in *top-app*) return 0;; esac; done 2>/dev/null < /proc/$1/cgroup
  return 1
}
game_fgp(){ # game dari daftar yang sedang di layar -> "paket pid" (daftar dibaca dengan builtin; hanya pidof yang fork)
  [ -s $DIR/games.txt ] || return 0
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    for pid in $(pidof $g 2>/dev/null); do
      pid_top $pid && { echo "$g $pid"; return 0; }
    done
  done < $DIR/games.txt
}
game_fg(){ set -- $(game_fgp); echo $1; }
glog(){ echo "$(date +%H:%M:%S) $*" >> $DIR/game.log; [ "$(stat -c %s $DIR/game.log 2>/dev/null || echo 0)" -gt 4096 ] && { tail -n 20 $DIR/game.log > $DIR/game.log.t; mv -f $DIR/game.log.t $DIR/game.log; }; }
# ---------- REKAM LAG: sampel tiap 2 dtk selama 40 dtk saat kamu main (clock CPU/GPU, suhu, beban, mode) -> $DIR/lagrec.txt ----------
# Dipakai untuk mencari penyebab nyata lag: clock jatuh? suhu tinggi (throttle)? CPU penuh? Hasil dibaca lewat "Cek pemantau game".
lagrec(){ [ -f $DIR/lagrec.pid ] && kill -0 $(cat $DIR/lagrec.pid) 2>/dev/null && { echo "ERR|perekaman sedang berjalan"; return; }
  : > $DIR/lagrec.txt; bgx lagrec_run; echo "OK|merekam 40 detik - main sekarang, lalu tekan Cek pemantau game"; }
lagrec_run(){ echo $$ > $DIR/lagrec.pid; i=0
  while [ $i -lt 20 ]; do
    tmax=0; for z in /sys/class/thermal/thermal_zone*/temp; do read -r v < $z 2>/dev/null || continue; case $v in ''|*[!0-9-]*) continue;; esac; [ "$v" -gt "$tmax" ] && tmax=$v; done
    [ "$tmax" -gt 1000 ] && tmax=$((tmax/1000))
    cf=; for pl in $CPU/policy*; do cf="$cf $(rd $pl/scaling_cur_freq | cut -c1-4)/$(rd $pl/scaling_max_freq | cut -c1-4)"; done
    gf=$(rd $GPU/cur_freq); [ -z "$gf" ] && gf=$(rd /sys/kernel/ged/hal/current_freqency); gf=${gf:-?}
    read -r l1 _ < /proc/loadavg; bt=$(rd $BAT/temp)
    echo "$(date +%S)s suhuMax=${tmax}C bat=${bt:-?} cpu(cur/max MHz)=${cf# } gpu=$gf load=$l1 mode=$(curmode) fg=$(game_fg)" >> $DIR/lagrec.txt
    i=$((i+1)); sleep 2
  done
  echo "--- proses terberat ---" >> $DIR/lagrec.txt; top -b -n 1 -m 6 2>/dev/null | tail -n 8 >> $DIR/lagrec.txt
  rm -f $DIR/lagrec.pid; }
# ---------- CEK VERSI: bukti versi mana yang SEBENARNYA terpasang & jalan (modul, WebUI, aplikasi) ----------
SCRIPT_VER=2.84.0
ver_check(){
  echo "skrip_berjalan=$SCRIPT_VER ($SELF)"
  for d in /data/adb/modules /data/adb/modules_update; do
    [ -f $d/ultrapower/module.prop ] || continue
    echo "$d: module.prop=$(grep -m1 '^version=' $d/ultrapower/module.prop | cut -d= -f2) skrip=$(grep -m1 '^SCRIPT_VER=' $d/ultrapower/system/bin/ultrapower | cut -d= -f2) webroot=$(grep -o "const VER='[^']*'" $d/ultrapower/webroot/index.html 2>/dev/null | cut -d"'" -f2)"
  done
  [ -f /data/adb/modules/ultrapower/disable ] && echo "!! modul DINONAKTIFKAN (file disable ada)"
  [ -f /data/adb/modules/ultrapower/remove ] && echo "!! modul akan DIHAPUS saat reboot"
  [ -d /data/adb/modules_update/ultrapower ] && echo "!! ada pembaruan modul menunggu REBOOT (modules_update): file lama masih jalan sampai reboot"
  echo "apk_com.comatoze=$(dumpsys package com.comatoze 2>/dev/null | grep -m1 versionName | tr -d ' ')"
  [ -f $DIR/skip ] && echo "!! FILE SKIP ADA: tweak TIDAK diterapkan saat boot (mode aman). Penyebab: saklar 'Terapkan saat boot' mati atau pelindung bootloop aktif. Tekan 'Perbaiki & terapkan'."
  echo "boot_try=$(cat $DIR/boot_try 2>/dev/null) bootguard=$(tail -n 1 $DIR/bootguard.log 2>/dev/null)"
  echo "MODE=$(getcfg MODE) efektif=$(curmode) pemantau_game=$([ -f $DIR/game.pid ] && kill -0 $(cat $DIR/game.pid) 2>/dev/null && echo hidup || echo mati)"
  p0=$(ls -d $CPU/policy* 2>/dev/null | head -1); echo "cpu_$(basename $p0): gov=$(rd $p0/scaling_governor) min=$(rd $p0/scaling_min_freq) max=$(rd $p0/scaling_max_freq) (cpuinfo_max=$(rd $p0/cpuinfo_max_freq))"
  n=0; o=; for f in $FEATS; do [ "$(getcfg F_$f)" = on ] && { n=$((n+1)); o="$o $f"; }; done; echo "fitur_on($n):$o"
}
fixboot(){ # buang mode aman (skip), nolkan penghitung bootloop, nyalakan 'Terapkan saat boot' & terapkan tweak sekarang
  rm -f $DIR/skip; echo 0 > $DIR/boot_try; setcfg F_bootapply on; bgx boot; echo "OK|mode aman dibuang, tweak diterapkan"; }
gdiag(){ # diagnosa pemantau game (dipakai tombol Cek Pemantau di WebUI)
  alive=0; [ -f $DIR/game.pid ] && kill -0 $(cat $DIR/game.pid) 2>/dev/null && alive=1
  echo "pemantau_hidup=$alive ingame=$([ -f $DIR/ingame ] && echo ya || echo tidak) profil_aktif=$([ -f $DIR/prof_on ] && echo ya || echo tidak)"
  echo "F_gameprofile=$(getcfg F_gameprofile) GP_MODE=$(getcfg GP_MODE) GP_HZ=$(getcfg GP_HZ) MODE=$(getcfg MODE)"
  echo "game_di_layar=$(game_fg)"
  [ -s $DIR/lagrec.txt ] && { echo "--- rekaman lag terakhir ---"; tail -n 24 $DIR/lagrec.txt | cut -c1-170; }
  for g in $(cat $DIR/games.txt 2>/dev/null); do
    pids=$(pidof $g 2>/dev/null)
    if [ -z "$pids" ]; then echo "$g: proses tidak ada"; continue; fi
    for pid in $pids; do echo "$g: pid=$pid adj=$(cat /proc/$pid/oom_score_adj 2>/dev/null) cg=$(grep -o 'top-app\|foreground\|background' /proc/$pid/cgroup 2>/dev/null | head -1)"; done
  done
  echo "-- log:"; tail -n 8 $DIR/game.log 2>/dev/null
}
games(){ case $1 in
  list) pm list packages -3 | sed 's/package://' | grep -v '^android\.' | sort;;
  detect) games_catalog > $DIR/c.gcat; touch $DIR/games.txt; pm list packages -3 | sed 's/package://' | grep -Fx -f $DIR/c.gcat | grep -Fxv -f $DIR/games.txt;;
  add) grep -qx "$2" $DIR/games.txt 2>/dev/null || { echo $2 >> $DIR/games.txt; gfx_apply_all; };;
  del) grep -vx "$2" $DIR/games.txt > $DIR/games.t; mv $DIR/games.t $DIR/games.txt; setcfg "GPM_$2" ""; setcfg "GPH_$2" "";;
esac; }
preload(){ [ "$(meminfo_kb MemAvailable)" -lt 2500000 ] 2>/dev/null && return 0   # RAM tersedia <2.5 GB: lewati (rebutan memori dengan game)
  # apk/lib/oat/obb + aset non-media di Android/data/<pkg>/files -> page cache (batas ${PRELOAD_MB:-800} MB)
  lim=$((${PRELOAD_MB:-800}*1048576)); used=0; L=$DIR/pl.$$.lst
  { for a in $(pm path $1 | sed 's/package://'); do d=$(dirname $a); ls $a $d/lib/arm64/* $d/oat/arm64/* 2>/dev/null; done
    ls /sdcard/Android/obb/$1/* 2>/dev/null
    find /sdcard/Android/data/$1/files -type f 2>/dev/null | grep -Eiv '\.(mp3|ogg|wav|mp4|png|jpe?g|webp|log|txt)$'
  } > $L
  while IFS= read -r f; do
    [ -f "$f" ] || continue; sz=$(stat -c %s "$f"); [ $((used+sz)) -gt $lim ] && continue
    nice -n 19 cat "$f" > /dev/null 2>&1; used=$((used+sz))
  done < $L
  rm -f $L
}
# Ide fitur game terinspirasi dari CMD-Tweaks (t.me/HoyoSlave); kode ditulis ulang.
gclean(){ for p in $(pm list packages -3 | sed 's/package://'); do [ "$p" = "$1" ] || [ "$p" = com.comatoze ] || cmd activity kill --user 0 $p >/dev/null 2>&1; done; }   # per paket pihak ketiga selain game & Comatoze. TANPA kill-all global: kill-all bisa mematikan proses pendamping game yang sedang dimuat (penyebab game 'mental' saat dibuka)
mode_restore(){
  m=$(getcfg MODE); [ "$m" = auto ] && m=balance
  if [ "$m" = custom ]; then batsaver custom; while IFS='|' read -r k a; do [ -n "$a" ] && NOSAVE=1 sh $SELF $a; done < $CUS
  else set_mode $m temp; fi
}
# Profil per game: GPM_<paket> (perf|plite|balance|eco|skip) dan GPH_<paket> (Hz); kosong = ikut profil global (GP_MODE/GP_HZ). skip = jangan ubah apa pun untuk game itu.
gp_enter(){ [ -f $DIR/prof_on ] && return
  gm=$(getcfg "GPM_$1"); gh=$(getcfg "GPH_$1")
  [ "$gm" = skip ] && return 0
  touch $DIR/prof_on
  [ -n "$gm" ] || gm=$(getcfg GP_MODE); [ -n "$gh" ] || gh=$(getcfg GP_HZ)
  set_mode ${gm:-perf} temp   # set_mode sudah memasang Hz modenya (Performa 120 / Balance 90 / Eco 60) dan mengunci mode layar
  [ -n "$gh" ] && { gh=$(hz_snap $gh); [ -n "$gh" ] && refresh $gh q >/dev/null; }   # Hz pilihan game menimpa Hz mode; tanpa pilihan -> ikut Hz mode
}
hz_snap(){ # Hz yang tidak didukung layar -> Hz didukung terdekat di bawahnya (bila tak ada, terendah); kosong bila daftar Hz tidak terbaca
  rlist | awk -v t="$1" 'NR==1{lo=$1} $1+0<=t+0{b=$1} END{ if(b!="") print b; else if(lo!="") print lo }'
}
gp_game(){ # <paket> <mode|-> <hz|->  : simpan profil satu game ("-" = ikut global)
  case $1 in ''|*[!A-Za-z0-9_.]*) echo "ERR|nama paket tidak valid"; return 1;; esac
  case $2 in -|perf|plite|balance|eco|skip) ;; *) echo "ERR|mode tidak dikenal"; return 1;; esac
  case $3 in -|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]) ;; *) echo "ERR|Hz tidak valid"; return 1;; esac
  m=$2; h=$3; [ "$m" = - ] && m=; [ "$h" = - ] && h=
  setcfg "GPM_$1" "$m"; setcfg "GPH_$1" "$h"; echo OK
}
gp_leave(){ [ -f $DIR/prof_on ] || return; rm -f $DIR/prof_on; mode_restore; }
# Thermal otomatis saat game (fitur gamethermal): masuk game -> thermal dimatikan SEMENTARA ("temp" = tidak mengubah setelan THERMAL yang tersimpan),
# keluar game -> dihidupkan lagi. Bila pengguna memang mematikan thermal secara permanen (THERMAL=off), tidak ada yang diubah dan tidak dihidupkan balik.
# Penanda $DIR/gth_on = thermal sedang dimatikan oleh fitur ini (dibersihkan saat boot karena kondisi thermal ikut ter-reset).
gth_on(){ [ -f $DIR/gth_on ] && return 0; [ "$(getcfg THERMAL)" = off ] && return 0; : > $DIR/gth_on; thermal off temp >/dev/null 2>&1; }
gth_off(){ [ -f $DIR/gth_on ] || return 0; rm -f $DIR/gth_on; [ "$(getcfg THERMAL)" = off ] || thermal on temp >/dev/null 2>&1; }
# ---------- FRAME PACING (penstabil FPS) ----------
# Berlaku hanya saat game dari Daftar Game ada di depan (seperti Thermal Otomatis), dipulihkan saat keluar game -> tidak menguras baterai di luar game.
# Yang diubah (hanya node yang benar-benar ada & berhasil ditulis; jumlahnya dilaporkan ke WebUI):
#  - CPU schedutil: up_rate_limit_us 500 (naik clock cepat) + down_rate_limit_us 20000 (clock ditahan ~2 frame, tidak jatuh di tengah frame)
#  - GPU devfreq: polling_interval cepat, upthreshold lebih rendah (naik lebih awal), downdifferential lebih lebar (tidak turun terlalu cepat)
#  - CPU idle: state tidur dalam dimatikan (latensi bangun kecil = waktu frame lebih rata)
# Nilai asli dicatat sekali per node di $FPV dan ditulis balik oleh fp_off.
FPV=$DIR/fpvals
FPP=$DIR/fpprops
CPUD=/sys/devices/system/cpu
fpw(){ # node nilai
  [ -e "$1" ] || return 0
  _fo=$(cat "$1" 2>/dev/null); [ -n "$_fo" ] || return 0
  grep -q "^$1|" $FPV 2>/dev/null || echo "$1|$_fo" >> $FPV
  chmod 644 "$1" 2>/dev/null; echo "$2" > "$1" 2>/dev/null
  [ "$(cat "$1" 2>/dev/null)" = "$2" ] && FPN=$((FPN+1))
  return 0; }
fpp(){ # prop nilai: simpan nilai asli sekali ($FPP), lalu set
  grep -q "^$1|" $FPP 2>/dev/null || echo "$1|$(getprop $1)" >> $FPP
  setprop "$1" "$2" 2>/dev/null; }
fp_alt(){ # knob pengganti FPSGO + penstabil tambahan (node tidak ada = dilewati)
  for _n in /sys/module/ged/parameters/ged_boost_enable /sys/module/ged/parameters/gx_game_mode /sys/module/ged/parameters/gx_boost_on /sys/module/ged/parameters/enable_game_self_frc_detect; do fpw $_n 1; done
  fpw /proc/perfmgr/syslimiter/syslimiter_force_disable 1
  fpw /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_fg_boost 60
  fpw /proc/perfmgr/boost_ctrl/cpu_ctrl/cfp_enable 0
  fpw /sys/module/mtk_fpsgo/parameters/boost_affinity 1
  fpw /sys/module/mtk_fpsgo/parameters/boost_LR 1
  fpw /sys/kernel/ged/hal/dcs_mode 0
  for _p in /sys/module/*fpsgo*/parameters; do [ -d $_p ] && fpw $_p/fbt_enable 1; done; }
fp_on(){
  FPN=0; mkdir -p $DIR
  for _p in $CPU/policy*; do
    for _g in schedutil sugov_ext walt; do [ -d $_p/$_g ] || continue
      fpw $_p/$_g/up_rate_limit_us 250; fpw $_p/$_g/down_rate_limit_us 30000
      fpw $_p/$_g/hispeed_load 60; fpw $_p/$_g/rate_limit_us 500
    done
  done
  fpw /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
  _fc=$FPN
  if [ -n "$GPU" ]; then
    fpw $GPU/polling_interval 8; fpw $GPU/simple_ondemand/upthreshold 55; fpw $GPU/simple_ondemand/downdifferential 30
    # lantai clock GPU ~55% dari maksimum: GPU tidak jatuh ke OPP bawah di tengah adegan ringan -> waktu frame rata
    _gf=$(rd $GPU/available_frequencies); _gx=0; for _f in $_gf; do [ "$_f" -gt "$_gx" ] 2>/dev/null && _gx=$_f; done
    if [ "$_gx" -gt 0 ]; then _gm=$_gx; _lim=$((_gx*60/100)); for _f in $_gf; do [ "$_f" -ge "$_lim" ] && [ "$_f" -lt "$_gm" ] && _gm=$_f; done; fpw $GPU/min_freq $_gm; fi
  fi
  _fg=$((FPN-_fc)); _f0=$FPN
  for _cp in $CPUD/cpu[0-9]*; do for _st in $_cp/cpuidle/state[1-9]*; do fpw $_st/disable 1; done; done
  _fi=$((FPN-_f0))
  _dv=$(ls -d /sys/class/devfreq/*dvfsrc* 2>/dev/null | head -1)
  if [ -n "$_dv" ]; then case " $(rd $_dv/available_governors) " in *" performance "*) fpw $_dv/governor performance;; esac; fi
  fp_alt
  [ "$(getcfg FP_SF)" = off ] || { fpp debug.sf.disable_backpressure 1; fpp debug.sf.latch_unsignaled 1; }   # FP_SF=off bila layar berkedip/putih
  echo "$FPN|$_fc|$_fg|$_fi" > $DIR/fp.res; : > $DIR/fp_on
  glog "frame pacing aktif: $FPN parameter"; }
fp_off(){
  if [ -f $FPV ]; then
    while IFS='|' read -r _n _v; do [ -n "$_n" ] && [ -e "$_n" ] && echo "$_v" > "$_n" 2>/dev/null; done < $FPV
  fi
  if [ -f $FPP ]; then while IFS='|' read -r _n _v; do [ -n "$_n" ] && setprop "$_n" "$_v" 2>/dev/null; done < $FPP; fi
  rm -f $FPV $FPP $DIR/fp_on $DIR/fp.res; }
fp_want(){ [ "$(getcfg F_framepace)" = on ] && return 0; [ "$(getcfg F_fpsgooff)" = on ] && fpsgo_alt && return 0; return 1; }
fp_later(){ sleep 5; [ -f $DIR/ingame ] && fp_want && fp_on; }   # setelah profil game & tweak performa terpasang (mereka menulis governor/tunable juga)
fp_support(){ _sc=0; _sg=0; _si=0
  for _p in $CPU/policy*; do for _g in schedutil sugov_ext walt; do [ -e $_p/$_g/up_rate_limit_us ] && _sc=$((_sc+1)); done; done
  if [ -n "$GPU" ]; then for _n in polling_interval simple_ondemand/upthreshold simple_ondemand/downdifferential; do [ -e $GPU/$_n ] && _sg=$((_sg+1)); done; fi
  for _cp in $CPUD/cpu[0-9]*; do for _st in $_cp/cpuidle/state[1-9]*; do [ -e $_st/disable ] && _si=$((_si+1)); done; done
  echo "$_sc|$_sg|$_si"; }
game_wd(){
  echo $$ > $DIR/game.pid; ing=0; dset=0; away=0; lastg=; gpid=
  gp_leave; gth_off; fp_off; rm -f $DIR/ingame   # sisa profil/thermal dari pemantau sebelumnya (mati mendadak) dipulihkan dulu; bila game masih jalan, loop memasangnya lagi
  glog "pemantau mulai"
  [ "$(getcfg F_preload)" = on ] && ( sleep 30; for p in $(cat $DIR/games.txt 2>/dev/null); do preload $p; done ) &
  while :; do
    if [ "$ing" = 1 ] && [ -n "$gpid" ] && pid_top $gpid; then cur=$lastg   # jalur cepat: game yang sama masih di depan -> nol fork
    else
      set -- $(game_fgp); cur=$1; gpid=$2
    fi
    cfgv F_fpsgooff; [ "$CV" = on ] && fpsgo_keep
    fpn=$((${fpn:-0}+1)); [ $((fpn % 10)) = 0 ] && [ "$ing" = 1 ] && [ -f $DIR/fp_on ] && ( fp_on ) >/dev/null 2>&1 &   # ROM/kernel sering menimpa balik: tegaskan lagi tiap ~30 dtk
    if [ "$ing" = 1 ] && [ -n "$cur" ] && [ "$cur" = "$lastg" ] && [ -n "$gpid" ] && [ -n "$lastpid" ] && [ "$gpid" != "$lastpid" ]; then
      # game mati lalu dibuka ulang (pid baru) sebelum 15 dtk: dulu dianggap 'masih di dalam game' sehingga mode Performa TIDAK dipasang lagi
      en=$(date +%s); [ $((en-${et:-0})) -lt 75 ] && { crash=$((${crash:-0}+1)); glog "game berhenti mendadak ($crash)"; [ $crash -ge 2 ] && { gfx_safe; crash=0; }; }
      gp_leave; gth_off; fp_off; rm -f $DIR/ingame; ing=0; glog "game dibuka ulang"
    fi
    if [ -n "$cur" ]; then
      away=0
      if [ "$ing" = 0 ]; then
        ing=1; echo "$cur" > $DIR/ingame   # isi = paket game (dipakai notifikasi status)
        et=$(date +%s); lastg=$cur; lastpid=$gpid
        glog "masuk $cur"; [ -s $AAP ] && tex_cur $cur
        [ "$(getcfg F_gamethermal)" = on ] && gth_on
        if [ "$(getcfg F_gamednd)" = on ]; then cmd notification set_dnd priority; dset=1; fi
        # Tindakan berat DITUNDA 8 dtk: saat game baru dibuka ia sedang memuat aset; ganti mode/Hz/kill/IO di detik pertama bisa membuatnya mati ('mental').
        ( sleep 8; [ -f $DIR/ingame ] || exit 0; [ "$(game_fg)" = "$cur" ] || exit 0
          [ -f $PXV2 ] && perf_x_game
          [ "$(getcfg F_gameprofile)" = on ] && gp_enter $cur
          fp_want && fp_on
          [ "$(getcfg F_gameclean)" = on ] && { sleep 15; [ "$(game_fg)" = "$cur" ] && gclean $cur; }
        ) </dev/null >/dev/null 2>&1 &
      elif [ "$cur" != "$lastg" ]; then   # pindah langsung ke game lain di daftar: terapkan profil game barunya
        lastg=$cur; [ -s $AAP ] && tex_cur $cur
        if [ "$(getcfg F_gameprofile)" = on ]; then gp_leave; gp_enter $cur; fi
        fp_want && fp_later &
      fi
    elif [ "$ing" = 1 ]; then
      away=$((away+1))
      if [ $away -ge 5 ]; then   # keluar game bila 5x cek berturut-turut (~15 dtk) (anti-flicker shade/dialog/pemuatan)
        ing=0; rm -f $DIR/ingame; gp_leave; gth_off; fp_off; glog "keluar ${lastg}"
        [ "$(getcfg F_preload)" = on ] && ( sleep 20; preload $lastg ) </dev/null >/dev/null 2>&1 &   # panaskan cache untuk pembukaan berikutnya, saat RAM lega (bukan saat game dimuat)
        # penjaga render: game mati (bukan sekadar pindah app) dalam ~60 dtk setelah dibuka, 2x berturut-turut -> kembalikan setelan render bawaan
        if [ -n "$gpid" ] && ! kill -0 $gpid 2>/dev/null; then
          en=$(date +%s); if [ $((en-${et:-0})) -lt 75 ]; then crash=$((${crash:-0}+1)); glog "game berhenti mendadak ($crash)"; [ $crash -ge 2 ] && { gfx_safe; crash=0; }; else crash=0; fi
        fi
        [ "$dset" = 1 ] && { cmd notification set_dnd off; dset=0; }
      fi
    fi
    sleep 3
  done
}
game_sync(){
  on=0; for f in preload gamednd gameprofile gameclean gamebypass gamethermal fpsgooff framepace; do [ "$(getcfg F_$f)" = on ] && on=1; done
  alive=0; [ -f $DIR/game.pid ] && kill -0 $(cat $DIR/game.pid) 2>/dev/null && alive=1
  if [ $on = 1 ] && [ $alive = 0 ]; then bg game_wd
  elif [ $on = 0 ] && [ $alive = 1 ]; then kill $(cat $DIR/game.pid); rm -f $DIR/game.pid; gp_leave; gth_off; fp_off; fi
}
# ---------- GRAFIS PER GAME: resolusi, driver (Game Driver), API (ANGLE) ----------
# Referensi perilaku: CMD-Tweaks "Resolution Scale" & "Renderer/Angle" (t.me/HoyoSlave) - kode ditulis ulang,
# dan dibatasi hanya ke game di daftar Comatoze (bukan ke semua aplikasi seperti pada sumber referensi).
# game_driver_opt_in/out_apps & angle_gl_driver_selection_* adalah Settings.Global bawaan Android (AOSP GameManager/ANGLE),
# bukan API privat buatan kami.
gfx_scale_one(){ # pkg percent -- terapkan downscale ke 1 app
  p=$1; v=$2
  if [ $v -ge 100 ]; then cmd game reset $p >/dev/null 2>&1
  else sc=$(awk -v v=$v 'BEGIN{printf "%.2f", v/100}')
    cmd device_config put game_overlay $p "mode=2" >/dev/null 2>&1
    cmd game set --mode 2 --downscale $sc $p >/dev/null 2>&1 || cmd game downscale $sc $p >/dev/null 2>&1
  fi
}
gfx_scale(){ # [pkg] percent (1-100, 100 = normal). Tanpa pkg = default utk semua game yg belum punya override sendiri.
  if [ $# -ge 2 ]; then pkg=$1; v=$2; else pkg=""; v=$1; fi
  case $v in ''|*[!0-9]*) echo "ERR|angka tidak valid"; return 1;; esac
  if [ $v -lt 1 ] || [ $v -gt 100 ]; then echo "ERR|harus 1-100"; return 1; fi
  if [ -n "$pkg" ]; then
    setcfg "GFXS_$pkg" $v
    gfx_scale_one "$pkg" "$v"
  else
    setcfg GFX_SCALE $v
    for p in $(cat $DIR/games.txt 2>/dev/null); do
      ov=$(getcfg "GFXS_$p"); [ -n "$ov" ] && continue   # app dgn override sendiri nggak ikut ketimpa default global
      gfx_scale_one "$p" "$v"
    done
  fi
  echo OK
}
gfx_scale_reset(){ # pkg -- hapus override khusus app itu, balik pakai default global
  pkg=$1; [ -z "$pkg" ] && { echo "ERR|pkg kosong"; return 1; }
  grep -v "^GFXS_$pkg=" $CFG > $CFG.t 2>/dev/null; mv $CFG.t $CFG
  s=$(getcfg GFX_SCALE); [ -z "$s" ] && s=100
  gfx_scale_one "$pkg" "$s"
  echo OK
}
# Segarkan UI (bukan reboot): setelah ganti renderer/driver/ANGLE, game di daftar dihentikan paksa dan SystemUI dimuat ulang
# supaya pengaturan grafis terpasang bersih. Ditunda 3 dtk; ketukan beruntun hanya memicu satu kali restart. Selalu otomatis (tanpa menu).
ui_restart(){
  read _t < /proc/sys/kernel/random/uuid 2>/dev/null || _t=$$.$(date +%s%N); echo "$_t" > $DIR/uirst
  ( sleep 3; [ "$(cat $DIR/uirst 2>/dev/null)" = "$_t" ] || exit 0; rm -f $DIR/uirst
    for _p in $(cat $DIR/games.txt 2>/dev/null); do am force-stop $_p >/dev/null 2>&1; done
    pkill -f com.android.systemui >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
  return 0; }
gfx_driver(){ # default | driver (Game Driver/updatable) | native (driver sistem)
  case $1 in default|driver|native) setcfg GFX_DRV $1;; *) echo "ERR|mode tidak dikenal"; return 1;; esac
  g=$(cat $DIR/games.txt 2>/dev/null | tr '\n' ',' | sed 's/,$//')
  case $1 in
    driver) [ -n "$g" ] && sput global game_driver_opt_in_apps "$g" || sdel global game_driver_opt_in_apps; sdel global game_driver_opt_out_apps;;
    native) [ -n "$g" ] && sput global game_driver_opt_out_apps "$g" || sdel global game_driver_opt_out_apps; sdel global game_driver_opt_in_apps;;
    default) sdel global game_driver_opt_in_apps; sdel global game_driver_opt_out_apps;;
  esac
  echo OK
}
gfx_angle(){ # default | native (OpenGL ES asli) | angle (lapisan terjemahan ke Vulkan)
  case $1 in default|native|angle) setcfg GFX_ANGLE $1;; *) echo "ERR|mode tidak dikenal"; return 1;; esac
  if [ "$1" = default ]; then sdel global angle_gl_driver_selection_pkgs; sdel global angle_gl_driver_selection_values; angle_compose; echo OK; return; fi
  pkgs=""; vals=""
  for p in $(cat $DIR/games.txt 2>/dev/null); do pkgs="$pkgs,$p"; vals="$vals,$1"; done
  pkgs=${pkgs#,}; vals=${vals#,}
  if [ -n "$pkgs" ]; then sput global angle_gl_driver_selection_pkgs "$pkgs"; sput global angle_gl_driver_selection_values "$vals"
  else sdel global angle_gl_driver_selection_pkgs; sdel global angle_gl_driver_selection_values; fi
  angle_compose
  echo OK
}
gfx_safe(){ # setelan render dikembalikan ke bawaan (ANGLE/driver/skala) - dipakai penjaga crash
  angle_app clear >/dev/null 2>&1; gfx_angle default >/dev/null 2>&1; gfx_driver default >/dev/null 2>&1; gfx_scale 100 >/dev/null 2>&1
  glog "render AMAN: ANGLE/driver/skala dikembalikan ke bawaan (game crash berulang)"; }
gfx_apply_all(){ # terapkan ulang pengaturan grafis (scale per-app/default, driver, angle) ke seluruh daftar game saat ini
  s=$(getcfg GFX_SCALE); [ -z "$s" ] && s=100
  for p in $(cat $DIR/games.txt 2>/dev/null); do
    ov=$(getcfg "GFXS_$p"); v=${ov:-$s}
    [ "$v" != 100 ] && gfx_scale_one "$p" "$v"
  done
  d=$(getcfg GFX_DRV); [ -n "$d" ] && [ "$d" != default ] && gfx_driver $d >/dev/null
  a=$(getcfg GFX_ANGLE); [ -n "$a" ] && [ "$a" != default ] && gfx_angle $a >/dev/null
}

# ---------- MANUAL ----------
cpu_gov(){ # policyN|all gov
  for p in $CPU/policy*; do
    [ "$1" = "all" ] || [ "$(basename $p)" = "$1" ] || continue
    w $2 $p/scaling_governor
  done
  markcustom "cpu_gov_$1" "cpu_gov $1 $2"
}
cpu_freq(){ # policyN min max
  p=$CPU/$1; range $p/scaling_min_freq $p/scaling_max_freq $2 $3
  markcustom "cpu_freq_$1" "cpu_freq $1 $2 $3"
}
gpu_gov(){ [ -n "$GPU" ] && w $1 $GPU/governor; markcustom gpu_gov "gpu_gov $1"; }
gpu_freq(){ [ -n "$GPU" ] && range $GPU/min_freq $GPU/max_freq $1 $2; markcustom gpu_freq "gpu_freq $1 $2"; }

# ---------- DPI ----------
# Nilai yang dipakai di WebUI BUKAN raw density (`wm density`), tapi "lebar terkecil" (smallest width, dp) —
# yaitu angka yang sama persis dengan field "Lebar terkecil" di Opsi Developer > Drawing. Keduanya memang
# berbanding terbalik secara matematis (lebarDp = lebarPxTerkecil * 160 / density), jadi kita hitung density
# yang dibutuhkan dari nilai dp yang diinput user, baru panggil `wm density`. Ini juga yang membuat arahnya
# sesuai permintaan: makin TINGGI angka -> density turun -> elemen UI makin KECIL/rapat ("licin", lebih banyak
# muat di layar). Makin RENDAH angka -> density naik -> elemen UI makin BESAR ("keset").
dpi_phys_density(){ # (cache per-boot: density fisik tidak berubah; wm lambat)
  if [ -s $DIR/c.pdens ]; then cat $DIR/c.pdens; return; fi
  v=$(dpi_phys_density_r); case "$v" in ''|0|*[!0-9]*) ;; *) echo "$v" > $DIR/c.pdens;; esac; echo "$v"
}
dpi_phys_density_r(){ # density fisik asli perangkat, dengan beberapa fallback untuk ROM vendor (XOS/MTK)
  out=$(wm density 2>/dev/null)
  phys=$(echo "$out" | sed -n 's/.*[Pp]hysical[ _]*[Dd]ensity[: ]* *\([0-9][0-9]*\).*/\1/p' | head -1)
  if [ -z "$phys" ] || [ "$phys" = 0 ]; then
    phys=$(getprop ro.sf.lcd_density 2>/dev/null)
  fi
  case "$phys" in ''|0|*[!0-9]*)
    phys=$(dumpsys display 2>/dev/null | sed -n 's/.*[Dd]ensity[= ]\([0-9][0-9]*\).*/\1/p' | head -1)
  ;; esac
  echo "${phys:-0}"
}
dpi_override_density(){ ctl 15 t.ovd dpi_override_density_r; }
dpi_override_density_r(){ # density override aktif saat ini (kosong jika belum diubah / sudah direset)
  wm density 2>/dev/null | sed -n 's/.*[Oo]verride[ _]*[Dd]ensity[: ]* *\([0-9][0-9]*\).*/\1/p' | head -1
}
dpi_minpx(){ # (cache per-boot: ukuran fisik tidak berubah)
  if [ -s $DIR/c.minpx ]; then cat $DIR/c.minpx; return; fi
  v=$(dpi_minpx_r); case "$v" in ''|*[!0-9]*) ;; *) echo "$v" > $DIR/c.minpx;; esac; echo "$v"
}
dpi_minpx_r(){ # sisi terpendek resolusi fisik layar (px) -> dasar perhitungan "lebar terkecil"
  out=$(wm size 2>/dev/null)
  wh=$(echo "$out" | sed -n 's/.*[Pp]hysical [Ss]ize: *\([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' | head -1)
  [ -z "$wh" ] && wh=$(echo "$out" | sed -n 's/.*[Oo]verride [Ss]ize: *\([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' | head -1)
  [ -z "$wh" ] && wh=$(dumpsys window displays 2>/dev/null | sed -n 's/.*init=\([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' | head -1)
  [ -z "$wh" ] && { echo ''; return; }
  w=${wh% *}; h=${wh#* }
  case "$w$h" in *[!0-9\ ]*) echo ''; return;; esac
  if [ "$w" -lt "$h" ]; then echo "$w"; else echo "$h"; fi
}
sw_from_density(){ # px density -> lebar terkecil (dp), dibulatkan
  mp=$1; d=$2
  [ -z "$mp" ] || [ -z "$d" ] || [ "$d" = 0 ] && { echo ''; return; }
  echo $(( (mp*160 + d/2) / d ))
}
density_from_sw(){ # lebar terkecil (dp) -> density px yang perlu diterapkan, dibulatkan
  mp=$1; sw=$2
  [ -z "$mp" ] || [ -z "$sw" ] || [ "$sw" = 0 ] && { echo ''; return; }
  echo $(( (mp*160 + sw/2) / sw ))
}
dpi_info(){ # DPI|lebar_terkecil_default(dp)|lebar_terkecil_aktif_jika_override(dp)
  dens=$(dpi_phys_density); ovd=$(dpi_override_density); mp=$(dpi_minpx)
  defsw=$(sw_from_density "$mp" "$dens")
  ovsw=''
  [ -n "$ovd" ] && ovsw=$(sw_from_density "$mp" "$ovd")
  echo "DPI|${defsw:-0}|${ovsw:-}"
}
dpi_set(){ # $1 = lebar terkecil (dp) yang diinginkan user, valid: 300-1100
  case "$1" in ''|*[!0-9]*) echo "ERR|nilai tidak valid"; return 1;; esac
  [ "$1" -lt 300 ] || [ "$1" -gt 1100 ] && { echo "ERR|nilai di luar jangkauan (300-1100)"; return 1; }
  mp=$(dpi_minpx)
  [ -z "$mp" ] && { echo "ERR|tidak bisa membaca resolusi layar"; return 1; }
  d=$(density_from_sw "$mp" "$1")
  [ -z "$d" ] || [ "$d" -lt 1 ] && { echo "ERR|gagal menghitung density"; return 1; }
  wm density "$d" >/dev/null 2>&1
  dpi_info
}
dpi_reset(){ wm density reset >/dev/null 2>&1; dpi_info; }

# ---------- PENDINGINAN (Cooling) ----------
# Turunkan CPU/GPU ke frekuensi & governor paling rendah + refresh rate paling rendah selama 120 detik, lalu
# kembalikan otomatis ke mode semula (mode_restore, sama seperti dipakai boot()). Dijalankan di background (bg)
# supaya WebUI tidak menunggu 2 menit; progres dibaca lewat COOL.end di status().
COOL=$DIR/cool
cool_apply(){
  for p in $CPU/policy*; do
    [ -d $p ] || continue
    imin=$(rd $p/cpuinfo_min_freq); av=$(rd $p/scaling_available_governors)
    g=$(pick "$av" powersave conservative schedutil); [ -n "$g" ] && w $g $p/scaling_governor
    [ -n "$imin" ] && range $p/scaling_min_freq $p/scaling_max_freq $imin $imin
  done
  if [ -n "$GPU" ]; then
    av=$(rd $GPU/available_governors); fr=$(rd $GPU/available_frequencies); low=$(minof $fr)
    g=$(pick "$av" powersave simple_ondemand msm-adreno-tz); [ -n "$g" ] && w $g $GPU/governor
    [ -n "$low" ] && range $GPU/min_freq $GPU/max_freq $low $low
  elif [ -f $GP/gpufreq_opp_freq ]; then echo 0 > $GP/gpufreq_opp_freq
  fi
  hz=$(rlist | head -1); [ -n "$hz" ] && refresh $hz >/dev/null
}
cool_wd(){
  echo $$ > $COOL.pid; end=$(($(date +%s)+120)); echo $end > $COOL.end; rm -f $COOL.cancel
  while [ "$(date +%s)" -lt "$end" ]; do [ -f $COOL.cancel ] && break; sleep 2; done
  mode_restore
  rm -f $COOL.pid $COOL.end $COOL.cancel
}
cool_start(){
  mkdir -p $DIR
  [ -f $COOL.pid ] && kill -0 $(cat $COOL.pid) 2>/dev/null && { echo OK; return; }
  cool_apply; bg cool_wd; echo OK
}
cool_stop(){ : > $COOL.cancel; echo OK; }
cool_status(){ # COOL|detik_tersisa (0 = tidak berjalan)
  if [ -f $COOL.pid ] && kill -0 $(cat $COOL.pid) 2>/dev/null && [ -f $COOL.end ]; then
    rem=$(($(cat $COOL.end)-$(date +%s))); [ "$rem" -lt 0 ] && rem=0; echo "COOL|$rem"
  else echo "COOL|0"; fi
}

# ---------- BERSIHKAN RAM (kill semua aplikasi pihak ketiga) ----------
# `am force-stop` menghentikan seluruh proses & service aplikasi, TAPI tidak otomatis menghapus kartunya dari
# daftar Recents (task record-nya tetap ada walau prosesnya sudah mati) -> makanya sebelumnya "kelihatan" tidak
# bekerja meski proses sudah ditutup. Di sini kita tambahkan langkah kedua: cari taskId tiap aplikasi lewat
# dumpsys activity recents lalu hapus task-nya satu per satu (am task remove / am stack remove sebagai fallback),
# supaya recents benar-benar bersih, bukan cuma prosesnya yang mati.
recent_tasks(){ # cetak "<taskId> <package>" per baris, dari daftar Recents saat ini
  dumpsys activity recents 2>/dev/null | grep -E '\* Recent|TaskRecord' | while IFS= read -r ln; do
    tid=$(echo "$ln" | sed -n 's/.*#\([0-9][0-9]*\).*/\1/p')
    pkg=$(echo "$ln" | sed -n 's/.*[ A]=\([a-zA-Z0-9_.]*\)\/.*/\1/p')
    [ -z "$pkg" ] && pkg=$(echo "$ln" | sed -n 's/.*A=\([a-zA-Z0-9_.]*\) .*/\1/p')
    [ -n "$tid" ] && [ -n "$pkg" ] && echo "$tid $pkg"
  done
}
clear_recent_task(){ # hapus task utk 1 package dari Recents, abaikan jika gagal (beda versi Android)
  pk="$1"
  for tid in $(recent_tasks | awk -v p="$pk" '$2==p{print $1}'); do
    am task remove "$tid" >/dev/null 2>&1 || am stack remove "$tid" >/dev/null 2>&1
  done
}
killall_apps(){
  cur=$(fg_pkg); n=0
  RT=$(recent_tasks)
  for p in $(pm list packages -3 2>/dev/null | sed 's/^package://'); do
    [ "$p" = "$cur" ] && continue
    am force-stop "$p" >/dev/null 2>&1 && n=$((n+1))
    for tid in $(echo "$RT" | awk -v q="$p" '$2==q{print $1}'); do
      am task remove "$tid" >/dev/null 2>&1 || am stack remove "$tid" >/dev/null 2>&1
    done
  done
  echo "KILLED|$n"
}

# ---------- SPOOF: validasi nilai ----------
spoof_valid(){ # hanya huruf, angka, spasi, titik, underscore, plus, minus; maks 40 karakter
  [ -n "$1" ] && [ ${#1} -le 40 ] && [ -z "$(printf %s "$1" | tr -d 'A-Za-z0-9 ._+-')" ]
}

# ---------- SPOOF PER-APP (butuh modul Zygisk: zygisk/<abi>.so di folder modul ini) ----------
# Daftar disimpan di $DIR/spoof_apps, satu baris: paket|key|manufacturer|model|on|full
#   on   = 1 aktif / 0 dimatikan sementara (preset tetap tersimpan)
#   full = 1 ikut ganti Build.BRAND/DEVICE/PRODUCT (mode lengkap), 0 hanya MANUFACTURER & MODEL
# Dibaca oleh companion Zygisk (root) tiap ada proses aplikasi baru. Baris format lama (4 kolom) tetap valid.
SPA=$DIR/spoof_apps
spoofapp_pkg_ok(){ case "$1" in ''|*[!A-Za-z0-9._]*) return 1;; esac; return 0; }
spoofapp_add(){ # paket key manufacturer model [full] [hardware board soc_manufacturer soc_model]   ('-' = kosong)
  spoofapp_pkg_ok "$1" || { echo "ERR|nama paket tidak valid"; return 1; }
  case "$2" in ''|*[!a-z0-9_]*) echo "ERR|key tidak valid"; return 1;; esac
  spoof_valid "$3" && spoof_valid "$4" || { echo "ERR|nilai tidak valid (hanya huruf/angka/spasi . _ + -)"; return 1; }
  case "${5:-0}" in 0|1) ;; *) echo "ERR|nilai full harus 0 atau 1"; return 1;; esac
  hw=$6; bd=$7; sm=$8; sd=$9
  for cv in "$hw" "$bd" "$sm" "$sd"; do [ -z "$cv" ] || [ "$cv" = - ] || spoof_valid "$cv" || { echo "ERR|nilai chip tidak valid"; return 1; }; done
  [ "$hw" = - ] && hw=; [ "$bd" = - ] && bd=; [ "$sm" = - ] && sm=; [ "$sd" = - ] && sd=
  [ -f $SPA ] || : > $SPA
  awk -F'|' -v p="$1" '$1!=p' $SPA > $SPA.t; echo "$1|$2|$3|$4|1|${5:-0}|$hw|$bd|$sm|$sd" >> $SPA.t; mv $SPA.t $SPA; chmod 644 $SPA
  am force-stop "$1" >/dev/null 2>&1   # supaya peluncuran berikutnya memakai spoof baru
  echo OK
}
spoofapp_chip(){ # paket hardware board soc_manufacturer soc_model   ('-' = kosong / ikut chip asli)
  spoofapp_pkg_ok "$1" || { echo "ERR|nama paket tidak valid"; return 1; }
  for cv in "$2" "$3" "$4" "$5"; do [ -z "$cv" ] || [ "$cv" = - ] || spoof_valid "$cv" || { echo "ERR|nilai chip tidak valid"; return 1; }; done
  [ -f $SPA ] || { echo "ERR|daftar masih kosong"; return 1; }
  awk -F'|' -v OFS='|' -v p="$1" -v h="$2" -v b="$3" -v m="$4" -v d="$5" '$1==p{ if(NF<5)$5="1"; if(NF<6)$6="0"; $7=(h=="-"?"":h); $8=(b=="-"?"":b); $9=(m=="-"?"":m); $10=(d=="-"?"":d) } {print}' $SPA > $SPA.t && mv $SPA.t $SPA
  chmod 644 $SPA
  am force-stop "$1" >/dev/null 2>&1
  echo OK
}
spoofapp_flag(){ # paket on|full 0|1
  spoofapp_pkg_ok "$1" || { echo "ERR|nama paket tidak valid"; return 1; }
  case "$2" in on|full) ;; *) echo "ERR|flag tidak dikenal"; return 1;; esac
  case "$3" in 0|1) ;; *) echo "ERR|nilai harus 0 atau 1"; return 1;; esac
  [ -f $SPA ] || { echo "ERR|daftar masih kosong"; return 1; }
  awk -F'|' -v OFS='|' -v p="$1" -v f="$2" -v v="$3" '$1==p{ if(NF<5)$5="1"; if(NF<6)$6="0"; if(f=="on")$5=v; else $6=v } {print}' $SPA > $SPA.t && mv $SPA.t $SPA
  chmod 644 $SPA
  am force-stop "$1" >/dev/null 2>&1
  echo OK
}
spoofapp_del(){
  spoofapp_pkg_ok "$1" || { echo "ERR|nama paket tidak valid"; return 1; }
  [ -f $SPA ] && { awk -F'|' -v p="$1" '$1!=p' $SPA > $SPA.t; mv $SPA.t $SPA; chmod 644 $SPA; }
  am force-stop "$1" >/dev/null 2>&1
  echo OK
}
spoofapp_test(){ # tampilkan log spoof terakhir untuk paket (dicatat modul Zygisk saat aplikasi dibuka)
  spoofapp_pkg_ok "$1" || { echo "ERR|nama paket tidak valid"; return 1; }
  l=$(logcat -d -s ComatozeZ 2>/dev/null | grep -F "spoof $1 -> " | tail -1)
  [ -n "$l" ] || { echo NONE; return 0; }
  echo "LOG|$(echo "$l" | awk '{print $1" "substr($2,1,8)}')|${l#*ComatozeZ: }"
}

# ---------- GAYA TEKSTUR ANGLE (per-app) ----------
# Memaksa ANGLE untuk app terpilih lalu menambahkan "feature override" ANGLE (debug.angle.feature_overrides_enabled) -> kualitas tekstur
# per game: level 1-4 (LOD offset) dengan gaya Blur (halus) atau Pixel (nearest filtering). Pakai setelan Android yang SAMA dengan gfx_angle di atas, jadi semua penulisan daftar
# angle_gl_driver_selection_* lewat angle_compose: entri lain (milik gfx_angle / buatan pengguna) tetap dipertahankan,
# entri milik fitur ini ditambah/diperbarui, dan daftar paket & nilai selalu sama panjang.
# Catatan: debug.angle.feature_overrides_enabled itu properti GLOBAL (satu gaya untuk semua app ber-ANGLE) dan hilang saat reboot,
# jadi diterapkan ulang oleh boot(). Nilai aslinya dicatat ($AAO) dan dipulihkan saat daftar kosong.
AAP=$DIR/angle_apps
AAO=$DIR/angle_prop.orig
angle_pkg_ok(){ case "$1" in ''|*[!A-Za-z0-9._]*) return 1;; esac; return 0; }
angle_ok(){ [ "$(ctl 600 l.angle angle_yn)" = yes ]; }
angle_yn(){ angle_ok_r && echo yes || echo no; }
angle_ok_r(){ # ANGLE terdeteksi di perangkat? (hanya informasi; bila tidak ada, Android otomatis memakai driver bawaan)
  [ "$(getprop ro.gfx.angle.supported)" = true ] && return 0
  pm path com.android.angle >/dev/null 2>&1 && return 0
  pm path com.google.android.angle >/dev/null 2>&1 && return 0
  for d in /system/lib64 /system/lib64/egl /vendor/lib64 /vendor/lib64/egl /system/lib /system/lib/egl /vendor/lib /vendor/lib/egl; do
    [ -e $d/libGLESv2_angle.so ] && return 0
    [ -e $d/libEGL_angle.so ] && return 0
  done
  return 1
}
# Kualitas tekstur per game: TEX_<paket>="level|gaya" (level 1-4, gaya blur|pixel). Kosong = tidak diubah.
tex_feat(){ v=$(getcfg "TEX_$1"); [ -n "$v" ] || return 1
  l=${v%%|*}; st=${v#*|}; case $l in 1|2|3|4) ;; *) l=4;; esac
  f=forceTextureLodOffset$l; [ "$st" = pixel ] && f=forceNearestFiltering:forceNearestMipFiltering:$f   # nama resmi FeaturesVk ANGLE
  echo $f; }
tex_forget(){ grep -v "^TEX_$1=" $CFG > $CFG.t 2>/dev/null; mv -f $CFG.t $CFG; grep -v "^TEXA_$1=" $CFG > $CFG.t 2>/dev/null; mv -f $CFG.t $CFG; }
ANL=$DIR/angle_last.txt   # catatan penggabungan terakhir (untuk diagnosa)
angle_write(){ # key nilai -> tulis lalu BACA ULANG; bila beda, coba jalur lain
  sput global "$1" "$2"
  [ "$(sget global "$1")" = "$2" ] && return 0
  cmd settings put global "$1" "$2" >/dev/null 2>&1
  [ "$(sget global "$1")" = "$2" ] && return 0
  content insert --uri content://settings/global --bind name:s:"$1" --bind value:s:"$2" >/dev/null 2>&1
  [ "$(sget global "$1")" = "$2" ] && return 0
  echo "GAGAL menulis $1" >> $ANL
  return 1
}
angle_compose(){ # [paket yang harus dibuang dari daftar]  -- murni shell (tanpa awk)
  drop=" $1 "; own=" $(cat $AAP 2>/dev/null | tr '\n' ' ') "
  P=$(sget global angle_gl_driver_selection_pkgs); V=$(sget global angle_gl_driver_selection_values)
  [ "$P" = null ] && P=""; [ "$V" = null ] && V=""
  oldifs=$IFS; IFS=,; set -f; set -- $V; set +f; IFS=$oldifs   # $1..$n = nilai, urutan sama dengan paket
  n=0; kp=""; kv=""
  for q in $(echo "$P" | tr ',' ' '); do
    n=$((n+1)); eval "val=\${$n}"
    case "$own" in *" $q "*) continue;; esac     # milik fitur ini: ditulis ulang di bawah
    case "$drop" in *" $q "*) continue;; esac    # diminta dibuang
    [ -z "$val" ] && val=angle
    kp="$kp,$q"; kv="$kv,$val"
  done
  for q in $(cat $AAP 2>/dev/null); do kp="$kp,$q"; kv="$kv,angle"; done
  kp=${kp#,}; kv=${kv#,}
  { echo "sebelum  : pkgs=[$P] vals=[$V]"; echo "sesudah  : pkgs=[$kp] vals=[$kv]"; echo "milik     :$own"; } > $ANL
  if [ -n "$kp" ]; then
    angle_write angle_gl_driver_selection_pkgs "$kp" && angle_write angle_gl_driver_selection_values "$kv"
  else sdel global angle_gl_driver_selection_pkgs; sdel global angle_gl_driver_selection_values; fi
  echo "terbaca  : pkgs=[$(sget global angle_gl_driver_selection_pkgs)] vals=[$(sget global angle_gl_driver_selection_values)]" >> $ANL
  return 0
}
angle_setprop(){ setprop debug.angle.feature_overrides_enabled "$1" 2>/dev/null || resetprop -n debug.angle.feature_overrides_enabled "$1" 2>/dev/null; }
angle_prop_apply(){ # properti ANGLE bersifat global: dipasang sesuai game aktif terakhir ($DIR/tex_cur); game ANGLE tanpa pengaturan tekstur = tanpa override
  if [ -s $AAP ]; then
    [ -f $AAO ] || getprop debug.angle.feature_overrides_enabled > $AAO
    f=; c=$(cat $DIR/tex_cur 2>/dev/null)
    if [ -n "$c" ] && grep -qx "$c" $AAP; then f=$(tex_feat $c)
    else for q in $(cat $AAP); do f=$(tex_feat $q); [ -n "$f" ] && break; done; fi
    angle_setprop "$f"
  elif [ -f $AAO ]; then
    angle_setprop "$(cat $AAO)"; rm -f $AAO
  fi
}
angle_regame(){ # kembalikan pengaturan ANGLE global (gfx_angle) untuk game di daftar bila sedang aktif
  a=$(getcfg GFX_ANGLE); [ -n "$a" ] && [ "$a" != default ] && gfx_angle $a >/dev/null
  return 0
}
tex_cur(){ [ -s $AAP ] || return 0; echo "$1" > $DIR/tex_cur; angle_prop_apply; }
tex_status(){ o=; for q in $(cat $DIR/games.txt 2>/dev/null); do v=$(getcfg "TEX_$q"); [ -n "$v" ] && o="$o$q~${v%%|*}~${v#*|};"; done; echo "TEX|${o%;}"; }
tex_verify(){ # cek hasil nyata: daftar ANGLE sistem memuat paket & properti override menempel (bila tidak: pesan penyebab, bukan "OK" palsu)
  _p=",$(sget global angle_gl_driver_selection_pkgs),"; _w=$(tex_feat $1); _g=$(getprop debug.angle.feature_overrides_enabled)
  case "$_p" in *",$1,"*) ;; *) echo "ERR|sistem menolak daftar ANGLE (angle_gl_driver_selection_pkgs kosong)$(angle_ok_r || echo '; ANGLE tidak terdeteksi di HP ini')"; return 1;; esac
  [ "$_g" = "$_w" ] || { echo "ERR|properti override tidak menempel (baca: ${_g:-kosong}) - ROM memblokir setprop debug.angle"; return 1; }
  echo OK; }
tex(){ # set <paket> <1-4> <blur|pixel> | off <paket> | cur <paket>
  case $1 in
    set) angle_pkg_ok "$2" || { echo "ERR|nama paket tidak valid"; return 1; }
         case $3 in 1|2|3|4) ;; *) echo "ERR|level 1-4"; return 1;; esac
         case $4 in blur|pixel) ;; *) echo "ERR|gaya blur atau pixel"; return 1;; esac
         new=0; [ -f $AAP ] || : > $AAP
         if ! grep -qx "$2" $AAP; then new=1; setcfg "TEXA_$2" 1; echo "$2" >> $AAP; fi
         setcfg "TEX_$2" "$3|$4"; echo "$2" > $DIR/tex_cur
         [ $new = 1 ] && angle_compose; angle_prop_apply; am force-stop "$2" >/dev/null 2>&1
         [ $new = 1 ] && ui_restart
         tex_verify "$2";;
    off) angle_pkg_ok "$2" || { echo "ERR|nama paket tidak valid"; return 1; }
         auto=$(getcfg "TEXA_$2"); tex_forget "$2"
         if [ "$auto" = 1 ]; then angle_app del "$2" >/dev/null; ui_restart; else angle_prop_apply; am force-stop "$2" >/dev/null 2>&1; fi
         echo OK;;
    cur) angle_pkg_ok "$2" && tex_cur "$2"; echo OK;;
    *) echo "ERR|perintah tex tidak dikenal"; return 1;;
  esac
}
angle_app(){ # add <paket> | del <paket> | all | clear
  case "$1" in
    add) angle_pkg_ok "$2" || { echo "ERR|nama paket tidak valid"; return 1; }
         [ -f $AAP ] || : > $AAP
         grep -qx "$2" $AAP || echo "$2" >> $AAP
         angle_compose; angle_prop_apply; am force-stop "$2" >/dev/null 2>&1; echo OK;;
    del) angle_pkg_ok "$2" || { echo "ERR|nama paket tidak valid"; return 1; }
         [ -f $AAP ] && { grep -vx "$2" $AAP > $AAP.t; mv $AAP.t $AAP; }
         tex_forget "$2"; angle_compose "$2"; angle_regame; angle_prop_apply; am force-stop "$2" >/dev/null 2>&1; echo OK;;
    all) [ -f $AAP ] || : > $AAP
         for g in $(cat $DIR/games.txt 2>/dev/null); do angle_pkg_ok "$g" && { grep -qx "$g" $AAP || echo "$g" >> $AAP; }; done
         angle_compose; angle_prop_apply; echo OK;;
    clear) old=$(cat $AAP 2>/dev/null | tr '\n' ' '); for g in $old; do tex_forget "$g"; done; rm -f $AAP
         angle_compose "$old"; angle_regame; angle_prop_apply; echo OK;;
    *) echo "ERR|perintah angle_app tidak dikenal"; return 1;;
  esac
}
angle_boot(){ # properti hilang tiap reboot -> terapkan ulang; daftar settings digabung lagi supaya konsisten
  rm -f $AAO
  [ -s $AAP ] && { angle_compose; angle_prop_apply; }
  return 0
}

# ---------- PERAWATAN: cache & trim, warna layar, overhead debug ----------
# Cache : `cmd package trim-caches` (API resmi PackageManager) -> hanya cache; data dan login tidak disentuh.
# Trim  : fstrim di latar (tidak memblokir WebUI).
# Warna : transaksi debug SurfaceFlinger 1022 (saturasi) dan 1015 (matriks warna RGB). Disimpan di config (COL_*), diterapkan ulang saat boot;
#         bisa tertimpa Night Light/mode warna bawaan ROM. Batas aman: saturasi 50-200%, RGB 50-100%.
# Debug : mematikan statistik debug yang berjalan terus (looper stats, binder calls stats); dinyalakan lagi bila fitur dimatikan.
free_kb(){ set -- $(df -k /data 2>/dev/null | tail -1); if [ $# -ge 6 ]; then echo $4; else echo $3; fi; }
cache_clean(){ b=$(free_kb); cmd package trim-caches 9999G >/dev/null 2>&1; sync; a=$(free_kb); echo "OK|$(( ${a:-0} - ${b:-0} ))"; }
trim_run(){ ( for m in /data /cache /metadata; do [ -d $m ] && fstrim $m >/dev/null 2>&1; done ) >/dev/null 2>&1 & echo OK; }
pct_ok(){ case "$1" in ''|*[!0-9]*) return 1;; esac; [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
pf(){ printf '%d.%02d' $(( $1 / 100 )) $(( $1 % 100 )); }   # 125 -> 1.25
color_apply(){
  s=$(getcfg COL_SAT); r=$(getcfg COL_R); g=$(getcfg COL_G); b=$(getcfg COL_B)
  s=${s:-100}; r=${r:-100}; g=${g:-100}; b=${b:-100}
  service call SurfaceFlinger 1022 f $(pf $s) >/dev/null 2>&1
  if [ "$r$g$b" = 100100100 ]; then service call SurfaceFlinger 1015 i32 0 >/dev/null 2>&1
  else service call SurfaceFlinger 1015 i32 1 f $(pf $r) f 0 f 0 f 0 f 0 f $(pf $g) f 0 f 0 f 0 f 0 f $(pf $b) f 0 f 0 f 0 f 0 f 1 >/dev/null 2>&1; fi
}
color_set(){ # saturasi% r% g% b%
  pct_ok "$1" 50 200 && pct_ok "$2" 50 100 && pct_ok "$3" 50 100 && pct_ok "$4" 50 100 || { echo "ERR|nilai di luar batas"; return 1; }
  setcfg COL_SAT $1; setcfg COL_R $2; setcfg COL_G $3; setcfg COL_B $4; color_apply; echo OK
}
color_reset(){ for k in COL_SAT COL_R COL_G COL_B; do grep -v "^$k=" $CFG > $CFG.t; mv $CFG.t $CFG; done; color_apply; echo OK; }
color_boot(){ [ -n "$(getcfg COL_SAT)$(getcfg COL_R)$(getcfg COL_G)$(getcfg COL_B)" ] && color_apply; return 0; }
dbg_off(){ cmd looper_stats disable >/dev/null 2>&1; dumpsys binder_calls_stats --disable >/dev/null 2>&1; dumpsys binder_calls_stats --disable-detailed-tracking >/dev/null 2>&1; atrace --async_stop >/dev/null 2>&1
  # brutal: hentikan tracing kernel + perfetto (traced) yang jalan di latar
  for _t in /sys/kernel/tracing/tracing_on /sys/kernel/debug/tracing/tracing_on; do [ -w $_t ] && echo 0 > $_t 2>/dev/null; done
  setprop debug.atrace.tags.enableflags 0 >/dev/null 2>&1
  mkdir -p $DIR; : > $DIR/dbg.off
  stop traced_probes >/dev/null 2>&1; stop traced >/dev/null 2>&1
  return 0; }
dbg_on(){ cmd looper_stats enable >/dev/null 2>&1; dumpsys binder_calls_stats --enable >/dev/null 2>&1
  if [ -f $DIR/dbg.off ]; then start traced >/dev/null 2>&1; start traced_probes >/dev/null 2>&1; rm -f $DIR/dbg.off; fi
  return 0; }

# ---------- STATUS (dibaca WebUI) ----------
cl(){ # baris status yang tetap selama HP hidup: hitung sekali, simpan sampai reboot (cache c.* dibuang saat boot); hasil kosong tidak disimpan
  k=$1; shift; f=$DIR/c.s.$k
  if [ ! -s $f ]; then "$@" > $f.t 2>/dev/null; if [ -s $f.t ]; then mv -f $f.t $f; else cat $f.t; rm -f $f.t; return; fi; fi
  cat $f
}
dev_line(){ echo "DEV|$(getprop ro.product.brand)|$(getprop ro.product.model)|$(soc)|$(uname -r)|$(getprop ro.build.version.release)|$(gpu_type)"; }
chipz_line(){ echo "CHIPZ|$(grep -qa SOC_MODEL $MODD/zygisk/arm64-v8a.so 2>/dev/null && echo yes || echo no)"; }
# ---------- STATUS untuk notifikasi (aplikasi Comatoze membaca aliran ini lewat satu proses su) ----------
# ST|mode|ingame(0/1)|thermal-mati(0/1)|paket game|CPU MHz tertinggi|GPU MHz|suhu C (terpanas)|baterai %|mengisi(0/1)
statline(){
  _m=$(curmode); [ -n "$_m" ] || _m=balance
  _i=0; _p=; if [ -f $DIR/ingame ]; then _i=1; read -r _p 2>/dev/null < $DIR/ingame; fi
  _t=0; { [ "$(getcfg THERMAL)" = off ] || [ -f $DIR/gth_on ]; } && _t=1
  _c=0; for _f in $CPU/policy*/scaling_cur_freq; do read -r _v 2>/dev/null < $_f || continue; case $_v in ''|*[!0-9]*) continue;; esac; [ "$_v" -gt "$_c" ] && _c=$_v; done
  _gl=$(gpu_live); _g=${_gl%%|*}; case $_g in ''|*[!0-9]*) _g=0;; esac
  _x=0; for _z in /sys/class/thermal/thermal_zone*/temp; do read -r _v 2>/dev/null < $_z || continue; case $_v in ''|*[!0-9]*) continue;; esac; [ "$_v" -gt 1000 ] && _v=$((_v/1000)); [ "$_v" -lt 120 ] && [ "$_v" -gt "$_x" ] && _x=$_v; done
  read -r _b 2>/dev/null < $BAT/capacity; plugged && _ch=1 || _ch=0
  echo "ST|$_m|$_i|$_t|$_p|$((_c/1000))|$((_g/1000000))|$_x|${_b:-0}|$_ch"
}
statloop(){ while :; do statline; sleep 2; done; }
app_perm(){ # beri izin tampil-di-atas-app (crosshair) + notifikasi + latar ke aplikasi Comatoze tanpa dialog (root)
  appops set com.comatoze SYSTEM_ALERT_WINDOW allow >/dev/null 2>&1
  pm grant com.comatoze android.permission.POST_NOTIFICATIONS >/dev/null 2>&1
  for _o in RUN_IN_BACKGROUND RUN_ANY_IN_BACKGROUND START_FOREGROUND; do appops set com.comatoze $_o allow >/dev/null 2>&1; done
  cmd deviceidle whitelist +com.comatoze >/dev/null 2>&1   # baterai: Tanpa batasan
  cmd deviceidle sys-whitelist +com.comatoze >/dev/null 2>&1
  am set-standby-bucket com.comatoze active >/dev/null 2>&1
  am set-bg-restriction-level --user 0 com.comatoze unrestricted >/dev/null 2>&1   # Android 14+: baterai "Tanpa batasan"
  cmd appops set com.comatoze RUN_ANY_IN_BACKGROUND allow >/dev/null 2>&1
  am start-foreground-service -n com.comatoze/.StatusService >/dev/null 2>&1; }   # notifikasi status hidup sejak boot (tanpa buka app)
# ram_keep: paket yang TIDAK boleh dimatikan pembersih RAM (Comatoze, app di depan/game, keyboard aktif, launcher) supaya UI tidak patah/hilang.
ram_keep(){ _kp="com.comatoze $(game_fg)"
  _ime=$(sget secure default_input_method 2>/dev/null); case $_ime in null|'') ;; *) _kp="$_kp ${_ime%%/*}";; esac
  _hl=$(cmd package resolve-activity --brief -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null | tail -n 1); case $_hl in */*) _kp="$_kp ${_hl%%/*}";; esac
  echo $_kp; }
# ram_purge full|light: full = hentikan semua app pihak ketiga (selain ram_keep) + proses cache + cache kernel; light = hanya proses cache + cache kernel.
# Urutan sengaja: matikan proses dulu, baru pangkas cache, flush, buang page cache & padatkan memori (supaya blok kontigu besar tersedia lagi).
ram_purge(){
  _keep=" $(ram_keep) "
  if [ "$1" = full ]; then
    for _p in $(pm list packages -3 2>/dev/null | sed 's/^package://'); do case "$_keep" in *" $_p "*) continue;; esac; am force-stop $_p >/dev/null 2>&1; done
  fi
  am kill-all >/dev/null 2>&1; cmd activity kill-all >/dev/null 2>&1
  [ "$1" = full ] && pm trim-caches 999G >/dev/null 2>&1
  sync; w 3 /proc/sys/vm/drop_caches; w 1 /proc/sys/vm/compact_memory
  w 3 /proc/sys/vm/drop_caches
  [ -w /proc/sys/vm/compact_memory ] && w 1 /proc/sys/vm/compact_memory
}
qact(){ case $1 in
  clean) _b=$(meminfo_kb MemAvailable); ram_purge full; sleep 1; _a=$(meminfo_kb MemAvailable); _f=$(( (_a-_b)/1024 )); [ "$_f" -lt 0 ] && _f=0
    echo "OK|RAM dibersihkan (+${_f} MB)";;
  trim) pm trim-caches 999G >/dev/null 2>&1; sync; w 3 /proc/sys/vm/drop_caches; w 1 /proc/sys/vm/compact_memory; cmd package bg-dexopt-job >/dev/null 2>&1 & echo "OK|cache dipangkas";;
  killbg) ram_purge full; echo "OK|aplikasi latar dihentikan";;
  *) echo "ERR|aksi tidak dikenal";;
esac; }
# ---------- UNREAL ENGINE: kualitas grafis game UE lewat Engine.ini (sg.* scalability) ----------
# Level 0-4 (Terendah, Rendah, Sedang, Tinggi, Ultra). Engine.ini game dicadangkan dulu ($f.comatoze.bak), blok kita diberi penanda & dibuang/dipulihkan saat "off".
# Dibaca lewat /data/media/0 (root) supaya tidak terhalang FUSE Android/data. TIDAK semua game UE mengikuti sg.* (sebagian memakai pengaturan sendiri).
UEB=/data/media/0/Android/data
ue_cfgdir(){ [ -d $UEB/$1 ] || return 1
  _d=$(find $UEB/$1 -maxdepth 8 -type d -path '*Saved/Config/Android' 2>/dev/null | head -n 1)
  [ -n "$_d" ] && { echo "$_d"; return 0; }
  _sv=$(find $UEB/$1 -maxdepth 6 -type d -name Saved 2>/dev/null | head -n 1)
  [ -n "$_sv" ] && { echo "$_sv/Config/Android"; return 0; }
  return 1; }
ue_is(){ [ -d $UEB/$1 ] || return 1; find $UEB/$1 -maxdepth 8 \( -path '*Saved/Config*' -o -name '*.pak' -o -name UnrealGame -o -name UE4Game -o -name UE5Game \) 2>/dev/null | head -n 1 | grep -q .; }
ue_list(){ _o=; for _p in $(cat $DIR/games.txt 2>/dev/null); do
    if ue_is $_p; then _o="$_o$_p~ue~$(getcfg UE_$_p);"; fi; done; echo "UE|${_o%;}"; }
ue_apply(){ # pkg level
  case $1 in *[!A-Za-z0-9._]*|'') echo "ERR|paket tidak valid"; return;; esac
  case $2 in 0|1|2|3|4) ;; *) echo "ERR|level 0-4"; return;; esac
  _cd=$(ue_cfgdir $1) || { echo "ERR|data game belum ada (buka game sekali dulu) atau bukan Unreal Engine"; return; }
  mkdir -p "$_cd" 2>/dev/null; _f="$_cd/Engine.ini"
  _own=$(stat -c %u:%g "$(dirname "$_cd")" 2>/dev/null)
  if [ ! -f "$_f.comatoze.bak" ] && [ ! -f "$_f.comatoze.new" ]; then if [ -f "$_f" ]; then cp -p "$_f" "$_f.comatoze.bak"; else : > "$_f.comatoze.new"; fi; fi
  case $2 in 0) _n=0; _sp=75;; 1) _n=1; _sp=85;; 2) _n=2; _sp=100;; 3) _n=3; _sp=100;; 4) _n=3; _sp=100;; esac
  [ -f "$_f" ] && chmod 644 "$_f" 2>/dev/null
  # buang blok lama kita (jika ada) lalu tulis blok baru
  [ -f "$_f" ] && sed -i '/^; COMATOZE-UE BEGIN/,/^; COMATOZE-UE END/d' "$_f" 2>/dev/null
  { echo; echo "; COMATOZE-UE BEGIN"; echo "[SystemSettings]"
    for _g in ViewDistance AntiAliasing Shadow PostProcess Texture Effects Foliage Shading; do echo "sg.${_g}Quality=$_n"; done
    echo "r.ScreenPercentage=$_sp"
    [ "$2" = 4 ] && { echo "r.MaxAnisotropy=16"; echo "r.ViewDistanceScale=1.5"; }
    [ "$2" = 0 ] && { echo "r.ViewDistanceScale=0.6"; echo "r.Shadow.MaxResolution=512"; }
    echo "; COMATOZE-UE END"; } >> "$_f"
  [ -n "$_own" ] && chown $_own "$_cd" "$_f" 2>/dev/null; chmod 444 "$_f" 2>/dev/null; restorecon "$_f" >/dev/null 2>&1
  setcfg "UE_$1" "$2"; am force-stop $1 >/dev/null 2>&1; echo "OK|grafis UE level $2 diterapkan - buka ulang game"; }
ue_off(){ case $1 in *[!A-Za-z0-9._]*|'') echo "ERR|paket tidak valid"; return;; esac
  _cd=$(ue_cfgdir $1) || { setcfg "UE_$1" ""; echo "OK|dikembalikan"; return; }; _f="$_cd/Engine.ini"
  chmod 644 "$_f" 2>/dev/null
  if [ -f "$_f.comatoze.bak" ]; then cat "$_f.comatoze.bak" > "$_f"; rm -f "$_f.comatoze.bak"
  elif [ -f "$_f.comatoze.new" ]; then rm -f "$_f" "$_f.comatoze.new"
  elif [ -f "$_f" ]; then sed -i '/^; COMATOZE-UE BEGIN/,/^; COMATOZE-UE END/d' "$_f" 2>/dev/null; fi
  setcfg "UE_$1" ""; am force-stop $1 >/dev/null 2>&1; echo "OK|grafis UE dikembalikan"; }
ue_compile(){ case $1 in *[!A-Za-z0-9._]*|'') return;; esac; cmd package compile -m speed -f $1 >/dev/null 2>&1; echo "$(date +%s)" > $DIR/uec.$1; }
ue(){ case $1 in
  list) ue_list;;
  set) ue_apply "$2" "$3";;
  off) ue_off "$2";;
  compile) case $2 in *[!A-Za-z0-9._]*|'') echo "ERR|paket tidak valid";; *) bgx ue_compile "$2"; echo "OK|rekompilasi berjalan di latar (beberapa menit)";; esac;;
  *) echo "ERR|perintah ue tidak dikenal";;
esac; }
# ---------- IDLE RAM saat TIDAK ada game aktif, bila RAM bebas < batas -> padatkan memori + buang cache bersih ----------
# Config: IDLE_RAM on|off, IDLE_MIN (MB, 128-8192, bawaan 2048), IDLE_INT (menit, 1-120, bawaan 5)
idleram_run(){ echo $$ > $DIR/idleram.pid
  while :; do
    _i=$(getcfg IDLE_INT); case $_i in ""|*[!0-9]*) _i=5;; esac; [ "$_i" -lt 1 ] && _i=1; [ "$_i" -gt 120 ] && _i=120
    sleep $((_i*60))
    [ "$(getcfg IDLE_RAM)" = on ] || break
    [ -f $DIR/ingame ] && continue
    _m=$(getcfg IDLE_MIN); case $_m in ""|*[!0-9]*) _m=2048;; esac
    _fa=$(meminfo_kb MemAvailable); _fa=$((_fa/1024))
    if [ "$_fa" -lt "$_m" ]; then
      ram_purge light; _fb=$(meminfo_kb MemAvailable); _fb=$((_fb/1024)); _tg=light
      if [ "$_fb" -lt "$_m" ]; then ram_purge full; _fb=$(meminfo_kb MemAvailable); _fb=$((_fb/1024)); _tg=penuh; fi   # masih kurang -> hentikan app latar juga
      echo "$(date +%H:%M:%S) bebas ${_fa}MB < ${_m}MB -> ${_tg} -> ${_fb}MB" > $DIR/idleram.last
    fi
  done
  rm -f $DIR/idleram.pid; }
idleram(){ case $1 in
  on) setcfg IDLE_RAM on; [ -f $DIR/idleram.pid ] && kill -0 $(cat $DIR/idleram.pid) 2>/dev/null || bg idleram_run; echo "OK|Idle RAM aktif";;
  off) setcfg IDLE_RAM off; [ -f $DIR/idleram.pid ] && kill $(cat $DIR/idleram.pid) 2>/dev/null; rm -f $DIR/idleram.pid; echo "OK|Idle RAM mati";;
  set) case $2 in min) case $3 in ""|*[!0-9]*) echo "ERR|angka tidak valid"; return;; esac; [ "$3" -ge 128 ] && [ "$3" -le 8192 ] || { echo "ERR|128-8192 MB"; return; }; setcfg IDLE_MIN $3;;
         int) case $3 in ""|*[!0-9]*) echo "ERR|angka tidak valid"; return;; esac; [ "$3" -ge 1 ] && [ "$3" -le 120 ] || { echo "ERR|1-120 menit"; return; }; setcfg IDLE_INT $3;;
         *) echo "ERR|kunci tidak dikenal"; return;; esac; echo "OK|tersimpan";;
  *) _r=stop; [ -f $DIR/idleram.pid ] && kill -0 $(cat $DIR/idleram.pid) 2>/dev/null && _r=run; echo "IDLERAM|$(getcfg IDLE_RAM)|$(getcfg IDLE_MIN)|$(getcfg IDLE_INT)|$_r|$(cat $DIR/idleram.last 2>/dev/null)";;
esac; }
# ---------- CROSSHAIR (overlay bidik tidak bisa disentuh). Aktif hanya sesi ini (reset tiap boot, anti burn-in) ----------
# CH_STYLE: dot cross crossdot tcross x circle brackets chevron diamond pulse spin | CH_COLOR: hex 6 digit
ch_svc(){ am start-foreground-service --user 0 -n com.comatoze/.CrosshairService "$@" >/dev/null 2>&1 || am startservice --user 0 -n com.comatoze/.CrosshairService "$@" >/dev/null 2>&1; }
ch_get(){ _v=$(getcfg "$1"); echo "${_v:-$2}"; }
crosshair(){ case $1 in
  on) app_perm; setcfg CH_ON on; ch_svc --ez reload true; echo "OK|crosshair aktif";;
  off) setcfg CH_ON off; am stopservice --user 0 -n com.comatoze/.CrosshairService >/dev/null 2>&1; echo "OK|crosshair mati";;
  next) case $2 in
      style) _l="dot cross crossdot tcross x circle brackets chevron diamond pulse spin"; _k=CH_STYLE; _c=$(ch_get CH_STYLE cross);;
      color) _l="FF3B30 FF9500 FFD60A 34C759 2EDCFF 3B9BFF AF52DE FFFFFF"; _k=CH_COLOR; _c=$(ch_get CH_COLOR FF3B30);;
      *) echo "ERR|style atau color"; return;;
    esac
    _f=; _n=; _1=; for _i in $_l; do [ -n "$_1" ] || _1=$_i; if [ -n "$_f" ]; then _n=$_i; break; fi; [ "$_i" = "$_c" ] && _f=1; done
    [ -n "$_n" ] || _n=$_1
    setcfg $_k "$_n"; [ "$(getcfg CH_ON)" = on ] && ch_svc --ez reload true; echo "OK|$_n";;
  reset) for _k in CH_STYLE CH_COLOR CH_SIZE CH_TH CH_GAP CH_OP CH_GLOW CH_SPD CH_OX CH_OY CH_OUT CH_DOT; do setcfg $_k ""; done; [ "$(getcfg CH_ON)" = on ] && ch_svc --ez reload true; echo "OK|bawaan dipulihkan";;
  set) _k=$2; _v=$3
    case $_k in
      style) case $_v in dot|cross|crossdot|tcross|x|circle|brackets|chevron|diamond|pulse|spin) ;; *) echo "ERR|gaya tidak dikenal"; return;; esac;;
      color) case $_v in [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;; *) echo "ERR|warna harus 6 digit hex"; return;; esac;;
      size|th|gap|op|glow|spd|ox|oy) case $_v in ""|*[!0-9.-]*) echo "ERR|angka tidak valid"; return;; esac;;
      out|dot) case $_v in 0|1) ;; *) echo "ERR|0 atau 1"; return;; esac;;
      *) echo "ERR|kunci tidak dikenal"; return;;
    esac
    setcfg "CH_$(echo $_k | tr a-z A-Z)" "$_v"; [ "$(getcfg CH_ON)" = on ] && ch_svc --ez reload true; echo "OK|tersimpan";;
  *) echo "CH|$(getcfg CH_ON)|$(ch_get CH_STYLE cross)|$(ch_get CH_COLOR FF3B30)|$(ch_get CH_SIZE 30)|$(ch_get CH_TH 2)|$(ch_get CH_GAP 6)|$(ch_get CH_OP 90)|$(ch_get CH_GLOW 50)|$(ch_get CH_SPD 1)|$(ch_get CH_OX 0)|$(ch_get CH_OY 0)|$(ch_get CH_OUT 1)|$(ch_get CH_DOT 0)";;
esac; }
status(){
  SC=1
  echo "MODE|$(getcfg MODE)"
  echo "BAT|$(rd $BAT/capacity)|$(rd $BAT/status)|$(rd $BAT/current_now)|$(rd $BAT/temp)|$(rd $BAT/voltage_now)|$(chg_ready && grep -c . $DIR/chgn)|$(getcfg CUT)"
  echo "CHGM|$(cut -d'|' -f1 $DIR/chgm 2>/dev/null | sed 's#.*/\([^/]*/[^/]*\)$#\1#' | tr '\n' ',')|$(cat $DIR/chgheld 2>/dev/null)|$(cat $DIR/chgfail 2>/dev/null)|$(cat $DIR/chgq 2>/dev/null | tr '|' ':')"
  echo "PROF|$([ -f $DIR/prof_on ] && echo on || echo off)"
  echo "FP|$(fstate framepace)|$([ -f $DIR/fp_on ] && echo 1 || echo 0)|$(cat $DIR/fp.res 2>/dev/null || echo 0\|0\|0\|0)|$(fp_support)"
  echo "UIRST|$(getcfg UI_RST)"
  f2fs_status
  mt=0; ma=0; while IFS=' ' read -r _k _v _u; do case $_k in MemTotal:) mt=$_v;; MemAvailable:) ma=$_v; break;; esac; done < /proc/meminfo
  echo "RAM|$([ $mt -gt 0 ] && echo $(( (100*(mt-ma))/mt )) || echo 0)|$((mt/1024))|$((ma/1024))"
  idleram status; crosshair status
  echo "RATES|$(rates)"
  echo "GPCFG|$(getcfg GP_MODE)|$(getcfg GP_HZ)"
  echo "GFX|$(getcfg GFX_SCALE)|$(getcfg GFX_DRV)|$(getcfg GFX_ANGLE)"
  echo "COLOR|$(getcfg COL_SAT)|$(getcfg COL_R)|$(getcfg COL_G)|$(getcfg COL_B)"
  tex_status
  echo "ANGLE|x|$(angle_ok && echo yes || echo no)|$(cat $AAP 2>/dev/null | tr '\n' ';' | sed 's/;$//')"
  echo "DNS|$(getcfg DNS)|$(getcfg DNS_H)|$(sget global private_dns_mode)|$(sget global private_dns_specifier)"
  gfxa=""; for p in $(cat $DIR/games.txt 2>/dev/null); do v=$(getcfg "GFXS_$p"); [ -n "$v" ] && gfxa="$gfxa,$p:$v"; done
  echo "GFXA|${gfxa#,}"
  gpa=""; for p in $(cat $DIR/games.txt 2>/dev/null); do a=$(getcfg "GPM_$p"); b=$(getcfg "GPH_$p"); [ -n "$a$b" ] && gpa="$gpa,$p~$a~$b"; done
  echo "GPROF|${gpa#,}"
  _a=0; [ -f $DIR/game.pid ] && kill -0 $(cat $DIR/game.pid) 2>/dev/null && _a=1
  echo "GWD|$_a|$([ -f $DIR/ingame ] && echo 1 || echo 0)|$(grep -c . $DIR/games.txt 2>/dev/null || echo 0)|$(tail -n 1 $DIR/game.log 2>/dev/null | tr -d '|')"
  echo "GAMES|$(cat $DIR/games.txt 2>/dev/null | tr '\n' ' ')"
  cl chipz chipz_line
  echo "SPOOFZ|$([ -f $MODD/zygisk/arm64-v8a.so ] && echo yes || echo no)"
  echo "SPOOFAPPS|$(awk -F'|' 'NF>=4{o=($5==""?1:$5);f=($6==""?0:$6);printf "%s%s~%s~%s~%s~%s~%s~%s~%s~%s~%s",(n++?";":""),$1,$2,$3,$4,o,f,$7,$8,$9,$10}' $SPA 2>/dev/null)"
  cl dev dev_line
  caps
  zram_status
  dram_status
  ged_status
  dexopt_status
  echo "THERMRUN|$(n=0; for a in $(thermal_svcs); do [ "$(getprop init.svc.$a)" = running ] && n=$((n+1)); done; echo $n)"
  dpi_info
  cool_status
  echo "IOS|$(ios_cur)|$(ios_list | tr ' ' ',')"
  echo "REND|$(getcfg RENDERER)"
  for f in $FEATS; do echo "FEAT|$f|$(fstate $f)"; done
  echo "FPSGOSUP|$(fpsgo_supported)"
  for p in $CPU/policy*; do
    [ -d $p ] || continue
    imin=$(rd $p/cpuinfo_min_freq); imax=$(rd $p/cpuinfo_max_freq)
    fr=$(rd $p/scaling_available_frequencies); [ -z "$fr" ] && fr="$imin $imax"
    echo "CPU|$(basename $p)|$(rd $p/scaling_governor)|$(rd $p/scaling_min_freq)|$(rd $p/scaling_max_freq)|$(rd $p/scaling_cur_freq)|$(rd $p/scaling_available_governors)|$fr|$(rd $p/related_cpus)"
  done
  if [ -z "$GPU" ] && [ -f $GP/gpufreq_opp_freq ]; then
    echo "GPUP|$(gp_freqs | tr '\n' ' ')"
  fi
  if [ -n "$GPU" ]; then
    # cur_freq devfreq = previous_freq yang bisa basi (GPU idle/clock-gated, atau min/max baru diubah) dan bisa lebih rendah dari min_freq.
    # min_freq/max_freq adalah batas efektif, jadi nilai "sekarang" dijepit ke rentang itu. Adreno (kgsl): pakai gpuclk (clock nyata) bila ada.
    gmn=$(rd $GPU/min_freq); gmx=$(rd $GPU/max_freq); gc=$(rd $GPU/cur_freq)
    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then k=$(rd /sys/class/kgsl/kgsl-3d0/gpuclk); case $k in ''|0|*[!0-9]*) ;; *) gc=$k;; esac; fi
    isnum(){ case $1 in ''|*[!0-9]*) return 1;; esac; }
    gl=$(gpu_live); glv=${gl%%|*}; gls=${gl#*|}
    if isnum "$glv" && [ "$gls" != devfreq ]; then gc=$glv   # clock nyata dari sumber andal, tidak dijepit ke min/max devfreq (yang bisa basi)
    elif isnum "$gc" && isnum "$gmn" && isnum "$gmx"; then
      [ "$gc" -lt "$gmn" ] && gc=$gmn
      [ "$gc" -gt "$gmx" ] && gc=$gmx
    fi
    echo "GPU|$GPU|$(rd $GPU/governor)|$gmn|$gmx|$gc|$(rd $GPU/available_governors)|$(rd $GPU/available_frequencies)|"
  fi
}

boot(){
  # Migrasi: fitur downscale game sudah dihapus. Bila dulu pernah diset, kembalikan resolusi game ke normal lalu bersihkan config.
  g=$(getcfg GSCALE)
  if [ -n "$g" ]; then
    [ "$g" != 100 ] && for p in $(cat $DIR/games.txt 2>/dev/null); do cmd game reset $p >/dev/null 2>&1; done
    grep -v '^GSCALE=' $CFG > $CFG.t; mv $CFG.t $CFG
  fi
  rm -f $DIR/adoze.pid $DIR/f2fs.pid $DIR/f2fs.run $DIR/c.* $TS.* $TB.* $PXV $PXV2 $EXV   # sysfs/props baru saja di-reset oleh boot: buang catatan lama
  [ "$(getcfg THERMAL)" = "off" ] && thermal off
  bgx thr_scan   # siapkan daftar node *throttling* di latar supaya klik Disable Thermal pertama sudah cepat
  [ "$(getcfg F_doze)" = off ] || doze_tune on >/dev/null 2>&1   # Doze Mode aktif secara bawaan: ikut konstanta yang dipercepat
  for f in datasaver wifilatency touchboost lessdbg bkt smooth fpsgooff gmslimit aggrdoze f2fsgc; do v=$(getcfg F_$f); [ -n "$v" ] && feat $f $v; done
  [ -f $DIR/guard.pid ] && kill $(cat $DIR/guard.pid) 2>/dev/null
  [ -f $RHZW.pid ] && kill $(cat $RHZW.pid) 2>/dev/null
  [ -f $CPUW.pid ] && kill $(cat $CPUW.pid) 2>/dev/null
  rm -f $DIR/guard.pid $DIR/guard_hot $DIR/chgn $DIR/chgd $DIR/nonodes $DIR/chgsave $DIR/ingame $DIR/prof_on $DIR/gth_on $DIR/fp_on $DIR/fpvals $DIR/fpprops $DIR/fpsgo_ro $DIR/eco_ppm $DIR/fp.res $COOL.pid $COOL.end $COOL.cancel $RHZW.pid $CPUW.pid
  chg_sync; game_sync; gfx_apply_all
  ios_boot; rend_boot
  [ -n "$(getcfg GED_LV)" ] && ged_set "$(getcfg GED_LV)" >/dev/null 2>&1
  [ -n "$(getcfg DRAM_LOCK)" ] && dram_lock "$(getcfg DRAM_LOCK)" >/dev/null 2>&1   # devfreq kembali ke bawaan saat boot: pasang lagi kunci DRAM
  if [ -f $ZR.applying ]; then   # penerapan ZRAM sebelumnya terputus (mis. reboot) -> jangan diulang otomatis, lepas dari config
    rm -f $ZR.applying $ZR.pid; setcfg ZRAM ""; echo "error|boot|penerapan sebelumnya terputus - ZRAM kembali ke bawaan ROM" > $ZR.state
  elif [ -n "$(getcfg ZRAM)" ]; then bgx zram_run "$(getcfg ZRAM)"; fi
  angle_boot
  color_boot
  dk=$(getcfg DNS); [ -n "$dk" ] && dns_set "$dk" "$(getcfg DNS_H)" >/dev/null
  ( sleep 20; app_perm ) >/dev/null 2>&1 &   # izin latar/crosshair selalu dipasang ulang tiap boot
  # Migrasi: fitur overlay sudah dihapus. Bersihkan sisa config lama.
  grep -v -e "^OV_" -e "^REC_" $CFG > $CFG.t 2>/dev/null && mv $CFG.t $CFG
  rm -f $DIR/ovdiag.txt $DIR/recstop
  setcfg CH_ON off   # crosshair selalu mati saat boot (anti burn-in)
  [ "$(getcfg IDLE_RAM)" = on ] && bg idleram_run
  # Migrasi: fitur overlay FPS (aplikasi UltraFPS) sudah dihapus. Bersihkan sisa lama bila ada.
  [ -f $DIR/fps.pid ] && kill $(cat $DIR/fps.pid) 2>/dev/null; rm -f $DIR/fps.pid $DIR/layers
  [ -d /data/data/com.ultrapower.fps ] && pm uninstall com.ultrapower.fps >/dev/null 2>&1
  grep -v "^F_fpsoverlay=" $CFG > $CFG.t 2>/dev/null && mv $CFG.t $CFG
  m=$(getcfg MODE)
  if [ "$m" = "custom" ]; then
    batsaver custom
    while IFS='|' read -r k a; do [ -n "$a" ] && NOSAVE=1 sh $SELF $a; done < $CUS
  else
    [ "$m" = auto ] && m=balance
    set_mode "$m"
  fi
}

# perintah apa pun selain status: buang cache pendek supaya hasilnya langsung terbaca. Pengecualian (tidak mengubah DNS/zen_mode/DPI yang
# dibaca status lewat cache itu): mode, thermal, dan feat selain dnd/hzlock120 -> status sesudah klik tidak perlu memanggil `settings`/`wm` (Java, lambat) lagi.
case "$1" in
  status|mode|thermal) ;;
  feat) { [ "$2" = dnd ] || [ "$2" = hzlock120 ]; } && rm -f $DIR/c.t.* 2>/dev/null;;
  *) rm -f $DIR/c.t.* 2>/dev/null;;
esac
case "$1" in
  mode) set_mode $2; [ -f $DIR/fp_on ] && fp_on; game_sync;;
  thermal) thermal $2;;
  thermal_check) for a in $(thermal_svcs); do echo "$a $(getprop init.svc.$a)"; done;;
  feat) feat $2 $3;;
  cpu_gov) cpu_gov $2 $3;;
  cpu_freq) cpu_freq $2 $3 $4;;
  refresh) refresh $2;;
  refresh_wd) refresh_wd;;
  rlearn) rlearn $2 $3 $4;;
  cpu_wd) cpu_wd;;
  gpu_fix) gpu_fix $2;;
  gpu_gov) gpu_gov $2;;
  gpu_freq) gpu_freq $2 $3;;
  status) status;;
  cut) setcfg CUT $2;;
  games) games $2 $3;;
  gfx_scale) gfx_scale $2 $3;;
  gfx_scale_reset) gfx_scale_reset $2;;
  gfx_driver) gfx_driver $2; ui_restart;;
  gfx_angle) gfx_angle $2; ui_restart;;
  tex) tex $2 $3 $4 $5;;
  texcur) tex cur $2;;
  angle_app) angle_app $2 $3; ui_restart;;
  idleram) idleram $2 $3 $4;;
  idleram_run) idleram_run;;
  crosshair) crosshair $2 $3 $4;;
  uirst) case $2 in on|off) setcfg UI_RST $2; echo "OK|restart UI $2";; now) rm -f $DIR/uirst; setcfg UI_RST on; ui_restart; echo "OK|UI dimuat ulang";; *) echo "UIRST|$(getcfg UI_RST)";; esac;;
  cache) cache_clean;;
  trim) trim_run;;
  color) case $2 in set) color_set $3 $4 $5 $6;; reset) color_reset;; *) echo "ERR|perintah color tidak dikenal";; esac;;
  gp_cfg) setcfg GP_$(echo $2 | tr a-z A-Z) $3;;
  gp_game) gp_game $2 $3 $4;;
  gdiag) gdiag;;
  ver) ver_check;;
  fixboot) fixboot;;
  lagrec) lagrec;;
  lagrec_run) lagrec_run;;
  chg_wd) chg_wd;;
  chgreset) chg_reset;;
  game_wd) game_wd;;
  probe) probe;;
  qact) qact $2;;
  appperm) app_perm;;
  dexopt) case $2 in start) dexopt_start $3;; stop) dexopt_stop;; *) echo "ERR|perintah dexopt tidak dikenal";; esac;;
  dexopt_run) dexopt_run $2;;
  adoze_wd) adoze_wd;;
  f2fs_wd) f2fs_wd;;
  f2fs_run) f2fs_gc_run;;
  f2fsgc) case $2 in run) bgx f2fs_run; echo "OK|GC dijalankan di latar";; *) f2fs_status;; esac;;
  iosched) case $2 in set) ios_set $3;; *) echo "IOS|$(ios_cur)|$(ios_list | tr ' ' ',')";; esac;;
  renderer) rend_apply $2; ui_restart;;
  zram) case $2 in start) zram_start $3;; *) echo "ERR|perintah zram tidak dikenal";; esac;;
  zram_run) zram_run $2;;
  dram) case $2 in set) dram_set $3;; *) echo "ERR|perintah dram tidak dikenal";; esac;;
  ged) case $2 in set) ged_set $3;; *) echo "ERR|perintah ged tidak dikenal";; esac;;
  thr_scan) thr_scan;;
  statline) statline;;
  ue) ue "$2" "$3" "$4";;
  ue_compile) ue_compile "$2";;
  statloop) statloop;;
  boot) boot;;
  dpi) dpi_set $2;;
  dpi_reset) dpi_reset;;
  dns) dns_set $2 $3;;
  cool_start) cool_start;;
  cool_stop) cool_stop;;
  cool_wd) cool_wd;;
  killall) killall_apps;;
  spoofapp) case $2 in add) spoofapp_add "$3" "$4" "$5" "$6" "$7" "$8" "$9" "${10}" "${11}";; chip) spoofapp_chip "$3" "$4" "$5" "$6" "$7";; flag) spoofapp_flag "$3" "$4" "$5";; test) spoofapp_test "$3";; del) spoofapp_del "$3";; *) echo "ERR|perintah spoofapp tidak dikenal";; esac;;
  *) echo "usage: ultrapower {mode perf|plite|balance|eco | thermal on|off | feat <nama> on|off | refresh 60|90|120 | feat hzforce on|off (bawaan on) | rlearn snap <Hz>|build|show [all]|add <ns> <kunci>|clear | gpu_fix <kHz|0> | cpu_gov <policyN|all> <gov> | cpu_freq <policyN> <min> <max> | gpu_gov <gov> | gpu_freq <min> <max> | spoofapp add <paket> <key> <manufacturer> <model> [0|1] | spoofapp flag <paket> on|full 0|1 | spoofapp test <paket> | spoofapp del <paket> | status}";;
esac
