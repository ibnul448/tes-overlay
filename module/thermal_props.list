# Properti thermal yang ditimpa saat "Disable Thermal" aktif. Dibaca oleh post-fs-data.sh (boot, sebelum service jalan) dan th_off (runtime).
# Satu baris satu properti: nama=nilai. Nilai ASLI dicatat dulu sehingga "thermal on" bisa mengembalikannya TANPA reboot.
dalvik.vm.dexopt.thermal-cutoff=0
ro.vendor.mtk_thermal_2_0=0
ro.vendor.tran.hbm.thermal.temp.clr=0
ro.vendor.tran.hbm.thermal.temp.trig=0
persist.vendor.powerhal.thermal_ux_temp_max=0
persist.vendor.powerhal.thermal_ux_temp_min=0
ro.esports.thermal_config.support=0
ro.esports.thermal_config.version=0
ro.boottime.mi_thermald=0
ro.boottime.thermal=0
ro.boottime.vendor.thermal-hal-2-0.mtk=0
ro.boottime.vendor.thermal-mediatek=0
ro.boottime.thermal_manager=0
ro.boottime.thermald=0
ro.boottime.thermalloadalgod=0
persist.thermal_config.mitigation=0
ro.mtk_thermal_monitor.enabled=false
ro.vendor.fps.switch.thermal=false
ro.dar.thermal_core.support=0
ro.vendor.powerhal.thermal_ux_support=0
ro.vendor.thermalspace.support=0
ro.boottime.thermal_space=0
